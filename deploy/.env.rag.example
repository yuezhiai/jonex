# ============================================================
# LightRAG Server 配置模板 —— 仅 lightrag 容器加载
# ------------------------------------------------------------
# 用法：make init 会复制本文件为 deploy/.env.rag，再按需修改。
# 默认值与平台 docker-compose 期望一致（经 llm-gateway 代理、Neo4j 图后端）。
# 完整可选项（rerank / 多种存储后端 / 各家 LLM 绑定等）参见上游参考：
#   Reference/LightRAG/env.example
# ============================================================

# ============================================================
# 1. 服务
# ============================================================
HOST=0.0.0.0
PORT=9621
WORKERS=2
TIMEOUT=300

# ============================================================
# 2. 鉴权（atomic-rag 调用时附 X-API-Key；须与 .env 的 LIGHTRAG_API_KEY 一致）
# ============================================================
LIGHTRAG_API_KEY=change-me-in-production-please
# WebUI 登录（仅开发/运维使用，生产不暴露）
AUTH_ACCOUNTS=admin:change-me-please
TOKEN_SECRET=change-me-jwt-secret
TOKEN_EXPIRE_HOURS=48

# ============================================================
# 3. 工作目录
# ============================================================
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs

# ============================================================
# 4. LLM（OpenAI 兼容协议，经 llm-gateway 代理；不直连上游）
# ============================================================
LLM_BINDING=openai
LLM_BINDING_HOST=http://llm-gateway:8787/v1
LLM_BINDING_API_KEY=gw_lightrag
LLM_MODEL=deepseek-v4-flash-202605
LLM_TIMEOUT=600
# 备用：直连本机 Ollama（支持关闭思考模式，对实体抽取提速）
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://host.docker.internal:11434
# LLM_MODEL=qwen3.5:9b
# OLLAMA_LLM_NUM_CTX=32768
# OLLAMA_LLM_ENABLE_THINK=false

# ============================================================
# 5. Embedding（OpenAI 兼容协议，经 llm-gateway 代理）
#    注意：首篇文档处理后不可再更改 Embedding 配置。
# ============================================================
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://llm-gateway:8787/v1
EMBEDDING_BINDING_API_KEY=gw_lightrag
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=true
EMBEDDING_TOKEN_LIMIT=8192

# ------------------------------------------------------------
# 5.1 Embedding 并发（按实际 embedding 服务压测标定，见 scripts/bench_embedding.py）
# ------------------------------------------------------------
# EMBEDDING_FUNC_MAX_ASYNC: 并发的 embedding HTTP 请求数（对上游的并发度，默认 8）
# EMBEDDING_BATCH_NUM: 单请求打包的 chunk 数（array 输入，默认 10）
# 参考：本平台 qwen3-embedding:8b 实测甜点为 FUNC_MAX_ASYNC=16 + BATCH_NUM=4
# （稳态单请求 ~90ms，冷启动 ~30s）。换 embedding 服务/机型请重新压测标定。
EMBEDDING_FUNC_MAX_ASYNC=16
EMBEDDING_BATCH_NUM=4

# ============================================================
# 6. 存储后端
#    已升级为可扩展后端：KV/DocStatus 落 PostgreSQL，图谱用 Neo4j，向量用 Milvus。
#    （JSON + NanoVectorDB 属单进程最简实现，数据量/多进程并发写下不可扩展。）
#
#    依赖：lightrag 镜像已含 asyncpg / pymilvus（Dockerfile --extra offline）；
#    postgres / milvus 须先就绪（compose 已加 depends_on healthy）。
#    PG 表由 LightRAG 启动时自动建于 POSTGRES_DATABASE 的 public schema；向量走
#    Milvus 时 PG enable_vector 自动为 False，无需 pgvector 扩展。Milvus 库不存在
#    时由 LightRAG 自动创建。
# ============================================================
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# ⚠️ 硬依赖：图存储必须为 Neo4JStorage。atomic-rag 的存储读取（get_storage_* /
#    本体抽取）经 lightrag-server 新增端点 GET /graph/{entities,relationships,counts,summary}
#    读图数据，这些端点依赖 Neo4JStorage 的 jonex_* 图查询方法（见 JONEX_CHANGES.md 九）。
#    换其它图后端（NetworkX/PGGraph/Memgraph 等）会因缺该方法返回 HTTP 501、存储读与本体
#    抽取失效。KV/DocStatus/Vector 后端可随意（新接口不读本地 JSON），但图必须 Neo4j。
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# ------------------------------------------------------------
# 6.0.1 PostgreSQL 连接（PGKVStorage / PGDocStatusStorage 用）
#   默认与平台主库同实例同库（compose 服务名 postgres，凭据同 .env 的 DB_*）。
#   lightrag 容器只加载 .env.rag，故此处需独立声明。
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jonex
POSTGRES_PASSWORD=jonex123
POSTGRES_DATABASE=jonex
POSTGRES_MAX_CONNECTIONS=25

# ------------------------------------------------------------
# 6.0.2 Milvus 连接（MilvusVectorDBStorage 用）
#   compose 服务名 milvus，gRPC 19530；无鉴权时 MILVUS_USER/PASSWORD 留空。
#   MILVUS_DB_NAME 不存在时 LightRAG 自动创建；集合按 workspace 隔离。
# ------------------------------------------------------------
MILVUS_URI=http://milvus:19530
MILVUS_DB_NAME=lightrag
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_TOKEN=

# 回退路径（如需退回单进程最简实现，仅本地调试用，不建议生产）：
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# ------------------------------------------------------------
# 6.1 知识库隔离（workspace）—— 重要：不要在此设置默认 WORKSPACE
# ------------------------------------------------------------
# 平台按「租户 + 知识库」做硬隔离：atomic-rag 入库 / 查询 / 删除时，会按
# workspace = sanitize(tenant_id)__sanitize(knowledge_base_id) 注入请求头
# LIGHTRAG-WORKSPACE，LightRAG server 据此把 KV / 向量 / 图存储整体切到对应
# workspace 子空间，从根上杜绝跨知识库检索串库。
#
# 因此 LightRAG server 端的默认 WORKSPACE 必须保持「不设置/为空」，让按请求头
# 的 workspace 完全生效；一旦在此固定 WORKSPACE=xxx，会强制所有 KB 落到同一
# 空间，重新引入串库问题。
# WORKSPACE=    # 留空，勿设

# ⚠️ 以下两个变量会覆盖 per-instance workspace，把所有库塌缩到同一空间，
# 导致跨库串库。务必保持不设置/留空：
# POSTGRES_WORKSPACE=   # 留空，勿设——会优先覆盖 LightRAG 实例的 workspace
# PG_WORKSPACE=         # 留空，勿设——POSTGRES_WORKSPACE 的别名
# NEO4J_WORKSPACE=      # 留空，勿设——会覆盖 Neo4j 存储实例的 workspace
# MILVUS_WORKSPACE=     # 留空，勿设——会覆盖 Milvus 存储实例的 workspace
# ⚠️ 如果上述任一变量非空，容器启动将 fail-fast 报错退出。
# （PG / Milvus 连接参数见上方 §6.0.1 / §6.0.2）

# ============================================================
# 6.2 工作空间隔离开关（RAG_WORKSPACE_ISOLATION / RAG_WORKSPACE_CACHE_MAX）
# ============================================================
# 启用后，LightRAG server 根据请求头 LIGHTRAG-WORKSPACE 按「租户+知识库」维
# 度隔离检索、入库和图谱查询，从根上消除跨知识库串库问题。
#   - RAG_WORKSPACE_ISOLATION: true=启用隔离, false=回退单实例（兼容旧行为）
#   - RAG_WORKSPACE_CACHE_MAX: 同时缓存的最大 workspace 实例数，超限 LRU 淘汰
# 灰度建议：先 false 上线确认无回归 → 选 1~2 个测试租户切 true 验证 → 全量
#
# ⚠️ Neo4j 连接数提示：隔离开启后，每个缓存的 workspace 实例各自持有一个 Neo4j
# driver（Neo4j 无 PG 那样的进程级共享池）。连接数上界 ≈
#   RAG_WORKSPACE_CACHE_MAX × NEO4J_MAX_CONNECTION_POOL_SIZE（见第 7 节）。
# 连接池惰性建立，实际并发 ≈ 同时被查询的去重 workspace 数；但为防极端放大，
# 建议把 NEO4J_MAX_CONNECTION_POOL_SIZE 设为有界值（已在第 7 节设 16）。
RAG_WORKSPACE_ISOLATION=true
RAG_WORKSPACE_CACHE_MAX=64

# ⚠️ WebUI workspace 切换器（调试用，默认关闭）
# 开启后，9621 WebUI 右下角出现输入框，可填 lightrag_workspace（tenant__kb）查对应库；
# 实现：写 lightrag_workspace cookie，服务端按 cookie 兜底解析 workspace。
# ⚠️ 绕过平台租户/权限校验，属跨租户数据暴露，仅限本地调试；生产严禁开启，
#    且 9621 严禁对外暴露（基线 compose 仅 expose，不映射宿主）。
WEBUI_WORKSPACE_SWITCHER=false

# ============================================================
# 7. Neo4j 图后端（LightRAG 图谱存储）
# ============================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD:-jonex_neo4j_123}
# 单 driver 连接池上限。隔离模式下连接数上界 = RAG_WORKSPACE_CACHE_MAX × 本值，
# 故设为有界值避免打爆单实例社区版 Neo4j（1G 堆）。低 QPS 下 16 足够；
# 如单 workspace 高并发图操作出现连接等待，再上调。
NEO4J_MAX_CONNECTION_POOL_SIZE=16

# ============================================================
# 8. 文档处理
# ============================================================
SUMMARY_LANGUAGE=Chinese
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# ------------------------------------------------------------
# 8.1 实体/关系抽取（提升本体召回，缓解"抽取少、检索打不中"）
# ------------------------------------------------------------
# 抽取阶段要识别的实体类型（LightRAG 约定 JSON 数组字符串，非逗号分隔）。
# 配置后 GraphML 节点才带 entity_type，atomic-rag 预分类命中率提升、少退化为 unknown。
# 注意 ENTITY_TYPES 有双重作用：① 注入 LightRAG 抽取 prompt，决定 NER「该找哪些类」，直接影响召回；
# ② 抽完写入 GraphML，供本体预分类用 type 命中 schema aliases，命中即跳过 LLM、更快更准。
# 下列类型在原 10 类基础上，参考 006_seed_data.sql 六个模板领域（互联网/金融/医疗/制造/
# 硬件互联网财报/AI大模型技术报告）的本体实体（template_objects）泛化去重，并补充跨领域常见类型：
#   组织←公司/企业/上市公司/投资机构/担保企业/研发机构/子公司；模型←AI模型/竞品模型；
#   技术/方法←框架/软件框架/协议/算法/模型架构/后训练技术/RL基础设施；系统/设备←平台/工具/生产线/装置；
#   数据←数据集/运营数据；功能←功能特性/模块；报告←财报/病历/质检报告/技术报告；
#   指标←财务/运营/研发/ESG指标/评测得分/性能指标；任务/项目←基准任务/工程；
#   标准/政策←基准测试/规范/法规；配置/参数←训练部署配置/采样参数；环境←训练环境/运行环境；
#   场景←应用场景/业务场景；渠道←销售渠道/门店/分发渠道；方案←可持续举措/措施/行动；
#   市场/行业/地点←赛道/业务分部/地区市场；风险←风控隐患/缺陷/风险因素；法务←法律诉讼/监管调查/合规事项；
#   疾病/症状←医疗诊断本体；物料←原料/零部件。
ENTITY_TYPES='["组织","人员","产品","技术","方法","系统","设备","模型","数据","功能","概念","流程","任务","项目","方案","场景","事件","文档","报告","指标","标准","政策","配置","参数","环境","渠道","市场","行业","风险","法务","疾病","症状","物料","地点","时间"]'
# 实体抽取后的补抽轮数（默认 1）：调到 2 捞回首轮漏抽的实体/关系，代价是 LLM 调用增多、入库变慢。
MAX_GLEANING=2
# 同名实体/关系合并时累计描述片段数达此阈值触发 LLM 摘要（建议 ≥3）。
# 值越小描述越完整但越慢；描述是 answer_from_facts 的核心上下文，也是孤立实体保留判据。
FORCE_LLM_SUMMARY_ON_MERGE=4

# ============================================================
# 9. 并发控制
# ------------------------------------------------------------
# MAX_ASYNC: 并发 LLM 调用上限（抽取/摘要/问答共用；图重建阶段用 MAX_ASYNC×2）。
# MAX_PARALLEL_INSERT: 并行处理文档数（建议 ≈ MAX_ASYNC/3，取 2~4）。
# 取值应按实际上游 LLM 限流维度标定：
# 本平台 deepseek-v4-flash（经腾讯 tokenhub）实测限流为 RPM 200（每分钟请求数，
# 非并发数），见 docs/rag-reparse-strict-cleanup-busy-plan.md §12.12。
# 估算公式：稳态 req/min ≈ (MAX_ASYNC × 60) ÷ 平均单次调用耗时秒。
# 单次抽取 ~2~5s（thinking=disabled），取中值 ~3s：
#   · MAX_ASYNC=12 → ~240 req/min → 超出 RPM 200
#   · MAX_ASYNC=4  →  ~80 req/min → 安全低于 200
# ⚠️ 抽取 + 本体 + 查询期 chat 共用同一上游 key 的 200 RPM，
#    须把三者速率相加；本体并发见 deploy/.env 的 ONTOLOGY_EXTRACT_CONCURRENCY。
# 换上游/模型请重新确认限流维度与数值后再调整。改后重启 lightrag。
# ============================================================
MAX_ASYNC=12
MAX_PARALLEL_INSERT=4

# ============================================================
# 10. LLM 缓存
# ============================================================
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# ============================================================
# 11. Rerank（检索期重排：召回后、送 LLM 前）
# ------------------------------------------------------------
# 默认关闭（RERANK_BINDING=null）。启用后 LightRAG 在召回 top-K 后、送 LLM 前
# 调用 reranker 取高分 top-N，提升答案与引用质量。
# 出口复用平台 llm-gateway 的 /v1/rerank（cohere 契约），由其转发到所配 reranker
# （当前 ollama Qwen3-Reranker）。RERANK_BINDING=cohere 用标准 req/resp 格式，与网关兼容。
# 改动后须重启 lightrag 容器；每次查询会增加一轮 rerank 调用（有延迟成本）。
# ============================================================
# RERANK_BINDING=cohere
# RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
# RERANK_BINDING_HOST=http://llm-gateway:8787/v1/rerank
# RERANK_BINDING_API_KEY=gw_lightrag
# RERANK_BY_DEFAULT=true
# MIN_RERANK_SCORE=0.0

# ============================================================
# 12. [jonex] v2 原子能力控制（atomic-rag / PushChunksStage / ParseStage）
# ============================================================
# 12.1 入库：严格逐 chunk 确认 doc_id（默认 true，对齐 v1）
RAG_REQUIRE_DOC_IDS=true
# 12.2 解析：瞬时网络/SSL 错误自动重试（所有 parser 生效）
RAG_PARSE_RETRY_MAX=3             # 含首次共尝试次数
RAG_PARSE_RETRY_BASE_SEC=2.0      # 指数退避基数（秒）
# 12.3 Per-chunk 超时：单 chunk 独立超时窗口（秒），超时后对该 chunk 重推重试
RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS=900
# 12.4 超时 chunk 重推最大次数（仅 PushChunksStage，task_manager 恢复路径不重推）
RAG_TRACK_PER_CHUNK_MAX_RETRIES=2
# 12.5 单次 batch_track_status 全局安全网（秒），须 ≥ RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS
RAG_TRACK_TIMEOUT_SECONDS=1800