# ============================================================
# MCP Server 配置模板 — 仅 mcp-server 容器加载
# ------------------------------------------------------------
# 用法：make init 会复制本文件为 deploy/.env.mcp，再按需修改。
# 变量参照 mcp_server/config.py，不使用 pydantic。
# ============================================================

# ============================================================
# 1. PostgreSQL 数据库连接
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 2. MCP Server 服务配置
# ============================================================
MCP_SERVER_PORT=8002
# 本体列式浏览单次跨库聚合上限：默认 20，允许 1-100。
# 非法值（非整数 / 0 / 负数 / 越界）回落 20 并告警，不影响服务启动。
# 调大后会放大单次工具调用的上游读取次数，请同时评估 Sidecar 限流容量。
ONTOLOGY_MAX_FANOUT_KBS=20

# ============================================================
# 3. 内部服务通信
# ============================================================
# Gateway 地址（容器内通过 jonex-network 路由）
GATEWAY_URL=http://gateway:8000
# 内部服务间认证 Key：mcp-server 调 Gateway /internal/kb/invoke 时按 X-Internal-API-Key
# 携带，Gateway 比对 deploy/.env 的 INTERNAL_API_KEY——两处必须逐字一致，否则 MCP 工具调用 401
INTERNAL_API_KEY=

# ============================================================
# 4. 安全配置
# ============================================================
# ⚠️ 必须与 deploy/.env 的 JWT_SECRET 逐字一致（mcp-server 是 MCP Key 的 HMAC 校验侧，
# 写入侧在 platform 服务）；轮换 / 替换时两个文件同批修改。留空或整行删除会让
# mcp-server 拒绝启动（fail-closed）。本行是模板值，生产必须换成真实随机值。
JWT_SECRET=

# ============================================================
# 5. 限流配置
# ============================================================
# Redis 连接地址（用于限流计数器，默认 redis:6379/0）
REDIS_URL=redis://redis:6379/0

# ============================================================
# 6. 依赖健康检查（启动时探测，失败则禁用对应检索工具）
# ------------------------------------------------------------
# 说明：mcp-server 启动时探测这两个端点，失败重试 3 次（每次 2s）。
#   探测失败 ⇒ 对应工具在本进程生命周期内被禁用，之后不会自动复检：
#     - OPENKB_HEALTH_URL       失败 ⇒ 禁用 search_llmwiki
#     - JONEX_WIKI_HEALTH_URL   失败 ⇒ 禁用 search_jonex_wiki
# 主机名必须与 compose 里服务的 hostname 一致（不是 container_name）：
#   openkb      ⇒ jonex-openkb   容器，hostname: openkb，端口 7566
#   jonex-wiki  ⇒ jonex-wiki     容器（B1 单容器：引擎 + 能力同进程），端口 8007
# ⚠️ 不要再写成 jonex-wiki-adapter:7567 —— 那是已删除的独立 adapter 架构。
# ============================================================
OPENKB_HEALTH_URL=http://openkb:7566/health
JONEX_WIKI_HEALTH_URL=http://jonex-wiki:8007/health
