# ============================================================
# MCP Server 配置模板 — 仅 mcp-server 容器加载
# ------------------------------------------------------------
# 用法：make init 会复制本文件为 deploy/.env.mcp，再按需修改。
# 变量参照 mcp_server/config.py，不使用 pydantic。
# 与 mcp_server/.env.mcp.example 保持同一变量集合；改动时两份同步。
# ============================================================

# ============================================================
# 1. PostgreSQL 数据库连接
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 2. MCP Server 服务配置
# ============================================================
MCP_SERVER_PORT=8002
# 本体列式浏览单次跨库聚合上限：默认 20，允许 1-100。
# 非法值（非整数 / 0 / 负数 / 越界）回落 20 并告警，不影响服务启动。
# 调大后会放大单次工具调用的上游读取次数，请同时评估 Sidecar 限流容量。
ONTOLOGY_MAX_FANOUT_KBS=20
# 本体邻域遍历深度硬上限：默认 3，允许 1-20。
# ⚠ 由 gateway / knowledge-base-service / mcp-server 三处同名读取：
#   - gateway：deploy/docker-compose.yml 的显式 environment 清单（无 env_file）
#   - knowledge-base-service：deploy/.env
#   - mcp-server：本文件
# 调大时三处必须取同值，否则网关会先按自己的上限拒绝请求。
ONTOLOGY_NEIGHBOR_DEPTH_MAX=3
# 多 KB 多跳整体截止时间（秒）：默认 25，允许 1-120。仅 mcp-server 读取，
# 且仅在 depth>1 的多 KB 调用生效；单次多跳的超时仍由能力侧 10s 控制。
ONTOLOGY_MULTIHOP_DEADLINE_SECONDS=25

# ============================================================
# 3. 内部服务通信
# ============================================================
# Gateway 地址（容器内通过 jonex-network 路由）
GATEWAY_URL=http://gateway:8000
# 内部服务间认证 Key：mcp-server 调 Gateway /internal/kb/invoke 时按 X-Internal-API-Key
# 携带，Gateway 比对 deploy/.env 的 INTERNAL_API_KEY——两处必须逐字一致，否则 MCP 工具调用 401
INTERNAL_API_KEY=

# ============================================================
# 4. 安全配置
# ============================================================
# ⚠️ 必须与 deploy/.env 的 JWT_SECRET 逐字一致（mcp-server 是 MCP Key 的 HMAC 校验侧，
# 写入侧在 platform 服务）；轮换 / 替换时两个文件同批修改。留空或整行删除会让
# mcp-server 拒绝启动（fail-closed）。本行是模板值，生产必须换成真实随机值。
JWT_SECRET=

# MCP Key 的 HMAC 盐（与 JWT_SECRET 解耦，实现见 mcp_server/crypto.py:106-121）。
# ⚠️ mcp-server **只加载本文件**，不读 deploy/.env。若主 .env 配了 MCP_KEY_SECRET
#    而这里没配，mcp-server 会回退本文件的 JWT_SECRET，与写入侧（platform 用
#    deploy/.env 的 MCP_KEY_SECRET）盐不同 ⇒ 所有 yxm_ Key 401。
# 规则：要么两边都留空（一起回退 JWT_SECRET），要么两边配同值。
#   MCP_KEY_SECRET        当前盐（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
#   MCP_KEY_SECRET_LEGACY 仅校验用的旧盐；盐轮换时填「轮换前生效的盐」以放行存量 Key
MCP_KEY_SECRET=
MCP_KEY_SECRET_LEGACY=

# ============================================================
# 5. Jonex Wiki 列式浏览（4 个只读工具）
# ============================================================
# 开关只收敛 MCP 暴露面：关闭后工具仍出现在 tools/list，返回空结果 +
# wiki_browse_disabled=true，不调上游。默认开启，可回退。
WIKI_BROWSE_ENABLED=true
# 深度上限（独立变量，**不回落** ONTOLOGY_NEIGHBOR_DEPTH_MAX）。范围 1~20。
WIKI_BROWSE_DEPTH_MAX=3
# 单库上游调用超时（秒），范围 1~120；超时组进 errors。
WIKI_BROWSE_REQUEST_TIMEOUT_SECONDS=30
# 多库扇出整体截止时间（秒），范围 1~180。
WIKI_BROWSE_DEADLINE_SECONDS=60

# ============================================================
# 5b. Wiki 检索开关（search_llmwiki / search_jonex_wiki）
# ============================================================
# 关闭后工具仍出现在 tools/list，调用直接返回 -32000「暂未开放」，不调上游。
# 默认开启；下文「依赖健康检查」的探测失败**不会**翻转这两个开关，只记录告警。
SEARCH_LLMWIKI_ENABLED=true
SEARCH_JONEX_WIKI_ENABLED=true

# ============================================================
# 6. 限流配置
# ============================================================
# Redis 连接地址（用于限流计数器，默认 redis:6379/0）
REDIS_URL=redis://redis:6379/0

# ============================================================
# 7. 依赖健康检查（启动时探测；仅观测，不翻转工具开关）
# ------------------------------------------------------------
# 说明：mcp-server 启动时探测这两个端点，失败重试 3 次（每次 2s）。
#   探测失败**只记录告警**，不会禁用工具、也不会改变 SEARCH_* 开关：
#     - OPENKB_HEALTH_URL       失败 ⇒ 告警；search_llmwiki 仍可用
#     - JONEX_WIKI_HEALTH_URL   失败 ⇒ 告警；search_jonex_wiki 仍可用
#   调用时上游不可用会按实际错误返回（通常 -32000），不会因启动探测失败被永久禁用。
# 主机名必须与 compose 里服务的 hostname 一致（不是 container_name）：
#   openkb      ⇒ jonex-openkb   容器，hostname: openkb，端口 7566
#   jonex-wiki  ⇒ jonex-wiki     容器（B1 单容器：引擎 + 能力同进程），端口 8007
# ⚠️ 不要再写成 jonex-wiki-adapter:7567 —— 那是已删除的独立 adapter 架构。
# ============================================================
OPENKB_HEALTH_URL=http://openkb:7566/health
JONEX_WIKI_HEALTH_URL=http://jonex-wiki:8007/health
