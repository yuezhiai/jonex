# ==============================================================================
# Jonex Wiki 环境变量模板
# ------------------------------------------------------------------------------
# 用法:  cp .env.example .env  然后按需修改。
# 约定: 布尔值用 on/off (true/false、1/0 也可)。
# 标记: [必填] = 缺省时服务拒绝启动 (Settings._require_secrets fail-fast)。
#       [默认: xxx] = 不设时生效的代码内置默认值。
# 说明: 带 JONEX_WIKI_ 前缀的变量由 pydantic-settings env_prefix 派生;
#       带显式别名(LLM_*/DB_*/QUERY_*/MINERU_*)的不带前缀。
# ==============================================================================


# ============================ 认证 ============================
# 单一内部 key(对齐 LIGHTRAG_API_KEY):X-API-Key 校验调用方身份,常量时间比较;
# 业务租户由请求 X-Tenant-ID header 动态透传(平台 Sidecar 已解析),无需重启。 [必填, 无默认]
JONEX_WIKI_API_KEY=sk-live-xxx


# ==================== 平台内部认证(jonex_core) ====================
# 这一组**必须与 deploy/.env 逐值一致**,由能力框架(不是引擎)读取。
#
# ⚠ 本容器在 compose 里的 env_file **只有** .env.jonex_wiki,镜像里也没有 deploy/.env
#   (.dockerignore 已按安全要求排除)。现有环境之所以还能跑,是因为**旧镜像里烤进过
#   一份 deploy/.env** —— 那是历史泄漏的残余,**下一次重建镜像就会踩到**:
#   缺 JWT_SECRET 时容器照常 healthy,但 Sidecar → 本容器 /invoke 一律
#   403 code=3004,每一次调用都死在第一步(2026-09-23 真机实测)。
#   JWT_SECRET    [必填] jonex_core/security/internal_auth.py 验 Sidecar 的内部 JWT
#   JWT_ALGORITHM [默认: HS256] 同一模块读;签发/校验两侧必须同算法
#   REDIS_URL     [默认: 空 = localhost:6379] jonex_core/common/cache.py → discovery 的
#                        服务注册与 30s 心跳;缺了不致命,但每 30 秒刷一次心跳失败栈
JWT_SECRET=change-me-must-match-platform-deploy-env
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379/0


# ============================ 数据库 ============================
# PostgreSQL 连接(外部已有实例)。也可用 DATABASE_URL 整体覆盖(如本地 SQLite)。
# [默认: postgres]
DB_HOST=postgres
# [默认: 5432]
DB_PORT=5432
# [默认: jonex]
DB_USERNAME=jonex
# [默认: change-me]
DB_PASSWORD=change-me
# [默认: jonex]
DB_NAME=jonex
# [默认: jonex_wiki]
DB_SCHEMA=jonex_wiki
# 显式连接串,优先级最高;本地快速体验可设为 sqlite+aiosqlite:///./jonex_wiki.db [默认: 空=用 DB_* 拼装]
DATABASE_URL=


# ============================ 数据目录 + 服务 ============================
# 平台解析产物输入根(共享卷挂载点):ingest 端点从这里读 source_path(相对路径)。
# 容器部署用 /app/inputs;本地 VSCode 开发改 ./.app_inputs。 [默认: /app/inputs]
JONEX_WIKI_INPUT_ROOT=/app/inputs
# 产物根目录(parse/compile/query 的 bundle、staging、versions)。
# 容器部署用 /data/jonex-wiki;本地 VSCode 开发改 ./.results。 [默认: ~/.jonex-wiki]
JONEX_WIKI_DATA_ROOT=/data/jonex-wiki
# uvicorn 监听端口(仅 main.py 直读,不进 Settings)。 [默认: 8007]
JONEX_WIKI_API_PORT=8007


# ============================ LLM 网关 ============================
# llm-gateway 地址/密钥;所有模型调用经它统一计量。 [必填, 无默认]
LLM_BINDING_HOST=http://llm-gateway:8787/v1
# [必填, 无默认]
LLM_BINDING_API_KEY=gw_jonex_wiki
# 生成模型名。 [必填 —— 代码里没有字面量默认值]
# 缺失时回退 DEFAULT_LLM_MODEL；两者都为空则网关抛 GwModelNotConfigured，而不是拿一个
# 可能早已失效的写死模型名去请求上游。这里刻意不填具体名字：模板是给新部署抄的，写死的
# 名字会随上游改名/额度变化静默失效。
# ⚠ 编译与查询都按**当下**的这个 env 走；bundle Manifest 里记的模型名只是编译期快照
# （审计用），换模型**不需要重编译 KB**，改完 env 重建容器即生效。
LLM_MODEL=
# 单次 chat 调用超时(秒);超时后交给 complete 的重试预算。 [默认: 120.0]
LLM_TIMEOUT=120.0


# ============================ 思考 (thinking) ============================
# 思考总开关,取值 off(默认)/ on / scene_default。
# 只作用于未显式声明 thinking 的模型调用；显式逐步设置优先。
# 查询 agent 的开关见下方 JONEX_WIKI_AGENT_THINKING。
# scene_default = 不发该字段,交回 llm-gateway 按 X-Jonex-Scene 白名单
# (LLMGW_DISABLE_THINKING_SCENES)决定。
# 为什么默认 off:reasoning token **计入** max_tokens(遍历 4096~8192、合成 8192),
# 实测 30 次查询里 9 次因思考把预算吃光 → stop_reason=model_output_truncated。
# 前置条件:上游须支持顶层 {"thinking":{"type":"disabled"}}（腾讯 tokenhub 格式）;
# 引擎侧遇到"不支持 thinking"的报错会自动去掉该字段重试,不会因此失败。
# [默认: off]
JONEX_WIKI_THINKING_DEFAULT=off
# 查询 agent 开关：on 保留现有逐步设置；off 关闭所有查询模型调用的 thinking。
# on 不会开启原本关闭的辅助步骤；不影响编译。 [默认: on]
JONEX_WIKI_AGENT_THINKING=on


# ============================ MinerU 解析(可选) ============================
# 云解析 token;为空则跳过 MinerU cloud 后端(走 selfhost 或跳过)。 [默认: 空]
MINERU_API_TOKEN=
# 云解析 API 基址。 [默认: https://mineru.net]
MINERU_API_BASE_URL=https://mineru.net
# 云解析模型版本。 [默认: vlm]
MINERU_MODEL_VERSION=vlm
# 轮询间隔(秒)。 [默认: 5.0]
MINERU_POLL_INTERVAL=5.0
# 单任务轮询超时(秒)。 [默认: 1800.0]
MINERU_POLL_TIMEOUT=1800.0
# 本地解析后端。 [默认: pipeline]
MINERU_LOCAL_BACKEND=pipeline
# 本地解析最大重试次数。 [默认: 3]
MINERU_PARSE_MAX_RETRIES=3
# 本地解析重试退避(秒)。 [默认: 3.0]
MINERU_PARSE_RETRY_BACKOFF=3.0
# selfhost MinerU 服务地址。 [默认: http://127.0.0.1:8000]
MINERU_SELFHOST_BASE_URL=http://127.0.0.1:8000
# selfhost 后端。 [默认: pipeline]
MINERU_SELFHOST_BACKEND=pipeline
# selfhost 语言。 [默认: ch]
MINERU_SELFHOST_LANG=ch
# selfhost 是否回传图片。 [默认: off]
MINERU_SELFHOST_RETURN_IMAGES=off


# ============================ 查询旋钮 (§15 收敛进 Settings) ============================
# 是否用 LLM rerank(检索后重排)。 [默认: off]
QUERY_RERANK=off
# 单次查询的页面正文/分词缓存上限（字节）；满后 LRU 淘汰，超大页不缓存。
# 0 禁用缓存；不截断页面或限制证据。 [默认: 16777216，即 16 MiB]
JONEX_WIKI_QUERY_MATERIAL_CACHE_BYTES=16777216

# 检索结果是否带 snippet。 [默认: on]
QUERY_SNIPPET=on
# 证据缺口 judge(gap judge)。 [默认: on]
# 检索多样性 rerank。 [默认: off]
QUERY_DIVERSITY_RERANK=off
# 是否分解子问题(query decompose)。 [默认: on]
QUERY_QUERY_DECOMPOSE=on
# 分解是否支持多跳。 [默认: on]
QUERY_DECOMPOSE_MULTIHOP=on
# 答案风格(natural 等)。 [默认: natural]
QUERY_ANSWER_STYLE=natural
# 是否给模型答案目标提示。 [默认: off]
QUERY_ANSWER_TARGET_HINT=off
# 单次查询工具调用硬上限(执行层)。此名已接进 Settings/runtime_env()，写在这里生效。
# [引擎常量 32 / Settings 默认 24；本链路取 32，让工具次数不先于模型预算成为瓶颈]
QUERY_MAX_TOOL_CALLS=32
# traversal 单次响应的 max_tokens。 [默认: 4096]
QUERY_TRAVERSAL_MAX_TOKENS=4096
# 单次搜索最大命中数。 [默认: 10]
QUERY_MAX_SEARCH_HITS=10
# 证据摘录长度上限(字符)。 [默认: 500]
QUERY_EVIDENCE_EXCERPT_LIMIT=500
# 活跃证据单元总数上限。 [默认: 12]
QUERY_EVIDENCE_UNITS_MAX=12
# 每文档证据数上限。 [默认: 6]
QUERY_EVIDENCE_PER_DOC_MAX=6
# 证据停滞阈值(连续无进展次数)。 [默认: 2]
QUERY_EVIDENCE_STALL_LIMIT=2
# 活跃证据窗口上限。 [默认: 32]
QUERY_MAX_ACTIVE_EVIDENCE=32
# 连续搜索后强制读取的阈值(rabbit-hole 守卫)。 [默认: 2]
QUERY_SEARCH_READ_FORCE_LIMIT=2
# 实体答案 verbose 长度上限。 [默认: 120]
QUERY_ENTITY_ANSWER_VERBOSE_LIMIT=120
# 单次模型调用超时(秒)。 [默认: 75.0]
QUERY_MODEL_CALL_TIMEOUT_SECONDS=75.0
# 模型调用超时后重试次数。 [默认: 1]
QUERY_MODEL_CALL_TIMEOUT_RETRIES=1
# 语义 review 模式(selective/off/on 等)。 [默认: selective]
LLM_WIKI_SEMANTIC_REVIEW=off


# ============================ 查询预算 (算法裸读, 未收敛进 Settings) ============================
# 注意:以下旋钮由 algorithm._query_budget_limits() 经 current_env() 直读。查询链路用
# runtime_environment(settings.runtime_env()) 包住执行，而 current_env() 在注入时
# **完全遮蔽 os.environ** —— 一个名字要在这里生效，必须先是 Settings 字段并进
# runtime_env()（否则写了也读不到，而且不报错）。QUERY_MAX_LOGICAL_CALLS 已接线。
# 回归闸：tests/test_query_budget_env.py（env→Settings→注入映射→引擎取值 四段贯通）
# 与 tests/test_env_template_contract.py（模板值 ↔ 注入值一致）。
# 单次查询逻辑调用(LLM 调用)数预算。整表读 + 确定性计算 + 引用纠偏一次要 ~19-24 次，
# 24 得贴着上限跑完；这里取 32，给纠偏与再作答留余量。
# [默认: 24；本链路取 32]
QUERY_MAX_LOGICAL_CALLS=32
# 单次查询累计 token 预算(legacy 实验复现用);0 或空 = 不限制。 [默认: 360000]
QUERY_MAX_TOTAL_TOKENS=360000
# 单请求上下文 token 上限。 [默认: 400000]
QUERY_MAX_CONTEXT_TOKENS=400000
# 单次查询时间预算(秒)。 [默认: 180]
QUERY_MAX_SECONDS=180
# 调试开关:dump 预算计价消息到日志。 [默认: 空=关闭]
POC_BUDGET_MESSAGE_DUMP=


# ============================ 编译 + 成本闸门 ============================
# 编译(select_and_compile)单次输出 max_tokens。 [默认: 16384]
JONEX_WIKI_COMPILE_OUTPUT_TOKENS=16384
# 语义 review 单次输出 max_tokens。 [默认: 4096]
JONEX_WIKI_SEMANTIC_REVIEW_OUTPUT_TOKENS=4096
# 单次编译最大文档数。 [默认: 1000]
JONEX_WIKI_COMPILE_MAX_DOCUMENTS=1000
# 空产出守卫:page_count 较上一版下跌超此比例则拒绝发布。 [默认: 0.5]
JONEX_WIKI_COMPILE_PAGE_DROP_THRESHOLD=0.5
# 页面 passage 并发度(同时编译几个 passage)。没有「不限」语义,串行写 1。 [默认: 20]
JONEX_WIKI_COMPILE_CONCURRENCY=20

# passage 永久失败率上限(0..1),超过即 fail closed。 [默认: 0.05]
JONEX_WIKI_COMPILE_MAX_PASSAGE_FAILURE_RATE=0.05



# ============================ 并发 ============================
# API 解析并发度。 [默认: 2]
JONEX_WIKI_API_PARSE_CONCURRENCY=2
# API 编译并发度。 [默认: 2]
JONEX_WIKI_API_COMPILE_CONCURRENCY=2
# API 查询并发度。 [默认: 4]
JONEX_WIKI_API_QUERY_CONCURRENCY=4
# 目录(outline)起草并发度,独立槽位,不占编译槽。 [默认: 2]
JONEX_WIKI_API_OUTLINE_CONCURRENCY=2
# 阻塞线程池大小。 [默认: 8]
JONEX_WIKI_BLOCKING_POOL_SIZE=8


# ============================ 上传 / 解析 / 分块 ============================
# 单次上传字节上限。 [默认: 104857600 (100MB)]
JONEX_WIKI_MAX_UPLOAD_BYTES=104857600
# 文本编码。 [默认: utf-8]
JONEX_WIKI_TEXT_ENCODING=utf-8
# 是否允许解析私有 URL。 [默认: off]
JONEX_WIKI_ALLOW_PRIVATE_URLS=off
# 保留的历史 bundle 版本数，当前版另外保留。 [默认: 2]
JONEX_WIKI_KEEP_BUNDLES=2


# ============================ 缓存 / 杂项 ============================
# prepared revision 缓存字节预算。 [默认: 805306368 (768MB)]
JONEX_WIKI_PREPARED_CACHE_BYTES=805306368
# query_tasks 终态行保留时长(秒);done/failed/cancelled 超期由启动 GC 清除。 [默认: 604800 (7 天)]
JONEX_WIKI_QUERY_TASK_TTL_SECONDS=604800


# ============================ Packing 选项 ============================
# 小块目标 token。 [默认: 4000]
JONEX_WIKI_PACK_SMALL_TOKENS=4000
# 打包目标 token。 [默认: 4000]
JONEX_WIKI_PACK_TARGET_TOKENS=4000
# 打包最大 token(prose 上限)。上限用 token 表达,中英文才共用同一个上限
# (中文≈5000 字符 / 英文≈20000 字符)。须 ≥ 行打包最大 token。 [默认: 5000]
JONEX_WIKI_PACK_MAX_TOKENS=5000
# 表格打包目标 token。 [默认: 2000]
JONEX_WIKI_PACK_TABLE_TARGET_TOKENS=2000
# 行打包最大 token。表格预算排序要求 ≤ 打包最大 token。 [默认: 5000]
JONEX_WIKI_PACK_ROW_MAX_TOKENS=5000
# 打包最大字符。 [默认: 32000]
JONEX_WIKI_PACK_MAX_CHARS=32000
# 打包上下文 token。 [默认: 256]
JONEX_WIKI_PACK_CONTEXT_TOKENS=256
# 打包前文 token。 [默认: 128]
JONEX_WIKI_PACK_PREVIOUS_TOKENS=128


# ============================ 编译输入体检 ============================
# 只做一件事:把**注定装不下**的单元(结构超限/表格行超限)摘出编译面并留档到
# gen-N/source-archive/,而不是让整份文档因一个坏点硬失败;关掉 = 回到"超限即
# PackingError"的旧语义。结论随 ingest 响应写 llm_wiki_compile_warnings。
# 没有比例闸门(摘除判据只有一条,不需要阈值兜底)。
# 详见 domain/engine/compile/source_prep/inspect.py。 [默认: on]
JONEX_WIKI_INSPECT_ENABLED=on
