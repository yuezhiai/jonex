# ==============================================================================
# ontology-compile 环境变量模板（P2 独立容器，能力 `atomic.ontology_compile.v1`）
# ------------------------------------------------------------------------------
# 用法:  make init 会自动 cp 成 deploy/.env.ontology_compile；也可手工 cp 后按需修改。
#
# ⚠⚠ **本文件是该容器唯一的 env_file**（compose 里 `env_file: .env.ontology_compile`，
#    没有 deploy/.env 兜底，镜像里也没有 —— .dockerignore 已排除 deploy/.env*）。
#    凡本容器运行期要读的变量，**必须**在这里显式设置；漏了不会启动失败，
#    只在**调用**时才炸，且各条失败面不同（见各段注释）。
#
# ⚠⚠ 与 deploy/.env.example §10 那条警告同一件事：全局兜底 DEFAULT_LLM_MODEL
#    **对不加载 .env 的引擎容器不生效**，本容器就在那份清单里 ⇒
#    模型名必须在本文件里显式给（见下方「本体抽取 LLM」段）。
#
# 标记: [必填] = 缺省时该链路明确失败（不是静默降级）。
#       [默认: xxx] = 不设时生效的代码内置默认值。
# ==============================================================================


# ==================== 平台内部认证（jonex_core） ====================
# 这一组**必须与 deploy/.env 逐值一致**，由能力框架（不是引擎）读取。
#
#   JWT_SECRET    [必填] jonex_core/security/internal_auth.py 用它验 Sidecar 签发的内部
#                        JWT（本容器既**被** Sidecar /invoke 调，也作为 capability 客户端经
#                        Sidecar 出站）。缺了落到代码默认占位值 ⇒ Sidecar → 本容器
#                        /invoke 一律 403 code=3004「Internal service auth failed」。
#   JWT_ALGORITHM [默认: HS256] 同一个模块读；签发方与校验方必须同算法。
#   REDIS_URL     [默认: 空 = localhost:6379] jonex_core/common/cache.py → discovery 的
#                        服务注册与 30 秒心跳、以及 compiled schema 的 Redis 缓存。
#                        缺了**不致命**（注册失败被 catch，路由靠 Sidecar 的静态
#                        ONTOLOGY_COMPILE_URL），但容器每 30 秒刷一次心跳失败栈。
JWT_SECRET=change-me-must-match-platform-deploy-env
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379/0
#   GATEWAY_API_KEY  [必填] 本容器作为 capability 客户端**经 Sidecar 出站**时带的 X-API-Key。
#                         必须与 deploy/.env 的 `GATEWAY_API_KEY` **逐值一致**：Sidecar
#                         侧是精确比对，且代码缺省兜底是 `change-me-in-production`
#                         ⇒ 漏了不报配置错，只在 chunk 自取第一步得到 **401 Unauthorized**
#                         （2026-10-17 真机踩过：编译任务 status=failed，日志
#                         `Client error '401 Unauthorized' for url 'http://sidecar:8000/invoke'`）。
GATEWAY_API_KEY=change-me-must-match-platform-deploy-env


# ============================ 数据库 ============================
# 编译任务存储（`ontology_compile.compile_tasks`，见 deploy/postgres/update/056_*.sql）。
# 自建 engine（不复用平台 database 单例），故变量名带本服务前缀。
#
# ⚠⚠ **此处不要填 ONTOLOGY_COMPILE_DATABASE_URL** —— 本值由 compose 的 `environment:`
#    依据 `deploy/.env` 的 `DB_USERNAME`/`DB_PASSWORD`/`DB_NAME` **插值拼出**
#    （见 deploy/docker-compose.yml 的 `ontology-compile:` 段；compose 的 `environment:`
#     优先级**高于** `env_file:`）。此处若填一个写死的口令，就会**盖掉**插值结果：
#    rotate_secrets.py 不会同步它（它在 FILL_MISSING_EXCLUDED + ROTATE_REQUIRES_OPT_IN 里），
#    改 `DB_PASSWORD` 时这一行不动 ⇒ 容器**崩循环**（起一次连不上退一次），
#    症状是 `docker compose ps` 里状态永远 Restarting、日志只有连接失败。
#    同类服务上已踩过此坑（见 deploy/README.md）。
#
# 仅当**脱离 compose 手工 `docker run`** 时，才需自行提供：
# ONTOLOGY_COMPILE_DATABASE_URL=postgresql+asyncpg://jonex:<DB_PASSWORD>@postgres:5432/jonex


# ============================ 上游服务 ============================
# Sidecar 内部地址。本容器经 Sidecar 反代调用内部能力（REMOTE 模式读的正是
# SIDECAR_URL）。
# ⚠ 不设 ⇒ 回落到代码默认 `http://localhost:8001`，容器内**必然**连不上。
SIDECAR_URL=http://sidecar:8000
# knowledge-base `/invoke` 基址。`compiled_schema_client` 读 compiled schema 的
# 回落链是 Redis → kb `/invoke` → default.yaml；不设 ⇒ 回落 `http://localhost:8003`
# （容器内连不上）⇒ 静默退化成只用 default.yaml，抽取质量下降但**不报错**。
KNOWLEDGE_BASE_URL=http://knowledge-base-service:8000


# ====================== LightRAG HTTP 客户端 ======================
# 编译链的上传/追踪/取回全走 LightRAG server 的 HTTP 端点（不再读本地 vdb_*.json）。
# 容器内主机名是 compose 服务名 lightrag。
# ⚠ 默认是 `http://lightrag:9621`（已与容器名一致），此处显式写出仅为可读性。
LIGHTRAG_API_URL=http://lightrag:9621
# 必须与 deploy/.env.rag 的 LIGHTRAG_API_KEY 逐值一致，否则 LightRAG server 401。
LIGHTRAG_API_KEY=change-me-in-production-please
# ── httpx 连接池 / 断路器 / 重试（代码内有默认值，此处列出供调优）──
# 单次请求超时（秒，含读） [默认: 300]
# RAG_HTTP_TIMEOUT=300
# 建连超时（秒） [默认: 5]
# RAG_HTTP_CONNECT_TIMEOUT=5
# 连接池上限 / 保活数 [默认: 100 / 20]
# RAG_HTTP_MAX_CONNECTIONS=100
# RAG_HTTP_MAX_KEEPALIVE=20
# 断路器：失败阈值 / 冷却秒数 [默认: 5 / 30]
# RAG_HTTP_CB_FAIL_THRESHOLD=5
# RAG_HTTP_CB_COOLDOWN_SECONDS=30
# 瞬时错误重试次数（不含首次） [默认: 3]
# RAG_HTTP_RETRIES=3
# track_status 轮询并发度 [默认: 8]
# RAG_TRACK_POLL_CONCURRENCY=8
# 入库上传重试次数 / 追踪总等待秒数 / 单 chunk 追踪窗口秒数
# [默认: 3 / 1800 / 900]
# RAG_ONTOLOGY_INGEST_UPLOAD_RETRIES=3
# RAG_ONTOLOGY_INGEST_WAIT_SEC=1800
# RAG_ONTOLOGY_INGEST_PER_TRACK_SEC=900


# ======================== 本体抽取 LLM ========================
# ⚠⚠ 这是 deploy/.env.example §10 那条警告的正面例子：本容器**不加载 deploy/.env**，
#    收不到那里的 DEFAULT_LLM_MODEL ⇒ 模型名**必须在这里显式给**，
#    否则抽取一路抛 ModelNotConfiguredError(1008)（不会静默用旧名字，但也救不回来）。
# 解析顺序: ONTOLOGY_LLM_MODEL → DEFAULT_LLM_MODEL → 抛 ModelNotConfiguredError。
# 经平台 llm-gateway（OpenAI 兼容），与入库期 LightRAG 抽取共用上游并发额度。
ONTOLOGY_LLM_BINDING_HOST=http://llm-gateway:8787/v1
# 网关内部 token（见 LLMGW_INTERNAL_TOKENS）。**不可留空** —— openai/httpx 客户端
# 见空 key 时行为不一致，且网关侧那一段计量窗口会退化成 unknown。
ONTOLOGY_LLM_BINDING_API_KEY=gw_lightrag
# ⚠ 写**实际在用的模型名**（与 deploy/.env 同值），默认值只是占位。
ONTOLOGY_LLM_MODEL=deepseek/deepseek-flash
# 全局兜底（本容器同样要显式给，理由同上）；与上面二选一即可，建议两个都写同值。
DEFAULT_LLM_MODEL=deepseek/deepseek-flash
# 单次抽取调用超时（秒） [默认: 60]
# ONTOLOGY_LLM_TIMEOUT=60


# ======================== 本体抽取策略 ========================
# 与 atomic-rag 抽取链路同一批变量（现网调优值见 deploy/.env 同名项，换模型/换额度时两边一起改）。
# ⚠ 抽取 LLM 批次并发度：批次经 llm-gateway → 上游，与入库期 LightRAG 抽取共用额度。
# ONTOLOGY_EXTRACT_CONCURRENCY=8
# 每批输入 token 预算 / 单次调用输出上限 / 每 chunk 输出预留
# ONTOLOGY_EXTRACT_BATCH_BUDGET_TOKENS=24000
# ONTOLOGY_EXTRACT_MAX_TOKENS=8192
# ONTOLOGY_EXTRACT_PER_CHUNK_OUTPUT_RESERVE=1000
# gleaning 补抽轮数 / 每批独立采样取并集次数
# ONTOLOGY_EXTRACT_GLEANING=2
# ONTOLOGY_NATIVE_SAMPLE_RUNS=2
# 兜底粗类型池（JSON 数组；ONTOLOGY_NATIVE_FALLBACK_TYPES 优先，回落 ENTITY_TYPES）。
# ⚠ 必须写在这里：native 抽取跑在本容器（P2 起），读不到 deploy/.env.rag 的那份。
# ENTITY_TYPES='["机构","人物",...]'
# 内存护栏（2026-09-13 宿主 OOM 事故，见 deploy/.env.example §11）：
# 每实体/关系 source_chunks 总量上限（0 = 不限） [默认: 32]
# ONTOLOGY_SOURCE_CHUNKS_MAX=32
# 每张表行数上限（Row-as-Object 超出部分只进向量不进图谱） [默认: 2000]
# TABLE_OBJECT_MAX_ROWS=2000
# 零引用 chunk 补跑的数量闸门（0 = 关闭闸门） [默认: 1000]
# ONTOLOGY_MISSING_CHUNK_RERUN_MAX=1000
# 关系/实体兜底通道（默认关；开之前先读 deploy/.env.example §11 的语义说明）
# ONTOLOGY_KEEP_UNTYPED_EDGES=false
# ONTOLOGY_KEEP_FALLBACK_ENTITIES=false
# 抽取 schema 来源：compiled schema（Redis → kb /invoke）缺失时回落的本体 yaml。
# 路径**相对 cwd**（容器里 WORKDIR=/app，镜像已含 deploy/）。
# ONTOLOGY_SCHEMA_FALLBACK_PATH=deploy/config/ontology/default.yaml
# compiled schema 的 Redis 缓存 TTL（秒） [默认: 3600]
# ONTOLOGY_COMPILED_SCHEMA_TTL=3600


# ==================== 表格网格化 / 表格上下文存档 ====================
# 表网格化+表头推断总开关（L1/L2） [默认: true；false 回退旧 normalize_table_rows]
# RAG_TABLE_GRID_V2=true
# 表格上下文存档目录。**留空即可** —— 回落链 RAG_TABLE_CTX_DIR(空) → KB_INPUT_DIR
# （compose 已设 /app/inputs）→ WORKING_DIR，与 atomic-rag 逐值同口径，
# 故两边看到的是同一个共享卷（jonex-rag-inputs），不会各写各的。
# RAG_TABLE_CTX_DIR=
# 存档字节上限 / TTL 秒数 [默认: 67108864 / 7776000(90 天)]
# RAG_TABLE_CTX_MAX_BYTES=67108864
# RAG_TABLE_CTX_TTL_SEC=7776000


# ============================ 日志 ============================
# [默认: INFO]
# LOG_LEVEL=INFO
# 入库分阶段计时日志（IngestStageTiming）总闸 [默认: true]
# INGEST_TIMING_ENABLED=true
