# ============================================================
# Jonex 平台环境变量配置模板（平台/能力/网关容器共享）
# ------------------------------------------------------------
# 用法：make init 会复制本文件为 deploy/.env，再按需修改实际值。
# 约定：
#   - docker-compose.yml 多数基础设施变量已带 ${VAR:-默认值}，
#     这里仅需覆盖与默认不同的项；带「必填」标记的必须设置。
#   - 仅 lightrag 容器的配置见 .env.rag(.example)，不要写在本文件。
# ============================================================

# ============================================================
# 1. 应用与服务基础
# ============================================================
# 运行环境：dev / test / uat / prod
ENV=dev
LOG_LEVEL=INFO
# 容器内 uvicorn/gunicorn 工作进程数
WORKERS=4

# ── 国际化（i18n）──
# 系统默认语言：请求不带 X-Lang header 时的兜底语言（默认 en-US）
# DEFAULT_LOCALE=en-US
# 支持的语言列表（逗号分隔）
# SUPPORTED_LOCALES=zh-CN,en-US

# ============================================================
# 2. PostgreSQL 数据库
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 3. Redis 缓存 / 服务发现
# ============================================================
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=your_redis_password

# ============================================================
# 4. Milvus 向量数据库（MinIO / etcd 为 Milvus 内部依赖）
# ============================================================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_HTTP_PORT=9091
# MinIO 对象存储（Milvus 内部使用，无需修改）
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Etcd（Milvus 内部使用，无需修改）
ETCD_ENDPOINTS=etcd:2379

# ============================================================
# 5. Neo4j 本体图数据库
# ============================================================
# compose 已默认 bolt://neo4j:7687 / neo4j；此处仅覆盖密码与内存
NEO4J_PASSWORD=change-me
# NEO4J_HEAP=1G
# NEO4J_PAGECACHE=512M

# ============================================================
# 6. JWT / 安全
# ============================================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production_please_use_a_strong_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ============================================================
# 7. 认证（登录票据 / 重定向白名单 / CORS / Cookie）
# ============================================================
# 登录票据过期时间（秒），默认 60
LOGIN_TICKET_EXPIRE_SECONDS=60
# 各 appId 允许的 redirect_uri 白名单（JSON 字符串，前缀匹配）
# 本地开发示例:
# AUTH_ALLOWED_REDIRECT_URIS={"core-business":["http://localhost:5175/"],"platform-management":["http://localhost:5177/"],"ecosystem-management":["http://localhost:5176/"]}
# 生产示例:
# AUTH_ALLOWED_REDIRECT_URIS={"core-business":["https://core.jonex.com/"],"platform-management":["https://platform.jonex.com/"],"ecosystem-management":["https://ecosystem.jonex.com/"]}
AUTH_ALLOWED_REDIRECT_URIS={}
# CORS 允许来源（逗号分隔，生产不使用 *；本地不配则默认 *）
# AUTH_CORS_ORIGINS=https://shell.jonex.com,https://core.jonex.com
AUTH_CORS_ORIGINS=
# Cookie 配置（同父域部署时启用，方案待实现）
# AUTH_COOKIE_DOMAIN=.jonex.com
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=Lax

# ============================================================
# 8. 前端
# ============================================================
# 前端对外端口，默认 80
FRONTEND_PORT=80
# 对外接入形态：http | https
#   http （默认）= IP + HTTP 直接访问，不需要域名和证书
#   https        = 域名 + HTTPS，TLS 在 frontend-gateway 容器终止
# 两份候选 nginx 配置都在镜像里，启动时按本变量二选一；切换只改这一行 + make up
# 方案：docs/https-domain-access-plan.md
ACCESS_MODE=http
# 以下两项仅 ACCESS_MODE=https 时需要
FRONTEND_HTTPS_PORT=443
# 宿主机 TLS 证书目录，只读挂载到容器 /etc/nginx/certs。必须是仓库外路径：
# 私钥不能进 git 与 docker build context。目录下须有 fullchain.crt（含中间证书的
# 完整链）与 private.key，文件名固定
TLS_CERT_DIR=/opt/jonex/certs
# 浏览器侧 API 基础地址无需配置：前端各 api 模块的 baseURL 是相对路径 /api/v1，
# 自动跟随页面 scheme 与 host，两种接入形态都工作。原 FRONTEND_API_BASE_URL 已移除。
# Shell 登录页允许回跳的子应用域名白名单（逗号分隔）
# 本地: http://localhost:5174,http://localhost:5175,http://localhost:5177,http://localhost:5176
VITE_ALLOWED_REDIRECT_ORIGINS=

# ============================================================
# 9. 能力服务地址（容器内 hostname；compose 已注入，通常无需改）
# ============================================================
# KNOWLEDGE_BASE_URL=http://knowledge-base-service:8000
# BUSINESS_DOMAIN_URL=http://business-domain-service:8000
# PLATFORM_URL=http://platform-service:8000
# ATOMIC_RAG_URL=http://atomic-rag:8000
# SIDECAR_URL=http://sidecar:8000

# MCP Server 对外地址（mcp_config.url 来源，由 platform 下发；WorkBuddy 等 AI 客户端连接的地址）
# MCP Server 容器直连暴露 8002 端口（无 Nginx 反代）；禁止填容器内 hostname（客户端无法解析）
# 客户端连接 URL 为 /mcp；按部署形态填：本机 http://127.0.0.1:8002/mcp；局域网 http://<服务器IP>:8002/mcp；互联网 HTTPS 需先补 Nginx 反代 + TLS
MCP_SERVER_PUBLIC_URL=http://127.0.0.1:8002/mcp

# ============================================================
# 10. LLM Gateway 上游出口（统一 LLM/Embedding 出口，必配 key）
# ============================================================
# 上游 LLM（默认腾讯 tokenhub）
LLMGW_UPSTREAM_LLM_HOST=https://tokenhub.tencentmaas.com/v1
# 必填：真实上游 LLM key，仅配在网关
LLMGW_UPSTREAM_LLM_API_KEY=your_upstream_llm_api_key_here
# 上游 Embedding（默认本机 Ollama，可改线上）
LLMGW_UPSTREAM_EMBED_HOST=http://host.docker.internal:11434/v1
LLMGW_UPSTREAM_EMBED_API_KEY=ollama
# --- 上游 Rerank（方案 B2：RAG fallback 引用重排）---
# binding=ollama-generate：ollama 无 /rerank，走 /api/generate raw 模板 + yes/no 概率算分（当前）
# binding=cohere：透传上游标准 /rerank（未来切 vLLM/TEI/Xinference/llama-server 时用）
LLMGW_RERANK_BINDING=ollama-generate
LLMGW_RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
LLMGW_UPSTREAM_RERANK_HOST=http://host.docker.internal:11434
LLMGW_UPSTREAM_RERANK_API_KEY=ollama
# 生成式模型模板族（仅 ollama-generate 用）：qwen3 | gemma | plain（目前仅 qwen3 经实测）
LLMGW_RERANK_PROMPT_PROFILE=qwen3
LLMGW_RERANK_MAX_DOCS=12
LLMGW_RERANK_CONCURRENCY=4
LLMGW_RERANK_TIMEOUT=30
# 合法内部 token（逗号分隔），下游服务/LightRAG 用其访问网关
LLMGW_INTERNAL_TOKENS=gw_lightrag,gw_platform,gw_openkb
# 计量与 PG 批量缓冲
LLMGW_METERING_ENABLED=true
LLMGW_PG_FLUSH_MAX_ROWS=20
# --- embedding 聚合写入（降低 metering.llm_usage_log 行量，见 docs/llm-usage-log-optimization-plan.md §4.3）---
# 命中 scene 的 embedding 调用按 (tenant,scene,model,kb,doc,day) 日级 UPSERT 累加，
# 从"每 chunk 一行"降到"每文档每天一行"。默认关；开启建议把上面的 FLUSH_MAX_ROWS 调大（如 100）。
LLMGW_EMBED_AGGREGATE_ENABLED=true                                   # 总开关；true 开启聚合
LLMGW_EMBED_AGGREGATE_SCENES=lightrag_embed,ontology_embed            # 逗号分隔命中 scene；留空=不聚合
# --- 关思考（thinking.disabled）注入：加速实体/关系抽取等分类任务 ---
# ⚠️ 仅适配腾讯 tokenhub：注入的 body.thinking={"type":"disabled"} 是 tokenhub
#    （tencentmaas）的专有格式。换其他上游（OpenAI/DeepSeek 官方/vLLM 等）需改
#    jonex_core/llm_gateway/upstream.py 的 _maybe_disable_thinking 适配其关思考参数，
#    否则上游可能报错或忽略；此时应把 LLMGW_DISABLE_THINKING_ENABLED 设为 false。
# 命中"模型 + 场景"且调用方未显式带 thinking 时，网关注入该字段后透明转发。
# 分档策略（docs/ontology-query-thinking-latency-fix-plan.md §3）：
#   · 抽取场景（lightrag_extract / ontology_extract / raganything_ingest）：恒禁思考
#   · 裁决（ontology_arbitration）：恒禁思考（二选一分类 + json_object 强约束，
#     现状 8s 超时 + 思考 = 每次超时回退原答案，禁思考只升不降）
#   · 查询作答的 `_fast` 变体（ontology_qa_fast / rag_chunk_qa_fast / rag_fusion_fast）：
#     严格模式**快档**派生，求秒回
#   · 查询作答的原始 scene（ontology_qa / rag_chunk_qa / rag_fusion）**不在本列表**：
#     非严格模式与严格模式**精档**一律保留思考（要精度）
# 移除某个 `_fast` 项即让该场景恢复思考（配置级回滚，无需改代码）。改这些只需重启 llm-gateway。
LLMGW_DISABLE_THINKING_ENABLED=true                                   # 总开关；false 时完全停用
LLMGW_DISABLE_THINKING_MODELS=deepseek-v4-flash-202605                      # 逗号分隔；留空=不限模型
LLMGW_DISABLE_THINKING_SCENES=lightrag_extract,ontology_extract,raganything_ingest,ontology_arbitration,ontology_qa_fast,rag_chunk_qa_fast,rag_fusion_fast       # 逗号分隔；留空=不限场景（含查询）
# --- [jonex] 上游 429 有界重试 + 退避（§12 B 方案：网关内部重试吸收上游限流）---
# Retry-After≈60 场景：RETRY_MAX=1 + TOTAL_BUDGET=75 恰好 1 次 60s 等待跨过整窗。
# 如需容忍连续两个限流分钟（少见）：RETRY_MAX=2 + TOTAL_BUDGET=130。
# 总预算语义 = 累计重试 sleep（不含请求耗时），须 < LightRAG LLM 超时。
# LLMGW_UPSTREAM_RETRY_ENABLED=true       # 总开关；false 回退旧「透传不重试」行为
# LLMGW_UPSTREAM_RETRY_STATUS=429         # 触发重试的上游状态码（逗号分隔；可加 503）
# LLMGW_UPSTREAM_RETRY_MAX=1              # 最大重试次数（不含首次）
# LLMGW_UPSTREAM_RETRY_BACKOFF_BASE=2     # 指数退避基数秒（无 Retry-After 时用）
# LLMGW_UPSTREAM_RETRY_BACKOFF_MAX=30     # 单次退避上限秒
# LLMGW_UPSTREAM_RETRY_JITTER=1.0         # 抖动上限秒（0~JITTER 随机叠加防踩点）
# LLMGW_UPSTREAM_RETRY_TOTAL_BUDGET=75    # 单请求累计重试等待总预算秒（仅含 sleep）
# LLMGW_UPSTREAM_RETRY_AFTER_CAP=120      # 病态 Retry-After 裁剪上限秒

# ============================================================
# 11. 本体抽取与本体问答 LLM
# ============================================================
# 启用后，atomic-rag 在解析 + LightRAG 入库完成后，结合 ontology schema
# 对齐/消歧/归类，写入 PostgreSQL ontology schema。
# ONTOLOGY_EXTRACT_ENABLED=true
# ONTOLOGY_SCHEMA_PATH=deploy/config/ontology/default.yaml
# 实体描述写入 Neo4j 的截断长度（answer_from_facts 核心上下文，默认 1000）
# ONTOLOGY_ENTITY_DESC_MAXLEN=1000
# schema relation_types 稀疏时，对已有边落通用 RELATED_TO 边保证图非空（默认 false）
# ONTOLOGY_KEEP_UNTYPED_EDGES=false
# 关闭"丢弃孤立实体（度=0 且描述为空）"，保留更多实体提升召回（默认 true=丢弃）
# ONTOLOGY_EXTRACT_DROP_ORPHAN=false
# 单次抽取参与归类的候选实体上限（默认 200）：大文档下保留更多实体，代价是归类 LLM 调用增多
# ONTOLOGY_EXTRACT_MAX_ENTITIES=500
# 本体抽取 LLM 批次并发度（实体归类 + 关系定型共用；默认 8，<1 归一）。
# 批次经 llm-gateway → 上游 LLM，与入库期 LightRAG 抽取共用上游并发额度
# （tokenhub 实测约 48 触发 429，见 scripts/bench_llm_extract.py）。原逐批串行，
# 改并行后 ontology_extract_ms 显著下降；上游限流更严/多文档并行时下调。
# ONTOLOGY_EXTRACT_CONCURRENCY=8
# ── 关系实体名归一化修复（stub 治理，详见 docs/ontology-relation-stub-fix-plan.md）──
# P1：写库时把关系端点按 canonical/alias 对齐到正式实体，避免捏造 stub（默认 true）
# ONTOLOGY_REL_ENDPOINT_RESOLVE=true
# P2A：关系定型让 LLM 只回 idx→relation_type，端点名取原始边，消除 LLM 改名（默认 true）
# ONTOLOGY_REL_USE_ORIGINAL_ENDPOINT=true
# P2C：对被丢弃/截断的关系端点补建 unknown 正式实体，保证两端非 stub（默认 true）
# ONTOLOGY_ENTITY_BACKFILL_ENDPOINTS=true
# 本体优先检索路由阈值（BM25 ≥ 此值走本体 LLM，否则降级 RAG），默认 1.0
# ONTOLOGY_ROUTE_SCORE_MIN=1.0
# ── 本体向量语义检索（Neo4j 原生向量索引）──
# 总开关：false 时完全回退到三级字面匹配（exact/prefix/fulltext），行为与改造前一致
# ONTOLOGY_VECTOR_ENABLED=true
# 向量路由余弦阈值（qwen3-embedding:8b 中文同义/近义余弦常落在 0.75~0.85）
# ONTOLOGY_VECTOR_SCORE_MIN=0.75
# 向量近邻 topK（租户过滤前放大取；实际 = max(该值, limit*20)）
# ONTOLOGY_VECTOR_TOPK=200
# RRF 融合参数
# ONTOLOGY_RRF_K=60
# ONTOLOGY_RRF_W_FT=1.0
# ONTOLOGY_RRF_W_VEC=1.0
# ── RAG fallback 引用重排（方案 B2）──
# 总开关：true 时用 reranker（经 llm-gateway /v1/rerank）按相关性排序 references 取 top-N，
# 失败/关闭时兜底回退 len(locations) 频次排序。默认关闭（灰度）。
# ONTOLOGY_RAG_FALLBACK_RERANK_ENABLED=false
# RAG fallback 最大引用文档数（top-N）
# ONTOLOGY_RAG_FALLBACK_MAX_REFS=5
# ── RAG fallback 召回明细 ──
# 总开关：true 时 STAGE_RAG_FALLBACK 的 detail 增加 recalls[] 轻量召回明细（含 chunk_id）
# ONTOLOGY_RAG_RECALL_DETAIL_ENABLED=true
# 召回明细最大条数（防推理链膨胀）
# ONTOLOGY_RAG_RECALL_MAX_ITEMS=20
# 单条 text 截断字数
# ONTOLOGY_RAG_RECALL_TEXT_MAX=200
# rerank client（经 llm-gateway；改这些需重启服务）
# RERANK_BINDING_HOST=http://llm-gateway:8787/v1
# RERANK_BINDING_API_KEY=gw_lightrag
# RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
# 检索期 rerank 配置态（仅供 reasoning 展示，须与 .env.rag 的 RERANK_BINDING 一致）
# RAG_RETRIEVAL_RERANK_ENABLED=false
# [jonex] §block-packing §10 L2：跨页打包 chunk 引用页精算（页段打分，默认开；
# false 或精算失败时回落 chunk 起点页，与改造前一致）
# RAG_REF_PAGE_SCORING_ENABLED=true
# embedding 文本 description 截断长度
# ONTOLOGY_EMBED_DESC_MAXLEN=300
# 查询 embedding TTL 缓存秒数
# ONTOLOGY_QUERY_EMBED_TTL=300
# 查询 embedding 缓存最大条目数（LRU 淘汰）
# ONTOLOGY_QUERY_EMBED_CACHE_MAX=500
# 查询 embedding 调用超时（秒）。避免 openai SDK 默认 600s 超时在上游冷启动/排队时
# 把单次 embedding 拖到十几秒，进而拖慢本体匹配（ontology_match）阶段；同时作为
# 向量分支 asyncio.wait_for 的硬上界，超时即降级「仅全文召回」，不阻塞搜索链路。
# ONTOLOGY_EMBED_TIMEOUT=5
# 查询 embedding 最大重试次数。openai SDK 默认重试 2 次会把最坏耗时放大到 timeout×3，
# 故收紧为 1；设 0 则完全不重试。
# ONTOLOGY_EMBED_MAX_RETRIES=1
# ── 本体多跳邻域召回 ──
# 邻域遍历深度（跳数），默认 1（仅直接邻居，行为与现状一致）。范围 1~ONTOLOGY_NEIGHBOR_DEPTH_MAX
# ONTOLOGY_NEIGHBOR_DEPTH=1
# 邻域遍历深度硬上限，防止配置失误导致图遍历爆炸，默认 3
# ONTOLOGY_NEIGHBOR_DEPTH_MAX=3
# 返回事实总条数上限，默认 20（与现状 limit=20 对齐）
# ONTOLOGY_NEIGHBOR_LIMIT=20
# 单跳层级中间扇出上限，遍历过程中限制每跳膨胀，默认 50
# ONTOLOGY_NEIGHBOR_PER_HOP_LIMIT=50
# 邻域查询独立超时（秒），变长多跳在稠密图上可能长时间阻塞，需独立超时保护，默认 15
# ONTOLOGY_NEIGHBOR_TIMEOUT=15
# ── 方案④：本体作答超时秒数（30 为当前基线，可按实测下调至 8~10）──
ONTOLOGY_ANSWER_TIMEOUT=30
# 方案④b：事实量预判阈值 — 邻域取到的事实数低于此值直接跳过本体作答（0=不启用）
ONTOLOGY_MIN_FACTS=0
# ── 方案②：融合宽度上限（仅对 top-N 个有效答案做融合，其余仅作引用来源）──
ONTOLOGY_RAG_FUSION_TOPN=5
# ── 方案③：多 KB 并行查询并发上限（信号量，默认 7）──
ONTOLOGY_RAG_MAX_CONCURRENCY=7
# ── P1-5 RAG 召回后处理 ──
# 送 LLM 融合前的 chunk 级重排（经 llm-gateway /v1/rerank，默认关）
RAG_PRELLM_RERANK_ENABLED=true
RAG_PRELLM_RERANK_TOPK=8
# ── §image-refs P4：图片引用配额（docs/image-reference-accuracy-fix-plan.md 方案 A）──
# RAG_IMAGE_REF_SCORE_MIN：图片 location 分数阈值，低于此值直接丢弃。
#   分数链 final_score > relevance > group_final_score > _order_score；
#   默认 0.3：2026-08 以真实文档（岭南画派-10p，62 图）× 6 条真实查询实测，
#   rerank 分二值化——真相关 ≥0.74（四屏 query 下四屏图 0.745~0.991）、
#   弱相关 ≤0.03，0.3 位于两带之间（10 倍安全余量）。
#   rerank 关闭时分数退化为位置衰减分（0~1），阈值会误伤后半段候选，
#   该场景应设 0。设 0 关闭过滤。
# RAG_IMAGE_REF_MAX：通过阈值后每个文档保留的图片 location 上限。
#   默认 6；设 999 等同关闭配额上限
# RAG_IMAGE_REF_SCORE_MIN=0.3
# RAG_IMAGE_REF_MAX=6
# 主体一致性信号总开关（方案 B 语义：软加权，永不删除候选；默认关）
# ⚠️ 旧实现为白名单硬剔除，全部不中时会清空 references
#   （见 docs/rag-subject-filter-and-answer-source-remediation-plan.md §4/§5）。
RAG_SUBJECT_FILTER_ENABLED=false
# 主体分权重 λ：final = (1-λ)×rerank 相关性 + λ×主体分（仅主体信号开启时生效）
RAG_SUBJECT_WEIGHT=0.25
# ── 方案 A：平台取回作答权（LightRAG 降为 retriever，答案收归平台侧）──
# 总开关：false 时 RAG 降级走现有「LightRAG 生成 + 融合」链路；true 时
# only_need_context 只召回 + 平台 answer_from_chunks 一次作答（答案与引用同源）。
# 灰度默认关；新路径失败当次自动回退旧链路。
RAG_PLATFORM_ANSWER_ENABLED=false
# 送 answer_from_chunks 的 chunk 文本总长上限（字符，硬截）
RAG_ANSWER_MAX_CONTEXT_CHARS=12000
# ── Embedding 出口（kb-service 与 lightrag 共享，单一真相源；必须与 .env.rag 一致）──
# ⚠️ 首篇文档处理后不可再更改；kb-service 用此建 Neo4j 向量索引 + 算 embedding hash
EMBEDDING_DIM=1024
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_BINDING_HOST=http://llm-gateway:8787/v1
# 本体 embedding 是否向上游发送 dimensions（与 LightRAG 对齐，收敛到 EMBEDDING_DIM）。
# ⚠️ 灰度：首次部署保持 false（仅靠 kb-service 客户端截断兜底，零静默失败风险）；
#    用直连 ollama 确认支持 dimensions 后再改 true 把截断下沉到上游。
#    详见 docs/ontology-vector-embedding-dim-mismatch-fix-plan.md §5.2 / §7.0。
EMBEDDING_SEND_DIM=false
EMBEDDING_BINDING_API_KEY=gw_lightrag
# ── §9 严格模式（总闸，false 时忽略请求 strict_mode）──
STRICT_MODE_ENABLED=true
# 两档结构（快档 / 精档）；原 3 档同配置无梯度，见方案 §2.6
STRICT_MAX_ATTEMPTS_CAP=2
# ── [jonex] 对侧 RAG 校验整体超时（秒）；超时按「对侧无结果」保留本体原答案 ──
# 仅对精档生效（快档由 gear.cross_verify=False 跳过对侧）。
# 取值由精档超时台账反推，见方案 §3.4：15+60+20+8+5=108 < 精档 timeout 120。
ONTOLOGY_CROSS_RAG_TIMEOUT=20
STRICT_MIN_SCORE=0.8
STRICT_ATTEMPT_TIMEOUT=60
STRICT_TOTAL_BUDGET=150
STRICT_WEIGHT_NON_REFUSAL=0.35
STRICT_WEIGHT_REFERENCE=0.15
STRICT_WEIGHT_GROUNDED=0.30
STRICT_WEIGHT_CONSISTENCY=0.20
# ── P2-7 作答常识放宽配置 ──
ONTOLOGY_ANSWER_ALLOW_COMMON_SENSE=true
# ── §10 深度查询配置 ──
DEEP_QUERY_ENABLED=true
DEEP_MAX_SUBQUERIES=6
DEEP_SUBQUERY_CONCURRENCY=5
DEEP_TOTAL_BUDGET=180
# 编排推理链总闸（默认开；前端再用 with_reasoning 按请求控制）
# REASONING_TRACE_ENABLED=true
# 本体问答 / RAG 融合回答的 LLM 出口（ontology_llm.py、ontology_extractor.py 读取）
# 经服务器 llm-gateway；api_key 用网关内部 token（见 LLMGW_INTERNAL_TOKENS），
# 不可留空——openai SDK 见空 key 会抛 "Missing credentials"。
ONTOLOGY_LLM_BINDING_HOST=http://llm-gateway:8787/v1
ONTOLOGY_LLM_BINDING_API_KEY=gw_lightrag
ONTOLOGY_LLM_MODEL=deepseek-v4-flash-202605

# 本体模板编译
# ONTOLOGY_AUTO_COMPILE=true
# ONTOLOGY_COMPILED_SCHEMA_TTL=3600
# ONTOLOGY_SCHEMA_FALLBACK_PATH=deploy/config/ontology/default.yaml
# 模板源（business_domain / yaml_default），默认 business_domain
# ONTOLOGY_TEMPLATE_SOURCE=business_domain

# ============================================================
# 12. RAG / LightRAG 对接（atomic-rag → lightrag-server）
# ============================================================
# atomic-rag 调用 lightrag-server 的 API 密钥
# 必须与 .env.rag 中的 LIGHTRAG_API_KEY 保持一致
LIGHTRAG_API_KEY=change-me-in-production-please
# 文档入库完成后回调 business 层，不配置则静默跳过
RAG_WEBHOOK_URL=
# RAG 检索客户端最小查询长度阈值（必须 >= 3，LightRAG server 硬约束）
# RAG_MIN_QUERY_LEN=3
# v2 入库轮询总超时（秒）——[jonex] §13.4 起此值为**动态缩放的下限(floor)**：
# 实际窗口 = clamp(本值, RAG_TRACK_SCALE_PER_CHUNK_SEC×chunk数, RAG_TRACK_SCALE_CEIL_SEC)，
# 大文档由 RAG_TRACK_SCALE_* 动态放大，本值仅保证小文档不会低于此。须 ≥ per-chunk。
# RAG_TRACK_TIMEOUT_SECONDS=1800
# v2 单 chunk 独立超时窗口（秒）——同为**动态缩放的下限**，小文档保底、大文档按量放大。
# RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS=900
# v2 超时 chunk 重推最大次数（仅 PushChunksStage，恢复路径不重推）
# RAG_TRACK_PER_CHUNK_MAX_RETRIES=2
# v2 轮询并发度，限制同时查询 track_status 的并发数
# RAG_TRACK_POLL_CONCURRENCY=8
# [jonex] §13.4 item1：超时窗口按 chunk 数动态下限（floor，仅放大不缩小）。
# 有效窗口 = clamp(上面两个 base, SCALE×chunk数, CEIL)；超大文档长尾不再被固定值误判超时。
# SCALE=0 关闭（回退固定值）；CEIL 绝对上限（< HARD 6h）。默认 2 / 10800(3h)。
# RAG_TRACK_SCALE_PER_CHUNK_SEC=2
# RAG_TRACK_SCALE_CEIL_SEC=10800
# 文档级并发：atomic-rag TaskManager 同时处理的文档数（后台 worker 协程数），改后需重建 atomic-rag 镜像。
# WORKER_COUNT=4
# 任务队列容量（总槽位 = WORKER_COUNT + 此值；满时入库请求返回 429）。
# TASK_QUEUE_CAPACITY=100
# 单文档内多模态描述 LLM 并发（scene=raganything_ingest：表格/公式/音频等 LLM 快任务，单次约 2~3s），
# 改后需重建 atomic-rag 镜像。HTTP 入库模式原硬编码为 2；实际并发 ≈ WORKER_COUNT × 此值。
# 上游限 200 次/分钟且与 lightrag_extract(MAX_ASYNC)/ontology_extract 共用额度；安全并发约 7~10。
# 注意：图片（VLM）不在此列——由下方 MAX_PARALLEL_VLM 独立限流。默认 4。
# MAX_PARALLEL_MULTIMODAL=4
# 单文档内图片/视频关键帧 VLM 并发（直连远端 VLM，不经 llm-gateway；thinking 模型单次 4~105s），
# 改后需重建 atomic-rag 镜像。远端槽位有限，并发过高会排队超过 VLM 超时（RAG_VLM_TIMEOUT）
# 触发 ReadTimeout 重试风暴。实际并发 ≈ WORKER_COUNT × 此值。默认 2。
# MAX_PARALLEL_VLM=2
# 单次 VLM 调用超时（秒）：驱动默认 120s 对 thinking 模型太紧，提到 300s 给长思考留余量。
# RAG_VLM_TIMEOUT=300
# 单次 VLM 输出 max_tokens 上限（0=不限制）。低量化 thinking 模型描述冗长时可设 300
# 起灰度；过小会截断 JSON 导致解析重试失败。默认 0（关）。
# RAG_VLM_MAX_TOKENS=300
# VLM 思考深度（none/low/medium/high）：默认 none 关闭思考。实测思考开启时单图 4~105s、
# 约 1.2 万完成 token 且低量化下易带幻觉；关闭后约 3s/160 token，描述更贴合图片。
# RAG_VLM_REASONING_EFFORT=none

# ── 知识库对账/超时巡检（knowledge-base-service 的 patrol_parsing_timeout；纯后端，改后无需重建镜像）──
# 软超时（秒）：PARSING/INGESTING 文档超过此时长后，对账开始探活；任务仍在处理/排队则继续等待，绝不无脑重推
# RAG_TASK_SOFT_TIMEOUT_SEC=3600
# 硬超时（秒，默认 6h）：超过即使任务仍在处理也判死置 FAILED 并打 ERROR 告警；大批量入库长期堆积时可调大
# RAG_TASK_HARD_TIMEOUT_SEC=21600
# 探测失败容忍次数：get_task_status 连续失败达此次数才判任务已死，避免瞬时网络抖动误杀在途任务
# RAG_TASK_PROBE_FAIL_MAX=3

# ============================================================
# 13. MinerU 解析器
# ------------------------------------------------------------
# RAG_PARSER 三选一：
#   · mineru          本地 MinerU CLI（进程内跑模型，需 torch+模型，GPU 可选）
#   · mineru_online   mineru.net 云端 API（需 MINERU_API_TOKEN + 外网）
#   · mineru_selfhost 内网自建 mineru-api 服务（HTTP 客户端，无需本地 torch/GPU）
# 切换只改 RAG_PARSER；详见 docs/mineru-selfhost-parser-execution-plan.md
# ============================================================
RAG_PARSER=mineru

# 【打包变量】RAG_PROFILE：atomic-rag 镜像依赖胖瘦，仅构建 atomic-rag 镜像时生效（非运行时）。
#   full（默认）：全量依赖，三种 RAG_PARSER 都能真跑（含本地 mineru，镜像大 ~含 torch/CUDA）。
#   slim        ：仅 online/selfhost，去 torch/CUDA/mineru，省 ~3.9GB（本地 mineru 不可用）。
# RAG_PROFILE=full

# [jonex] #4 v2 解析瞬时错误重试（所有 parser 生效，替换旧 MINERU_PARSE_*）
# RAG_PARSE_RETRY_MAX=3             # 含首次重试次数（默认 3）
# RAG_PARSE_RETRY_BASE_SEC=2.0      # [jonex] #4 v2 指数退避基数（秒，默认 2.0）
# RAG_REQUIRE_DOC_IDS=true          # [jonex] #6 严格逐 chunk 确认 doc_id（默认 true）

# ── [jonex] 表格解析与切块治理（docs/table-parsing-retrieval-governance-plan.md §5/§9.2）──
# 注意：这些变量由 atomic-rag（raganything）进程读取（env_file=.env），不要放进 .env.rag*。
# RAG_TABLE_GRID_V2=true            # 表格网格化+表头推断总开关（L1/L2，默认 true；false 回退旧 normalize_table_rows）
# TABLE_HEADER_MAX_LEN=40           # 表头长文本剔除阈值（字符）：超过或含句末符 → 判为表前说明写入 notes
# RAG_TABLE_CHUNK_MAX_CHARS=900     # 表格专用切块预算（字符，O1）：仅表格分支生效，文本链路仍用 RAG_CHUNK_MAX_CHARS
#                                   # 校准：scripts/calibrate_table_chunk_budget.py
# RAG_LIGHTRAG_CHUNK_SIZE=1200      # 表格 chunk 超限断言阈值（token）：须与 .env.rag 的 CHUNK_SIZE 一致
# XLSX_NATIVE_NORMALIZE=true        # xlsx 双路合并（L3）：openpyxl 表格主轨 + MinerU 图片轨；false 全量交 MinerU
# RAG_PROMPT_LANG=zh                # 解析/摘要 prompt 语言（L4.2）：zh 中文模板 / en 英文；进程级全局，默认 zh

# ── [jonex] §block-packing 文本块级打包（docs/text-block-packing-chunk-governance-plan.md §3）──
# 同样由 atomic-rag（raganything）进程读取（与表格链路参数同段，勿写进 .env.rag）
# RAG_TEXT_BLOCK_PACKING=true       # 总开关（默认 true；false 完全回退逐块 1:1，产出与改造前逐字节一致）
# RAG_TEXT_PACK_CHARS=1260          # 字符预算主控（= 900 token × 1.4 系数固化，见计划 §3.1）
# RAG_TEXT_PACK_MAX_TOKENS=1200     # 硬上限断言（token）：超限 WARNING + 切分 + 计 oversize_text_chunks；须与 .env.rag CHUNK_SIZE 一致
# RAG_TEXT_PACK_HEADING_MAX_LEN=40  # heading-like 判定长度上限（字符，C5 判据）；编号模式（C4）不受此限制
# RAG_TEXT_PACK_DROP_NOISE=true     # 噪声丢弃（C2/C3）；false=零信息损失模式（噪声按正文吸附进包）

# ── [jonex] §image-refs 图片资产上传（docs/image-reference-chain-execution-plan.md P1-4）──
# 同样由 atomic-rag（raganything）进程读取（勿写进 .env.rag）；false 只停
# 资产上传与 aext 旁路（检索侧图片引用无 asset_url），不阻塞主链路
# RAG_ASSET_UPLOAD_ENABLED=true     # 图片资产上传总开关（默认 true）

# ── [jonex] §image-refs 图片版面主题锚点（docs/image-reference-accuracy-fix-plan.md E 方案 P0-6）──
# 入库侧从 MinerU content_list 确定性提取版面主题（图注→x 重叠列下方图注→
# 本页标题），拼在 VLM 描述之前：图片描述：【版面主题：xxx】{VLM 描述}。
# 锚点来源写入 file_source 旁路 anchor_src=cap|foot|col|heading。false 回退旧行为。
# RAG_IMAGE_ANCHOR_ENABLED=true     # 锚点总开关（默认 true）

# ── [jonex] reparse 补偿 cleanup 收敛循环（docs/rag-reparse-strict-cleanup-busy-plan.md）──
# RAG_PUSH_RETRY_TERMINAL_FAILED=true   # 1-A(atomic-rag)：track 终态 failed 的 chunk 纳入有界重推（默认 true；false 回退旧行为）
# RAG_CLEANUP_MAX_ELAPSED=1800          # P0(atomic-rag)：_converge_delete 收敛循环最长运行时间（秒，默认 1800）
# RAG_CLEANUP_POLL_DELAY=5              # P0(atomic-rag)：收敛循环每轮 poll 间隔（秒，默认 5）
# RAG_CLEANUP_POLL_PER_DOC_SEC=2        # P0(atomic-rag)：deadline 随删除量缩放 per-doc 秒数（默认 2）
# RECONCILE_CLEANUP_BASE_SEC=600        # 3-A(kb-service)：cleanup 卡死动态超时基数（秒，默认 600）
# RECONCILE_CLEANUP_PER_DOC_SEC=15      # 3-A(kb-service)：每待删 doc 追加秒数（默认 15）→ 超时=min(CEIL, BASE+PER_DOC×待删总量)
# RECONCILE_CLEANUP_CEIL_SEC=21600      # 3-A(kb-service)：动态超时上限（秒，默认 6h）；超时把文档置 FAILED
# RECONCILE_SUBMIT_GRACE_SEC=180       # R2-a(kb-service)：提交宽限期（秒），task_id 为空且锚点在此窗口内不判死（默认 180）
# RECONCILE_IDEMPOTENCY_LOOKUP_ENABLED=true # R2-b(kb-service)：幂等键反查开关，false 回退到仅 a+c 查证
# RAG_COS_FETCH_IN_TASK=true           # R7-2b(atomic-rag)：COS 下载异步化开关（true=任务 pipeline 内下载；false=同步路径回退）

# ---- (A) 本地 mineru CLI 用 ----
# 模型下载源：modelscope=国内直连免代理；huggingface=需外网/代理。
# 注意：MinerU 认此环境变量切源，CLI --source 对 VLM 后端不生效。仅 RAG_PARSER=mineru 时生效。
MINERU_MODEL_SOURCE=modelscope

# ---- (B) mineru_selfhost：内网 mineru-api 服务 ----
# MINERU_SELFHOST_BASE_URL=http://127.0.0.1:8000   # 改为你的内网 mineru-api 地址
# MINERU_SELFHOST_BACKEND=pipeline        # 或 hybrid-engine（VLM 高精度、较慢）
# MINERU_SELFHOST_LANG=ch
# MINERU_SELFHOST_POLL_INTERVAL=5
# MINERU_SELFHOST_POLL_TIMEOUT=1800
# MINERU_SELFHOST_RETURN_IMAGES=false     # 需要图片模态时置 true

# ---- (C) mineru_online：mineru.net 云 API ----
# MINERU_API_TOKEN=your_token_here
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_MODEL_VERSION=vlm
# MINERU_POLL_INTERVAL=5
# MINERU_POLL_TIMEOUT=1800

# ============================================================
# 14. 对象存储（local 本地文件系统 / cos 腾讯云 COS / S3）
# ============================================================
OBJECT_STORAGE_BACKEND=local
# 仅 OBJECT_STORAGE_BACKEND=cos 时需要配置以下项：
COS_KEY_PREFIX=jonex
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=jonex-kb-1250000000
# COS_PRESIGN_EXPIRES=900

# S3 兼容（AWS S3 / MinIO / 国内云 S3 兼容端点），改 OBJECT_STORAGE_BACKEND=s3 后生效。
# MinIO 需 S3_ENDPOINT_URL 指向 MinIO；AWS S3 不填 endpoint。
# S3_ADDRESSING_STYLE 留空或 auto 即自动推导（有 endpoint→path，无 endpoint→virtual），
# 一般无需显式设置。注意不要指望 botocore 的 auto：它在无 endpoint 时会签出
# <bucket>.s3.amazonaws.com（丢 region）而签名带真实 region，AWS 侧一律 403。
# S3_REGION 直连 AWS S3 时必填（决定 endpoint 主机名，填错会 403）；
# MinIO 等自建端点无多区域概念，可省略，默认 us-east-1（与 MinIO 缺省站点 region 一致，
# 除非服务端配了 MINIO_SITE_REGION，那就填成一样的值）。
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_BUCKET=your-s3-bucket-name
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ADDRESSING_STYLE=auto
# S3_PRESIGN_EXPIRES=900

# 注：S3 后端复用 COS_KEY_PREFIX 作为对象键前缀（未单独设 S3_KEY_PREFIX）。

# --- 前端 CSP 的存储来源 ---------------------------------------------------
# 图片与音视频预览走 302 直跳对象存储（Range 流式最优），浏览器会校验 CSP 的
# img-src / media-src；PDF/文本/Markdown 走网关同源代理，不受此项影响。
# 不设时按 OBJECT_STORAGE_BACKEND 取默认值，所以 cos 和 local 后端无需配置：
#   cos   → 自动用 https://*.myqcloud.com
#   local → 自动留空（local 不产生预签名 URL，原文从共享卷同源返回）
#   s3    → 无法推导（host 随 region / 自建域变化），必须显式配置，否则容器启动时会告警
# 填 scheme://host，不含路径。按实际预签名 URL 的主机名来定：
#   AWS S3（virtual-hosted，bucket 占一级子域，未设 S3_ENDPOINT_URL 时的默认形式）：
#     CSP_STORAGE_ORIGIN=https://*.s3.ap-northeast-1.amazonaws.com
#   AWS S3（path-style）： CSP_STORAGE_ORIGIN=https://s3.ap-northeast-1.amazonaws.com
#   MinIO 等自建端点：    CSP_STORAGE_ORIGIN=https://minio.example.com
# 不确定主机名时，预览一次文档，看 gateway 日志的「原文预览: ... upstream=」字段。
# CSP_STORAGE_ORIGIN=

# ============================================================
# 15. 数据源接入（API 接入 / 文件存储直连 / API 开放推送）
# ============================================================
# 凭据加密密钥（base64 urlsafe 32 字节；生成：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 生产必填；不配时开发态从 JWT_SECRET 派生。
DATA_SOURCE_SECRET_KEY=
# 生成 api_push 入站推送 URL 用
PUBLIC_API_BASE=http://localhost

# ============================================================
# 16. 审计日志（所有容器共享，非 platform 容器通过 AUDIT_INGEST_URL 转发）
# ============================================================
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_ASYNC=true
# AUDIT_QUEUE_MAX_SIZE=10000
# AUDIT_FLUSH_BATCH_SIZE=100
# AUDIT_FLUSH_INTERVAL_MS=200
# AUDIT_RETENTION_DAYS=90
# AUDIT_HTTP_METHODS=POST,PUT,PATCH,DELETE
# 非 platform 容器（knowledge_base / business_domain）转发到 platform；
# compose 已为各容器注入，通常无需在此设置。
# AUDIT_INGEST_URL=http://platform-service:8000

# ============================================================
# 17. TCADP 平台（可选）
# ============================================================
TCADP_API_URL=https://tcadp.tencent.com/api
TCADP_API_KEY=your_tcadp_api_key_here
TCADP_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# 18. VLM / ASR 连接信息（音视频链路，preset 不写死；优先级 preset override > env > profile）
# ============================================================
VLM_BINDING_HOST=vision-model-address
VLM_BINDING_API_KEY=not-needed
VLM_MODEL_NAME=qwen3.6:35b

ASR_BINDING=openai_compatible
