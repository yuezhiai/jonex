# ============================================================
# Jonex 平台环境变量配置模板（平台/能力/网关容器共享）
# ------------------------------------------------------------
# 用法：make init 会复制本文件为 deploy/.env，再按需修改实际值。
# 约定：
#   - docker-compose.yml 多数基础设施变量已带 ${VAR:-默认值}，
#     这里仅需覆盖与默认不同的项；带「必填」标记的必须设置。
#   - 仅 lightrag 容器的配置见 .env.rag(.example)，不要写在本文件。
# ============================================================

# ============================================================
# 1. 应用与服务基础
# ============================================================
# 运行环境：dev / test / uat / prod
ENV=dev
LOG_LEVEL=INFO
# 容器内 uvicorn/gunicorn 工作进程数
WORKERS=4
# [jonex] P0-1：atomic-rag 容器内存上限（docker-compose.yml 的 mem_limit /
# memswap_limit，两者取同值 = 禁用 swap）。原先无上限，2026-09-13 本体抽取产出
# 把宿主内存吃到 23.7GB、内核 oom-killer 随机挑进程杀（那次挑中 python 自己，
# 触发者是 healthcheck 的 curl）。加上限后超限只死本容器（OOMKilled=true）。
# 正常文档 VmPeak ≈2.3GB，12g 留足余量；异常大文档由 ONTOLOGY_SOURCE_CHUNKS_MAX
# 等配额在源头拦，本项只是崩溃边界。
# ATOMIC_RAG_MEM_LIMIT=12g

# ── 国际化（i18n）──
# 系统默认语言：请求不带 X-Lang header 时的兜底语言（默认 en-US）
# DEFAULT_LOCALE=en-US
# 支持的语言列表（逗号分隔）
# SUPPORTED_LOCALES=zh-CN,en-US

# ============================================================
# 2. PostgreSQL 数据库
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 3. Redis 缓存 / 服务发现
# ============================================================
REDIS_URL=redis://redis:6379/0
# ⚠️ 留空 ⇒ Redis **不启用认证**（现状/开发便利）。生产必须：
#   1) 设 REDIS_PASSWORD=<随机值>（`make init` 会自动生成）
#   2) 同步把上面 REDIS_URL 改成 redis://:<同一个值>@redis:6379/0
#   两处不一致会导致应用认证失败连不上 Redis。
#   compose 的 redis 服务仅在 REDIS_PASSWORD 非空时才加 --requirepass，healthcheck 亦随之带 -a。
REDIS_PASSWORD=

# ============================================================
# 4. Milvus 向量数据库（MinIO / etcd 为 Milvus 内部依赖）
# ============================================================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_HTTP_PORT=9091
# MinIO 对象存储（Milvus 内部使用）
# ⚠️ 默认 minioadmin 是**公开默认凭据**，生产必须覆盖 MINIO_ROOT_PASSWORD。
#    compose 把这两个值派生给 milvus 客户端，故**改这里即服务端与客户端一致**。
# ⚠️ 变量名别搞错：milvus 只认 MINIO_ACCESS_KEY_ID / MINIO_SECRET_ACCESS_KEY
#    （见镜像内 /milvus/configs/milvus.yaml 注释）；旧名会被**静默忽略**、回落到内置
#    默认 minioadmin —— dev 里因两边都是 minioadmin 而蒙对，一旦按上文轮换就报
#    "The Access Key Id you provided does not exist in our records."，milvus 持续
#    Unhealthy 并拖垮 make up-prod。下面两行旧名已无 compose 消费者，仅为历史兼容
#    保留，**勿据其判断实际凭据**。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Etcd（Milvus 内部使用，无需修改）
ETCD_ENDPOINTS=etcd:2379

# ============================================================
# 5. Neo4j 本体图数据库
# ============================================================
# compose 已默认 bolt://neo4j:7687 / neo4j；此处仅覆盖密码与内存
NEO4J_PASSWORD=change-me
# NEO4J_HEAP=1G
# NEO4J_PAGECACHE=512M

# ============================================================
# 6. JWT / 安全
# ============================================================
# ⚠️ **刻意留空**。各服务启动守卫在生产档（`ENV=prod`）会拒绝空值与仓库内公开的
# 默认值（fail-closed，见 jonex_core/common/security_guards.py）——
# 直接照抄本模板部署会起不来，这是设计而非失误。
# 正常路径：`make init` 从本模板创建 deploy/.env 时会**自动生成**随机值
# （scripts/security/rotate_secrets.py --fill-missing）。
# 手工部署：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 判定按 ENV 分档（2026-10-15）：`ENV=prod` 硬拦拒绝启动；dev/test/uat/未设置
# 只打一条 warning 后放行（非生产画像沿用公开值本来就是预期，不该被拦成重启循环）。
# ⚠️ 代价：**忘了设 `ENV=prod` 的对外实例会失去这层硬拦** —— 所以对外画像必须
#    显式写 `ENV=prod`（`audit_profile.py` 第 2 项会把漏设判 🔴，且不设 ENV 还会
#    同时打开 `jonex_test_<租户>` 测试 token 后门）。
# 本地开发若确需沿用不安全值，显式设 ALLOW_INSECURE_JWT_SECRET=1（生产严禁）。
# ⚠️ 泄漏后果：可伪造任意用户（含管理员）JWT 与 ingest key（可向任意租户知识库注入数据）。
# ⚠️ 轮换注意：既有**用户会话**全部失效。MCP Key / ingest key 的 HMAC 盐优先取
#    MCP_KEY_SECRET，**仅在其为空时**才回退本值（jonex_core/common/crypto.py）——
#    故只有未设 MCP_KEY_SECRET 的部署会被本值的轮换牵连（详见下方 MCP_KEY_SECRET 段）。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# MCP Key / ingest key 的 HMAC 盐（与 JWT_SECRET 解耦，实现见 jonex_core/common/crypto.py）
# 留空 ⇒ 回退 JWT_SECRET（既有行为不变）。⚠️ 轮换 JWT_SECRET 前**必须先配好这两个**，
# 否则存量 MCP Key（yxm_*）与 api_push 的 ingest key 会全部失配、必须重新下发。
#   MCP_KEY_SECRET        当前盐，生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
#   MCP_KEY_SECRET_LEGACY 仅校验用的旧盐；盐轮换时填「轮换前生效的盐」以放行存量 key
# 轮换当前盐用：scripts/security/rotate_mcp_salt.py --profile <画像目录>
# （刻意不并入 `make init` —— 初始化时轮换会意外作废线上 key）
MCP_KEY_SECRET=
MCP_KEY_SECRET_LEGACY=

# 内部服务间认证：Gateway /internal/* 校验的 X-Internal-API-Key。
# ⚠️ 网关启动守卫 fail-closed：未配置 / 留空 / 仍是仓库内公开值
#    ⇒ gateway 拒绝启动（frontend-gateway 等依赖它的容器一并起不来）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# `make init` 会自动生成。
# ⚠️ mcp-server 调 Gateway /internal/kb/invoke 时携带同一把 key，
#    deploy/.env.mcp 的 INTERNAL_API_KEY 必须与本值逐字一致，否则 MCP 知识库工具 401。
INTERNAL_API_KEY=

# ============================================================
# 7. 认证（登录票据 / 重定向白名单 / CORS / Cookie）
# ============================================================
# 登录票据过期时间（秒），默认 60
LOGIN_TICKET_EXPIRE_SECONDS=60
# 各 appId 允许的 redirect_uri 白名单（JSON 字符串）。
# ⚠️ 匹配规则**不是**前缀匹配：scheme + host + port 必须**精确相等**，只有 path 走**前缀**匹配
#    （且边界对齐，防 /apps/core 误匹配 /apps/coreevil）。因此 `http://localhost` 与
#    `http://localhost:80` **互不匹配**（前者 port 解析为 None）——写白名单时端口要么都写、要么都不写。
# ⚠️ 同一份配置被**两条链路**以不同口径消费，别把它们当一回事：
#    ① SSO 登录（authorize / callback）：把各组的值**摊平成一个 list**统一校验，
#       **appId 分组不参与判定**——任一组的条目都能放行 SSO 登录落点。
#    ② 登录票据（`create_login_ticket`，账号密码等）：按 appId **精确取该组**，本组缺失直接报
#       `未找到 appId=<x> 的白名单配置`（不会去别组兜底）。
#    结论：**只走 SSO 登录**时写进任意一组即可；**也要走登录票据**时，该 appId 的条目必须写在**它自己的组**里。
# 本地开发示例:
# AUTH_ALLOWED_REDIRECT_URIS={"core-business":["http://localhost:5175/"],"platform-management":["http://localhost:5177/"],"ecosystem-management":["http://localhost:5176/"]}
# 生产示例:
# AUTH_ALLOWED_REDIRECT_URIS={"core-business":["https://core.jonex.com/"],"platform-management":["https://platform.jonex.com/"],"ecosystem-management":["https://ecosystem.jonex.com/"]}
# Docker 本地部署示例（前端经 frontend-gateway 80，SSO 登录回跳 shell 根）:
# AUTH_ALLOWED_REDIRECT_URIS={"core-business":["http://localhost/apps/core-business/","http://localhost/"],"platform-management":["http://localhost/apps/platform-management/","http://localhost/"],"ecosystem-management":["http://localhost/apps/ecosystem-management/","http://localhost/"]}
AUTH_ALLOWED_REDIRECT_URIS={}
# CORS 允许来源（逗号分隔，生产不使用 *；本地不配则默认 *）
# AUTH_CORS_ORIGINS=https://shell.jonex.com,https://core.jonex.com
AUTH_CORS_ORIGINS=
# Cookie 配置（同父域部署时启用，方案待实现）
# AUTH_COOKIE_DOMAIN=.jonex.com
# 是否给 refresh cookie 加 Secure 属性（代码默认 true，生产 https 部署保留）。
# ⚠️ http 环境（非 https、非 localhost，如 http://<服务器IP>）必须显式设为 false：
#   带 Secure 属性的 cookie 会被浏览器拒绝存储，导致 SSO 登录态无法落地、刷新页面跳回登录页。
#   仅 localhost 调试时例外（浏览器允许 localhost 上的 Secure cookie）。
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=Lax

# ── 登录页租户框（经 GET /api/v1/auth/login-config 下发；改后需重启 platform-service）──
# 默认租户 ID：登录页租户框的预填值。留空 = 不预填，由用户手输。
# 例：DEFAULT_TENANT_ID=tenant_jonex_demo
DEFAULT_TENANT_ID=
# 是否隐藏登录页的租户 ID 输入框。**默认 false，不配置即不隐藏** ——
# 多租户部署下用户必须能自己填租户，隐藏只给单租户部署用：
# HIDE_TENANT_INPUT=true
#
# ⚠️ 隐藏必须与 DEFAULT_TENANT_ID 成对使用：租户是登录的必填参数，只配了 true
#    而没配默认租户，服务端会强制回落成「显示」并在 platform 日志记一条 warning
#    （否则登录页会因为填不出租户而彻底无法登录）。

# ── 登录页「企业 SSO」入口显隐（经 GET /api/v1/auth/login-config 下发；改后需重启 platform-service）──
# 本项经 /auth/login-config 下发 —— 与上方租户框**同一端点**（原独立探测端点已物理删除并入本端点）。
# 是否隐藏登录页的「使用公司SSO登录」按钮**及其上方「或」分隔线**（两者同进同退，
# 只藏按钮会剩一条悬空的「或」）。**默认隐藏**：未配置 / =true / 空串 ⇒ 隐藏；
# **只有显式 =false 才展示**。
#
# 判据 = 「部署级 SSO 可用（sso_enabled）**且**未被本开关隐藏」。未配 Keycloak 时入口
# 本来就自动隐藏（既有行为，本开关改不动它），本项只用于「Keycloak 已配好、但本部署
# 不想暴露 SSO 入口」的场景。⚠️ 只藏**入口**，不关闭 SSO 端点本身。
# ⚠️ 本开关**不参与** sso_enabled 的派生 —— sso_enabled 同时是两处生产启动守卫
#    （sidecar / platform）的开关，并入会让配了 Keycloak 的部署跳过 KEYCLOAK_CLIENT_SECRET 哨兵校验。
# ⛔ 勿类推上方 HIDE_TENANT_INPUT：两者**方向相反**（HIDE_TENANT_INPUT 仍是「默认 false
#    = 不隐藏」），二者在同段落登记，极易被一并「统一」。
# HIDE_SSO_LOGIN=true

# ── 部署级界面开关：顶栏「任务中心」按钮（platform-service；改后重启 platform-service 生效）──
# 任务中心功能尚未完善，某些环境不该显示入口；我们自己的环境不配即显示。
# **默认 false = 不隐藏**（不配置 / =false ⇒ 显示）。
#
# 关掉的只有**一处**：shell 顶栏那个「任务中心」快捷按钮。
# ⛔ 子应用侧栏的菜单项**照常显示**，直接敲 URL 也**进得去**（路由守卫照常按权限码放行）——
#    这是 2026-10-09 明确的口径：只关顶栏入口，不阻止任何人进页面。
# ⛔ 任务中心那六个接口（两读四写）也**照常可用**。**只关界面，不关功能。**
#
# 实现方式（**改代码前先读**）：和登录页的 SSO 入口/租户框显隐是同一套形状 ——
#   后端 env → platform 侧解析 → 一个只读接口下发 → 前端照值渲染。
# 具体是 `GET /platform/frontend/ui-config`（已登录、普通鉴权）下发
# `{"hide_task_center": bool}`；shell 顶栏取一次，`hide={true}` 就不渲染那个按钮。
# 后端在 `capabilities/platform/api/platform_crud.py` 的 `get_frontend_ui_config`；
# 前端在 `frontends/shell/src/api/uiConfig.ts` + `TaskCenterEntry`。
# ⚠️ 别把它接到侧栏或路由守卫上 —— 那就从「关界面」变成「关功能」了。
# ⚠️ 也**别塞进 `/auth/login-config`**：那个口服务未登录的登录页，响应形状归登录页独占。
#
# ⚠️ 取到垃圾值（如 `ture`）会让 platform-service **启动失败**（Pydantic 布尔解析拒绝），
#    不会静默当成 false —— 静默的失败方式是「配了却还是看得见、且没有任何提示」。
# HIDE_TASK_CENTER=false

# ── Keycloak SSO 客户端（OIDC；服务由独立 keycloak 项目承载，jonex 只做客户端）──
# 本段是**双分支**配置：不填真实值 ⇒ 未启用 SSO，整套系统照常部署与使用（跳过 SSO 相关
# 校验与初始化）；填了真实值 ⇒ SSO 正常工作，SSO 以外部分零改动。两种形态都可直接 `make up`。
#
# 部署级启用判据 `sso_enabled`（`KeycloakSettings.sso_enabled`，**部署级、非租户级**）逐字定义：
#   KEYCLOAK_REDIRECT_URI 非空 AND KEYCLOAK_CLIENT_ID 非空
#     AND (KEYCLOAK_AUTHORIZE_BASE_URL 非空 OR KEYCLOAK_SERVER_URL 非空)
# ⛔ 不要与**租户级** `identity_integration_config.sso_enabled` 混淆：那是 DB 里逐租户的
#    开关（控制某租户是否走 SSO），本项是部署级、只看 env，二者层级与消费方完全不同。
#
# 平台侧连接 Keycloak（sidecar / platform-service 读；gateway 只透传不验签，无需）。
# 本地 dev 后端跑宿主时用 localhost:8081；Docker 部署时后端在容器内，localhost 指向容器自身，
# 需按独立 keycloak 项目实际网络改成 host.docker.internal:8081 或同 network 服务名。
KEYCLOAK_SERVER_URL=http://localhost:8081
# 浏览器视角 Keycloak 基地址（authorize 302 目标，浏览器须可达），与 SERVER_URL 解耦：
# Docker 下 SERVER_URL 填 host.docker.internal（后端进程用），此变量须填浏览器可达地址（如 localhost:8081）。
# 空 = 回退 KEYCLOAK_SERVER_URL（向后兼容）。
KEYCLOAK_AUTHORIZE_BASE_URL=http://localhost:8081
# issuer 白名单（JSON，issuer -> {jwks_uri, client_id, audience}）；fail-closed 精确匹配，
# issuer 与 jwks_uri 必须与独立项目实际签发的 realm 一致（示例 realm=jonex-tenant_jonex_demo）。
# ⚠️ 下面的取值是**非 Docker（后端跑宿主进程）**形态：issuer key / jwks_uri 与
#    KEYCLOAK_SERVER_URL=http://localhost:8081 同源。**Docker 部署**下后端在容器内，
#    localhost:8081 会指向容器自身，须按 deploy/README.md「Keycloak SSO 客户端」Docker 要点
#    改成 host.docker.internal:8081（platform 服务已配 extra_hosts:
#    host.docker.internal:host-gateway），否则容器内换 token / SSO「测试连接」探测会连到容器自身。
# ⚠️ 该白名单的 issuer key 现在还多一个用途：SSO「测试连接」从它反推探测基址（取该条目的
#    jwks_uri、去掉固定后缀 /realms/{realm}/protocol/openid-connect/certs）。故 key 必须与该
#    租户 tenant_realm_map.issuer_url 同源（同一 realm 的同一个 issuer），二者不一致时
#    探测目标会取自白名单而非该列。
KEYCLOAK_ISSUER_WHITELIST={"http://localhost:8081/realms/jonex-tenant_jonex_demo":{"jwks_uri":"http://localhost:8081/realms/jonex-tenant_jonex_demo/protocol/openid-connect/certs","client_id":"jonex-platform","audience":"jonex-platform"}}
KEYCLOAK_CLIENT_ID=jonex-platform
# ⚠️ 本项在Jonex侧**运行时无人消费**（无任何代码读取它做认证）。唯一读取者是生产启动
#    哨兵：值仍为默认 change-me-in-production 时拒绝启动，仅用于防止一个无效配置被
#    带上生产。jonex-platform 是 public client、走 PKCE，**没有 secret**，因此这里
#    **禁止**填下面 jonex-admin 的 secret——两者是用途完全不同的两回事。
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# 平台级 realm-admin 凭据：账号停用/启用同步（全仓唯一做 client_credentials 的地方）
# 专用，对应各 realm 里 confidential 的 jonex-admin client。值必须与 realm 渲染产物中
# jonex-admin 的 secret 逐字一致；由 Keycloak 部署向导自动写入本机 .env。
# 留空 = 视为未配置：同步降级为「跳过并写审计」，不会拿错凭据去换 token。
KEYCLOAK_REALM_ADMIN_CLIENT_ID=jonex-admin
KEYCLOAK_REALM_ADMIN_CLIENT_SECRET=
# OIDC 回调地址（浏览器回跳，须与 Keycloak client redirectUris 精确一致）。
# 本地 dev（gateway 直接 8000 对外）：http://localhost:8000/api/v1/auth/oidc/callback
# 部署（frontend-gateway 80 对外，/api 反代进 gateway）：http://<对外地址>/api/v1/auth/oidc/callback
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# ⚠️ 是否在 authorize URL 上注入 `kc_idp_hint`（跳过 Keycloak 中间授权页直达 IdP）。
#    false（默认，**保持现状**）= 不携带任何 IdP 提示参数，授权行为与改造前**逐字一致**；
#    true              = Keycloak 不再显示自己的登录表单，直接 303 跳到下方 alias 指向的 IdP。
# ⚠️ 这是**唯一的回退开关**：线上出问题关掉即完全回退，不需改代码、不需动 Keycloak 侧配置。
# ⚠️ 前置条件：目标 realm 的 browser flow 必须包含 identity-provider-redirector，
#    否则该参数**静默失效**（不报错，回落 Keycloak 自身登录表单）。
# 本地 dev / 生产 / Docker 三处取值一致（本项与网络拓扑无关，只看是否需要跳页）。
# ⚠️ 本项与下方其余 8 个 int/bool 键同属**不吃空串**的一组（曾是最隐蔽的启动杀手）：
#    KEYCLOAK_CLOCK_SKEW_LEEWAY_SECONDS / KEYCLOAK_JWKS_TIMEOUT_SECONDS /
#    KEYCLOAK_JWKS_CACHE_TTL_SECONDS / KEYCLOAK_ADMIN_TOKEN_TTL_SECONDS /
#    KEYCLOAK_TIMEOUT / KEYCLOAK_STATE_TTL_SECONDS / KEYCLOAK_IDP_HINT_ENABLED /
#    KEYCLOAK_BACKCHANNEL_IAT_MAX_AGE_SECONDS / KEYCLOAK_BACKCHANNEL_JTI_TTL_SECONDS
#    两种情况已分层处理，别把它们混为一谈：
#      ① 键**缺失** 或 **留空 / 纯空白**（`KEYCLOAK_TIMEOUT=`）⇒ 回退该字段默认值，安全（本次已实现）；
#      ② **非法值**（`KEYCLOAK_TIMEOUT=abc`）⇒ 仍抛 ValidationError 拒绝启动 —— 这是**有意的
#         fail-fast**：配置写错要在启动期早暴露，不要当 bug 改掉。键可以留空，但写上就必须合法。
# ⛔ 不要把 Keycloak 整段改成注释态：本次结论是「键缺失与键置空都已安全」，
#    模板保留可填写的值对「填了真实值」的部署形态更友好。
KEYCLOAK_IDP_HINT_ENABLED=false
# 平台级默认 IdP alias（**非**租户级配置）：**无租户级覆盖值时**使用，故不需要任何逐租户手工配置。
# 租户级覆盖值来自 DB 列 platform.identity_integration_config.idp_hint_alias（NULL = 用本默认值）。
# 取值 = 该租户 realm 内 IdP 的 alias（本环境为 casdoor）。配错时 Keycloak 静默回落
# 自身登录表单（软失败，不报错），排查时先核对 realm 内该 alias 是否存在。
# 本地 dev / 生产 / Docker 三处取值一致。
# ⚠️ 本项**不要留空**：`KEYCLOAK_IDP_HINT_DEFAULT_ALIAS=` 会得到空串（**不会**回退
#    casdoor）⇒ 等同于「带空 alias」，Keycloak 静默回落自身登录表单。需要默认行为时
#    请删掉本行或显式写 casdoor。
KEYCLOAK_IDP_HINT_DEFAULT_ALIAS=casdoor
# 登出（RP-initiated logout）完成后浏览器回跳地址，须与 Keycloak client 的
# post.logout.redirect.uris 白名单**同源**，否则 Keycloak 报 invalid_redirect_uri、整个登出失败。
# ⚠️ 要填**页面入口**（SPA origin），不是 API 入口：8000 是 Gateway，只服务 /api/**、**没有 `/` 路由**。
# 本地 dev：http://localhost:8080/（Dev Gateway）；部署：http://<对外地址>/（nginx FRONTEND_PORT，默认 80）
# 空 = 不带该参数（Keycloak 结束后停在自己的「已登出」页）。
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost/

# ── 本地联调：身份同步侧车（可选；默认不随 make up 起）─────────────────
# 本组变量**只被身份同步侧车读取** —— 它是「Jonex标准拉取 API 契约」⇄ 真实上游
# IdP（Casdoor）之间的翻译官，**随本仓库分发**（deploy/identity-sync-gateway/，
# 含 README 与 Dockerfile；compose 里带 `profiles:`，默认不随 make up 起，
# 要改用 `docker compose --profile identity-sync-gateway up -d`）。
# 用途是把「企业身份集成」的立即同步（E4）经侧车指向真实外部 IdP，
# 用真实用户快照跑通全链路。
# ⚠️ 这一跳**平台运行时（Gateway / Sidecar / 各 capability）完全不读**，
#    只有侧车容器读；生产不用侧车时整组留空即可。
# ⚠️ 平台侧**自己**的身份同步配置在**文件末尾 §21**（`IDENTITY_SYNC_*`，
#    由 platform-service 读），与这一组不是一回事，别混淆。
# ⚠️ 侧车**没有合成用户集回落**：下面 `MOCK_DATASOURCE_*` 与
#    `DATASOURCE_GATEWAY_TOKEN` 共 5 个键**全部必填**，缺任何一个侧车启动即退出（非 0 码）。
# 变量名用通用前缀，不绑定任何具体 IdP 厂商。
#
# ⚠️ 副作用：侧车本身零写入，但平台会把拉到的用户**真实建成本地账号**（用真名、无前缀，
#    回收成本高）。先靠 MOCK_DATASOURCE_USERNAMES 收窄范围，用完及时清理。
#
# 外部数据源的**接口基址**：填提供「拉取用户」接口的那个地址，
# ⛔ 不要填门户首页地址——门户首页是 SPA，同步会以「数据契约不符」(5007) 失败
MOCK_DATASOURCE_BASE_URL=https://idp.example.com:8000
# 目标组织标识。读错组织会拿不到用户，或直接被拒（无权读取该组织）
MOCK_DATASOURCE_OWNER=example-org
# 管理员账号。口令**不要写在本文件**——`.env.example` 受 git 跟踪，
# 真实口令只填已 gitignore 的 deploy/.env（同名键）
MOCK_DATASOURCE_ADMIN_USER=admin
MOCK_DATASOURCE_ADMIN_PASSWORD=
# 分页大小，选填，默认 100
MOCK_DATASOURCE_PAGE_SIZE=100
# 登录名白名单，逗号分隔，选填；留空 = 全量拉取（⚠️ 最容易误建大量真名账号的开关）
MOCK_DATASOURCE_USERNAMES=

# ── 侧车自身的鉴权与行为（同样只有侧车读）──────────────────────────
# 侧车对平台的鉴权 token（**必填**）：平台租户 UI 里填的 token 必须与本值**同值**；
# 缺失则侧车进程启动即退出（非 0 码）。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# ⚠️ 这不是上游 IdP 的口令 —— 上游口令是上面的 MOCK_DATASOURCE_ADMIN_PASSWORD，
#    两者互不相干：本键只挡「平台 → 侧车」这一跳。
DATASOURCE_GATEWAY_TOKEN=
# 侧车监听端口（容器内）。⚠️ compose 的端口映射固定写死 8099（宿主只绑 127.0.0.1），
# 改这里的值须同步改 deploy/docker-compose.yml 里 identity-sync-gateway 段的 ports。
DATASOURCE_GATEWAY_PORT=8099
# 增量游标模式：
#   time_window （默认）按上游 updatedTime 时间窗近似，是真增量
#   always_full         忽略入参 cursor，永远回全量 + 当前时刻游标
DATASOURCE_GATEWAY_INCREMENTAL_MODE=time_window

# ── 填写示例：本环境实际在用的 Casdoor 实例 ──────────────────────────
# 以下均为**注释**，不会生效，只作填写参照；启用请把值填到上方对应键。
#   MOCK_DATASOURCE_BASE_URL=http://127.0.0.1:8000
#       Casdoor 的 Admin API 基址（实测把 IP 写死，IP 漂移即整套失效）。
#   MOCK_DATASOURCE_OWNER=jonex-demo
#       ⛔ 不要填 built-in —— 读 built-in 会报 Unauthorized operation（实测）。
#       该组织实测 16 人；门户 UI 显示「约 20 人」是含其它组织的口径，别拿它对账。
#   MOCK_DATASOURCE_ADMIN_USER=admin
#   MOCK_DATASOURCE_ADMIN_PASSWORD=<Casdoor 控制台当前口令>
#       ⚠️ 口令随实例走、不随 bundle 走：换实例后旧值大概率无效，别照抄历史值。
#   MOCK_DATASOURCE_PAGE_SIZE=100
#   MOCK_DATASOURCE_USERNAMES=
#       留空 = 拉该组织全量（本例 16 人）。只想验通路就先填小名单，例如
#       MOCK_DATASOURCE_USERNAMES=hujun,zhouhao
#
# 其他 IdP 同理：填它的「拉取用户」接口基址 + 组织/租户标识 + 一个能读该组织的管理员账号。
# ⚠️ 各家「拉取用户」响应的字段名不同（本示例按 Casdoor 的 `name` / `displayName` /
#    `isForbidden` / `isDeleted` 取值），换厂商需同步调整桩侧的字段映射——属脚手架改动。

# ============================================================
# 8. 前端
# ============================================================
# 前端对外端口，默认 80
FRONTEND_PORT=80
# 对外接入形态：http | https
#   http （默认）= IP + HTTP 直接访问，不需要域名和证书
#   https        = 域名 + HTTPS，TLS 在 frontend-gateway 容器终止
# 两份候选 nginx 配置都在镜像里，启动时按本变量二选一；切换只改这一行 + make up
# 方案：docs/https-domain-access-plan.md
ACCESS_MODE=http
# 以下两项仅 ACCESS_MODE=https 时需要
FRONTEND_HTTPS_PORT=443
# 宿主机 TLS 证书目录，只读挂载到容器 /etc/nginx/certs。必须是仓库外路径：
# 私钥不能进 git 与 docker build context。目录下须有 fullchain.crt（含中间证书的
# 完整链）与 private.key，文件名固定
TLS_CERT_DIR=/opt/jonex/certs
# 浏览器侧 API 基础地址无需配置：前端各 api 模块的 baseURL 是相对路径 /api/v1，
# 自动跟随页面 scheme 与 host，两种接入形态都工作。原 FRONTEND_API_BASE_URL 已移除。
# Shell 登录页允许回跳的子应用域名白名单（逗号分隔）
# 本地: http://localhost:5174,http://localhost:5175,http://localhost:5177,http://localhost:5176
VITE_ALLOWED_REDIRECT_ORIGINS=

# ============================================================
# 9. 能力服务地址（容器内 hostname；compose 已注入，通常无需改）
# ============================================================
# KNOWLEDGE_BASE_URL=http://knowledge-base-service:8000
# BUSINESS_DOMAIN_URL=http://business-domain-service:8000
# PLATFORM_URL=http://platform-service:8000
# ATOMIC_RAG_URL=http://atomic-rag:8000
# SIDECAR_URL=http://sidecar:8000
# OPENKB_URL=http://openkb:7566

# MCP Server 对外地址（mcp_config.url 来源，由 platform 下发；WorkBuddy 等 AI 客户端连接的地址）
# MCP Server 容器直连暴露 8002 端口（无 Nginx 反代）；禁止填容器内 hostname（客户端无法解析）
# 客户端连接 URL 为 /mcp；按部署形态填：本机 http://localhost/mcp；局域网 http://<服务器IP>/mcp；互联网 HTTPS 需先补 Nginx 反代 + TLS
MCP_SERVER_PUBLIC_URL=http://localhost/mcp

# ============================================================
# 10. LLM Gateway 上游出口（统一 LLM/Embedding 出口，必配 key）
# ============================================================
LLM_MODEL=deepseek-v4-flash
# 全局兜底模型名（可留空）。代码里不再有写死的模型名兜底，取不到时抛
# ModelNotConfiguredError（1008），不会静默用旧名字。
# ⚠⚠ 但它**只在「加载 .env 的服务」里生效** —— 也就是 compose 里 env_file 写
#     `.env` 的那些：platform / sidecar / llm-gateway / knowledge-base /
#     atomic-rag / business-domain / task-center。
#   有 4 个引擎容器**不加载 .env**、各带专属 env 文件，因此**收不到本变量**：
#     openkb(.env.openbk) · jonex-wiki(.env.jonex_wiki) · lightrag(.env.rag)
#     ontology-compile(.env.ontology_compile) —— 本体编译独立容器（P2）；
#       ⚠ 它**确实要用 LLM**（本体抽取），故其模型名必须在
#         deploy/.env.ontology_compile 里显式设置（ONTOLOGY_LLM_MODEL / DEFAULT_LLM_MODEL）。
#   它们的模型名必须在各自文件里**显式设置** —— **没有「统一换模型只改一处」这回事**，
#   换模型时这几个文件要一起改（漏改的容器会继续用旧名字，且日志里只显示旧模型名、
#   看不出它根本没读到新配置）。
#   其中 openkb 走 LiteLLM、必须带 provider 前缀（见 .env.openkb.<画像>），
#   天生无法与其他服务共用同一个变量的形态。
# DEFAULT_LLM_MODEL=
GATEWAY_API_KEY=

# ============================================================
# 能力容器并行 REST 层 —— **已物理删除**（2026-10 渗透测试整改）
# ============================================================
# knowledge_base / business_domain 容器历史上除 `/invoke`（生产链路，强制内部
# JWT）外，还带一层并行 REST（`/api/v1/knowledge-info`、`/api/v1/prompt-templates`…）。
# 该层不在生产链路上、却无鉴权且按客户端 `X-Tenant-ID` 决定租户 —— 是渗透测试
# 报告 3.2/3.3/3.4/3.5 的根因。
#
# 该层实现**与** `CONTAINER_REST_ENABLED` 开关均已删除，本文件不再有任何相关
# 配置项。与此无关的 `/docs` 自动文档收敛见 §P3。

# 上游 LLM（默认腾讯 tokenhub）
LLMGW_UPSTREAM_LLM_HOST=https://tokenhub.tencentmaas.com/v1
# 必填：真实上游 LLM key，仅配在网关
LLMGW_UPSTREAM_LLM_API_KEY=your_upstream_llm_api_key_here
# 上游 Embedding（默认本机 Ollama，可改线上）
LLMGW_UPSTREAM_EMBED_HOST=http://host.docker.internal:11434/v1
LLMGW_UPSTREAM_EMBED_API_KEY=ollama
# --- 上游 Rerank（方案 B2：RAG fallback 引用重排）---
# binding=ollama-generate：ollama 无 /rerank，走 /api/generate raw 模板 + yes/no 概率算分（当前）
# binding=cohere：透传上游标准 /rerank（未来切 vLLM/TEI/Xinference/llama-server 时用）
LLMGW_RERANK_BINDING=ollama-generate
LLMGW_RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
LLMGW_UPSTREAM_RERANK_HOST=http://host.docker.internal:11434
LLMGW_UPSTREAM_RERANK_API_KEY=ollama
# 生成式模型模板族（仅 ollama-generate 用）：qwen3 | gemma | plain（目前仅 qwen3 经实测）
LLMGW_RERANK_PROMPT_PROFILE=qwen3
LLMGW_RERANK_MAX_DOCS=12
# rerank 并发上限。cohere 绑定下语义是**批并发**（批数超本值则按轮次串行）：
#   默认 4 → 115 条 = 10 批要跑 3 轮 ≈465ms；45 条那 4 批才恰好一轮。
# 上游被打爆时调小本值即唯一旋钮（见 llm_gateway/upstream.py 的取舍注记）。
LLMGW_RERANK_CONCURRENCY=4
LLMGW_RERANK_TIMEOUT=30
# 合法内部 token（逗号分隔），下游服务/LightRAG 用其访问网关
LLMGW_INTERNAL_TOKENS=gw_lightrag,gw_platform,gw_openkb,gw_jonex_wiki
# 计量与 PG 批量缓冲
LLMGW_METERING_ENABLED=true
LLMGW_PG_FLUSH_MAX_ROWS=20
# --- embedding 聚合写入（降低 metering.llm_usage_log 行量，见 docs/llm-usage-log-optimization-plan.md §4.3）---
# 命中 scene 的 embedding 调用按 (tenant,scene,model,kb,doc,day) 日级 UPSERT 累加，
# 从"每 chunk 一行"降到"每文档每天一行"。默认关；开启建议把上面的 FLUSH_MAX_ROWS 调大（如 100）。
LLMGW_EMBED_AGGREGATE_ENABLED=true                                   # 总开关；true 开启聚合
LLMGW_EMBED_AGGREGATE_SCENES=lightrag_embed,ontology_embed            # 逗号分隔命中 scene；留空=不聚合
# --- 关思考（thinking.disabled）注入：加速实体/关系抽取等分类任务 ---
# ⚠️ 仅适配腾讯 tokenhub：注入的 body.thinking={"type":"disabled"} 是 tokenhub
#    （tencentmaas）的专有格式。换其他上游（OpenAI/DeepSeek 官方/vLLM 等）需改
#    jonex_core/llm_gateway/upstream.py 的 _maybe_disable_thinking 适配其关思考参数，
#    否则上游可能报错或忽略；此时应把 LLMGW_DISABLE_THINKING_ENABLED 设为 false。
# 命中"模型 + 场景"且调用方未显式带 thinking 时，网关注入该字段后透明转发。
# 分档策略（docs/ontology-query-thinking-latency-fix-plan.md §3）：
#   · 抽取场景（lightrag_extract / ontology_extract / raganything_ingest）：恒禁思考
#   · 裁决（ontology_arbitration）：恒禁思考（二选一分类 + json_object 强约束，
#     现状 8s 超时 + 思考 = 每次超时回退原答案，禁思考只升不降）
#   · 查询作答的 `_fast` 变体（ontology_qa_fast / rag_chunk_qa_fast / rag_fusion_fast）：
#     严格模式**快档**派生，求秒回
#   · 查询作答的原始 scene（ontology_qa / rag_chunk_qa / rag_fusion）**不在本列表**：
#     非严格模式与严格模式**精档**一律保留思考（要精度）
# 移除某个 `_fast` 项即让该场景恢复思考（配置级回滚，无需改代码）。改这些只需重启 llm-gateway。
LLMGW_DISABLE_THINKING_ENABLED=true                                   # 总开关；false 时完全停用
# ⚠️ 这里必须写**实际在用的模型名**（如 deepseek-v4-flash-202605），不是占位的 deepseek/deepseek-flash ——
# 模型名对不上时这一行等于没配，白名单静默失效。
LLMGW_DISABLE_THINKING_MODELS=deepseek-v4-flash-202605                      # 逗号分隔；留空=不限模型
# ⚠️ `image_query_caption`（以图问知识）**不能漏**：该场景走的是思考型模型，
# 不登记时 reasoning 会把 max_tokens 整个吃掉、正文恒为空字符串 ——
# 不是"慢一点"，是"永远识别失败"。详见本文档末「以图问知识」一节。
LLMGW_DISABLE_THINKING_SCENES=lightrag_extract,ontology_extract,raganything_ingest,ontology_arbitration,ontology_qa_fast,rag_chunk_qa_fast,rag_fusion_fast,image_query_caption       # 逗号分隔；留空=不限场景（含查询）
# --- [jonex] 上游 429 有界重试 + 退避（§12 B 方案：网关内部重试吸收上游限流）---
# Retry-After≈60 场景：RETRY_MAX=1 + TOTAL_BUDGET=75 恰好 1 次 60s 等待跨过整窗。
# 如需容忍连续两个限流分钟（少见）：RETRY_MAX=2 + TOTAL_BUDGET=130。
# 总预算语义 = 累计重试 sleep（不含请求耗时），须 < LightRAG LLM 超时。
# LLMGW_UPSTREAM_RETRY_ENABLED=true       # 总开关；false 回退旧「透传不重试」行为
# LLMGW_UPSTREAM_RETRY_STATUS=429         # 触发重试的上游状态码（逗号分隔；可加 503）
# LLMGW_UPSTREAM_RETRY_MAX=1              # 最大重试次数（不含首次）
# LLMGW_UPSTREAM_RETRY_BACKOFF_BASE=2     # 指数退避基数秒（无 Retry-After 时用）
# LLMGW_UPSTREAM_RETRY_BACKOFF_MAX=30     # 单次退避上限秒
# LLMGW_UPSTREAM_RETRY_JITTER=1.0         # 抖动上限秒（0~JITTER 随机叠加防踩点）
# LLMGW_UPSTREAM_RETRY_TOTAL_BUDGET=75    # 单请求累计重试等待总预算秒（仅含 sleep）
# LLMGW_UPSTREAM_RETRY_AFTER_CAP=120      # 病态 Retry-After 裁剪上限秒

# ============================================================
# 11. 本体抽取与本体问答 LLM
# ============================================================
# 启用后，atomic-rag 在解析 + LightRAG 入库完成后，经独立抽取器
# （NativeOntologyExtractor）做双层类型抽取，TBox 档写入 PostgreSQL ontology schema。
# ONTOLOGY_EXTRACT_ENABLED=true
# ONTOLOGY_SCHEMA_PATH=deploy/config/ontology/default.yaml
# 实体描述写入 Neo4j 的截断长度（answer_from_facts 核心上下文，默认 2000）
# ONTOLOGY_ENTITY_DESC_MAXLEN=2000
# 本体抽取 LLM 批次并发度（默认 8，<1 归一）。
# 批次经 llm-gateway → 上游 LLM，与入库期 LightRAG 抽取共用上游并发额度
# （tokenhub 实测约 48 触发 429，见 scripts/bench_llm_extract.py）。原逐批串行，
# 改并行后 ontology_extract_ms 显著下降；上游限流更严/多文档并行时下调。
# [jonex] P10 批 2.8 限流核对：单文档调用量（22 chunk 实例）=
#   批数(8chunk/批→3) × 采样次数(2) × (1 + gleaning 轮数(2)) + 漏抽补跑(≈1-2)
#   ≈ 3×2×3 + 2 = 20 次/文档（P4 时仅 3×(1+1)=6 次）。上游 200 次/分钟
#   额度下，纯抽取可支撑 ≈10 文档/分钟；与 LightRAG 抽取/多模态共用时按
#   WORKER_COUNT 分摊，额度紧张优先降 ONTOLOGY_NATIVE_SAMPLE_RUNS=1、
#   ONTOLOGY_EXTRACT_GLEANING=1（各减 1/3），再降并发度。
# ONTOLOGY_EXTRACT_CONCURRENCY=8
# ── [jonex] P1/P2 批策略与补抽（大批判注意力稀释召回修复）──
# 每批输入 token 预算上限（估算值装箱 AND 上限；单 chunk 超预算仍单 chunk 成批）
# ONTOLOGY_EXTRACT_BATCH_BUDGET_TOKENS=24000
# ⚠️ native 抽取单次调用的**输出上限**，同时经下面那项决定批大小——两项成对调：
#   设小了会在长批次上截断 JSON → 该批解析失败 → 拆批重试（症状：调用数远高于
#   批数、completion_tokens 恰好顶到这个值）；设大了单批能装更多 chunk、批数变少。
# ONTOLOGY_EXTRACT_MAX_TOKENS=8192
# 每 chunk 输出 token 预留：每批 chunk 数 = ONTOLOGY_EXTRACT_MAX_TOKENS // 该值
# （与 BATCH_SIZE 取小；默认 1000 → 8192/1000≈8 chunk/批）
# ONTOLOGY_EXTRACT_PER_CHUNK_OUTPUT_RESERVE=1000
# 本体命中后的**裁决**环节开关与超时（kb-service 侧；关掉则跳过裁决直接用本体答案）
# ONTOLOGY_ARBITRATION_ENABLED=true
# ONTOLOGY_ARBITRATION_TIMEOUT=8
# 关系侧兜底通道：TBox 未约束但两端类型都在 TBox 内的关系，降级成通用 RELATES_TO 落图
# （原始关系名存 attributes.raw_relation_type、confidence×0.7）。默认关。
# ONTOLOGY_KEEP_UNTYPED_EDGES=false
# **每张表**的行数上限：Row-as-Object 超出部分只进向量、不进图谱。
# 表格对象**不走** ONTOLOGY_EXTRACT_MAX_ENTITIES 那条截断，这是它唯一的规模闸门。
# TABLE_OBJECT_MAX_ROWS=2000
# ⚠️ 以下三项**在代码里没有读取点**，配了不生效（历史遗留，勿照抄存量 .env）：
#   ONTOLOGY_EXTRACT_DROP_ORPHAN / ONTOLOGY_EXTRACT_MAX_ENTITIES /
#   TABLE_OBJECT_FILTER_LIGHTRAG_TABLE_ENTITIES
# ── 兜底粗类型池（native 抽取「档②」，§5.8）──
# ⚠️ 本项原只写在 deploy/.env.rag——历史原因：旧链路实体抽取由 LightRAG 自抽
#   完成，那个容器读 .env.rag。抽取已收归 native（SKIP_ENTITY_EXTRACTION=true），
#   而 native 抽取跑在 **atomic-rag 容器**，它的 env_file 是 deploy/.env，
#   **读不到 .env.rag** → 兜底池退化为 LightRAG 的 11 个英文默认类型，中文
#   语料的兜底档形同失效。故本变量必须在这里（.env.rag 侧已移除）。
# native 侧读取优先级：ONTOLOGY_NATIVE_FALLBACK_TYPES > ENTITY_TYPES（同名同义）。
# 用途：实体无法归入 TBox 领域类型时，从本池择优归类；TBox 外关系走自由关键词。
# ENTITY_TYPES='["机构","人物","人员","品牌","地点","产品","组件","软件","模型","作品","出版物","系列","版本","文档","报告","文献","概念","技术","功能","风格","标准","规格","指标","事件","活动","项目","任务","流程","渠道","场景","行业","政策","风险","法务","疾病","症状","物料"]'
# [jonex] 实体侧兜底通道：兜底粗类型实体是否入本体库。默认关。
# 关（§5.8 原设计）：兜底档只回写 LightRAG、不进 Neo4j 本体库。与 TBox 不对口的
#   语料（实测：歌词 mp3 → 落「作品/人物/概念/场景」）本体实体数为 0 属**预期**，
#   不是故障；重编译 schema 也不会改变（除非 TBox 类型本身变）。
# 开：兜底档实体入库，其关系端点同步放宽（否则实体进了库、边全丢只剩孤立节点）。
#   代价：泛化名词带通用类型标签进图谱，影响检索质量——属产品语义决策，谨慎开。
# ONTOLOGY_KEEP_FALLBACK_ENTITIES=false
# gleaning 补抽轮数：每批回传已抽实体名、只输出遗漏（[jonex] P5-var 默认 2，
# 原 1——temperature=0 非位精确，多轮逐轮累加已知名单收敛方差；0 关闭）
# ONTOLOGY_EXTRACT_GLEANING=2
# [jonex] P5-var 多次采样取并集（self-consistency）：同批同 prompt 独立采样
# 次数，各次产出按 canonical_name 取并集（实测同输入 4 次 25/27/31/36 实体）。
# 调用量 ×N，默认 2；上游额度紧张时置 1。
# ONTOLOGY_NATIVE_SAMPLE_RUNS=2
# [jonex] P10 批 2.7 漏抽 chunk 补跑：回填后仍零引用的 chunk 单 chunk 补跑
# 一轮（每缺失 chunk 一次调用，不乘采样次数）。默认 true；上游额度紧张时可关。
# ONTOLOGY_EXTRACT_MISSING_CHUNK_RERUN=true
# ── [jonex] P0 内存护栏（2026-09-13 宿主 OOM 事故）──
# 事故：financial_metric.md（17MB / usable=46290 chunk）抽取产出把宿主内存吃到
# 23.7GB，被内核 oom-killer 杀掉（容器 mem_limit=0 无上限，故是宿主 OOM 而非
# cgroup OOM）；杀在落盘前 → 磁盘上 ontology_status 恒为 extracting → 重启
# 恢复扫描判「卡住」重跑 → 「跑 4.6 小时 → 被杀 → 重跑」。三道闸如下。
# 每实体/关系 source_chunks 的**总量**上限（0 = 不限，用于灰度回滚）。
# 回填是 O(实体×chunk) 的「命中即 append」，17MB 文档实测 19647 实体 ×
# 46290 chunk，最坏产出上亿个 {"source_id","file_path"} dict，落盘 json.dumps
# 再要一份等价内存。业务上引用回溯展示几百上千个引用无意义，纯是内存负担。
# ONTOLOGY_SOURCE_CHUNKS_MAX=32
# 零引用 chunk 补跑的数量闸门：超过即整批跳过（补跑是逐 chunk 单批 LLM 调用，
# N 个缺失 = N 次调用）。收窄上面 source_chunks 配额后零引用 chunk 会变多，
# 这道闸防它把补跑量放大成调用风暴。置 0 关闭该闸门（不限制）。
# ONTOLOGY_MISSING_CHUNK_RERUN_MAX=1000
# 抽取期崩溃恢复上限：恢复扫描把 ontology_status=="extracting" 判为「卡住」
# 并重置重跑，recovery_attempts 每次 +1 并落盘；超过本值即落 FAILED，把无限
# 重跑收敛成明确失败（人工拆分文档后再提交）。默认 2 = 允许两次自动重跑。
# ONTOLOGY_RECOVERY_MAX_ATTEMPTS=2
# 零产出兜底的规模闸门（atomic-rag 侧）。Row-as-Object 确定性映射零产出时，
# 系统会对「被主抽取剔除的表格 chunk」补跑一次 native 抽取兜底。当这些表格
# chunk 逼近全文时，兜底就等价于「整篇文档全量进 LLM」——17MB 文档实测
# 46290/46290，单次 4.6 小时、产出 19647 实体 + 34522 关系，backfill 阶段
# 把宿主内存吃到 23.7GB 被杀。命中任一闸即拒绝兜底并落 failed（图一行不动，
# 避免用「表格当普通文本」的差结果全量替换首轮好结果）。
# 绝对闸：兜底 chunk 数硬上限（独立生效，真正防 OOM 的那道）。0 = 关闭该闸。
# ONTOLOGY_TABLE_FALLBACK_MAX_CHUNKS=2000
# 比例闸：兜底 chunk 占全文比例上限。**须叠加下面的规模下限才生效**。
# ONTOLOGY_TABLE_FALLBACK_MAX_RATIO=0.5
# 比例闸的规模下限：兜底 chunk 数不超过本值时不看占比。小文档「整篇都是表」
# 是常态（1 个 chunk 占 100% 也花不掉几个 LLM），无下限会把它们一并误杀。
# ONTOLOGY_TABLE_FALLBACK_RATIO_MIN_CHUNKS=200
# ── procedural 抽取子管线（P7：Skill/Action 规程抽取，M2）──
# 总开关（进程级总闸）：与「schema 含 Action」每文档条件 AND 生效。
# 默认关 = 抽取行为与改造前完全一致。灰度：先让试点 KB schema 含 Action，再开总闸。
# ONTOLOGY_PROCEDURAL_EXTRACT_ENABLED=false
# 每文档送 procedural LLM 的 chunk 上限（信号词预筛后按命中密度降序取前 N）
# ONTOLOGY_PROCEDURAL_CHUNK_MAX=30
# 每文档 Action 数量上限（超出按出现顺序截断实体与其挂接）
# ONTOLOGY_PROCEDURAL_MAX_ACTIONS=100
# 动作名长度上限（超长截断，全文进 description）
# ONTOLOGY_PROCEDURAL_NAME_MAXLEN=30
# ── 关系实体名归一化修复（stub 治理，详见 docs/ontology-relation-stub-fix-plan.md）──
# P1：写库时把关系端点按 canonical/alias 对齐到正式实体，避免捏造 stub（默认 true）
# ONTOLOGY_REL_ENDPOINT_RESOLVE=true
# P2C：对被丢弃/截断的关系端点补建 unknown 正式实体，保证两端非 stub（默认 true）
# ONTOLOGY_ENTITY_BACKFILL_ENDPOINTS=true
# 批 6 C-1：无约束关系降级落图 —— no_constraint 且两端类型都在 TBox 内的关系映射到
#   通用关系 RELATES_TO 落图（置信度 ×0.7），不再直接丢弃；实体侧对称开关是
#   ONTOLOGY_KEEP_FALLBACK_ENTITIES。⚠️ 代码默认 false、生产配 true（不配即这类关系丢弃）。
# ONTOLOGY_KEEP_UNTYPED_EDGES=true
# 本体优先检索路由阈值（BM25 ≥ 此值走本体 LLM，否则降级 RAG），默认 1.0
# ONTOLOGY_ROUTE_SCORE_MIN=1.0
# ── 本体向量语义检索（Neo4j 原生向量索引）──
# 总开关：false 时完全回退到三级字面匹配（exact/prefix/fulltext），行为与改造前一致
# ONTOLOGY_VECTOR_ENABLED=true
# 向量路由余弦阈值（qwen3-embedding:8b 中文同义/近义余弦常落在 0.75~0.85）
# ONTOLOGY_VECTOR_SCORE_MIN=0.75
# 向量近邻 topK（租户过滤前放大取；实际 = max(该值, limit*20)）
# ONTOLOGY_VECTOR_TOPK=200
# RRF 融合参数
# ONTOLOGY_RRF_K=60
# ONTOLOGY_RRF_W_FT=1.0
# ONTOLOGY_RRF_W_VEC=1.0
# ── RAG fallback 召回明细 ──
# 总开关：true 时「多 KB 只召回不生成」阶段的 detail 增加 recalls[] 轻量召回明细（含 chunk_id）
# ONTOLOGY_RAG_RECALL_DETAIL_ENABLED=true
# 召回明细最大条数（防推理链膨胀）
# ONTOLOGY_RAG_RECALL_MAX_ITEMS=20
# 单条 text 截断字数
# ONTOLOGY_RAG_RECALL_TEXT_MAX=200
# rerank client（经 llm-gateway；改这些需重启服务）
# RERANK_BINDING_HOST=http://llm-gateway:8787/v1
# RERANK_BINDING_API_KEY=gw_lightrag
# RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
# [jonex] §block-packing §10 L2：跨页打包 chunk 引用页精算（页段打分，默认开；
# false 或精算失败时回落 chunk 起点页，与改造前一致）
# RAG_REF_PAGE_SCORING_ENABLED=true
# embedding 文本 description 截断长度
# ONTOLOGY_EMBED_DESC_MAXLEN=300
# 查询 embedding TTL 缓存秒数
# ONTOLOGY_QUERY_EMBED_TTL=300
# 查询 embedding 缓存最大条目数（LRU 淘汰）
# ONTOLOGY_QUERY_EMBED_CACHE_MAX=500
# 查询 embedding 调用超时（秒）。避免 openai SDK 默认 600s 超时在上游冷启动/排队时
# 把单次 embedding 拖到十几秒，进而拖慢本体匹配（ontology_match）阶段；同时作为
# 向量分支 asyncio.wait_for 的硬上界，超时即降级「仅全文召回」，不阻塞搜索链路。
# ONTOLOGY_EMBED_TIMEOUT=5
# 查询 embedding 最大重试次数。openai SDK 默认重试 2 次会把最坏耗时放大到 timeout×3，
# 故收紧为 1；设 0 则完全不重试。
# ONTOLOGY_EMBED_MAX_RETRIES=1
# 写图（reconcile 实体/关系写入）并发度。按条写时每条 = 1 次 embedding HTTP + 1 次
# Cypher，串行 ~54ms/条（实测单文档 6961 实体 + 3793 关系写图 578s，占 e2e 57%，
# 同刻仅 ~1.3 个 embedding 请求在飞）。复用 .env.rag 已实测标定的同名键（并发甜点
# 24~32、峰值 ~85 req/s，超 32 后延迟上升）——同一上游、同一语义，不另造键。
# ⚠️ 改这里务必与 .env.rag 的 EMBEDDING_FUNC_MAX_ASYNC 保持一致。
# EMBEDDING_FUNC_MAX_ASYNC=24
# 入库侧（写图循环）embedding 单次超时（秒）。与上面查询侧的 ONTOLOGY_EMBED_TIMEOUT
# 分开：该值同时是查询向量分支 asyncio.wait_for 的硬上界，调大会让上游异常时查询多等
# 同样时长才降级；入库侧并发 24 会排队、上游冷启动要 ~30s，需要更宽的上界。
# ONTOLOGY_INGEST_EMBED_TIMEOUT=10
# 写图 Neo4j transient 错误（DeadlockDetected、锁超时等）尝试次数与退避基数（秒）。
# 写图端点已按 (entity_type, canonical_name) 字典序加锁，消除 A→B / B→A 并发
# 写入的 AB-BA 循环死锁；此项是兜底（session.run 为手动事务，driver 不自动重试）。
# ⚠️ 字典序全序**不是**零死锁的构造性保证：2026-09-16 事故中全序在位却仍撞出
# 542 次 DeadlockDetected（Row-as-Object 1992 条分组边挂同一聚合节点），故
# 4→6 次、0.2→0.5s（最坏单条约 15.5s）加大吸收能力，配合下面的关系分桶。
# ONTOLOGY_WRITE_RETRY_ATTEMPTS=6
# ONTOLOGY_WRITE_RETRY_BASE_DELAY=0.5
# 关系写图的两个参数（kb-service 侧），配套「按热点端点分桶」。
# 分桶规则：本批内某端点出现次数 >= HOT_DEGREE 即判热点，热点分量内的边**串行**
# 写、其余各自成桶并发。为什么不是「按 min 端点分桶」——分组关系的 min 取决于
# 表头列名与 LLM 类型名的字典序，group_type > object_type 时 min 恒为各不相同的
# 行对象 → 全并发失效（50/50）；也不是「纯连通分量」——知识图谱天然连通，一个
# 枢纽实体就能把整批边并进同一分量 → 全图串行。改动后看日志字段
# rel_buckets= / max_bucket=：表格文档应 max_bucket ≈ 分组边总数（热点识别生效）；
# 普通文档应 rel_buckets 大（低度边各自成桶）。普通文档若 max_bucket ≈ rels，
# 说明阈值定得过低、退化成串行 → 调大 HOT_DEGREE。
# WRITE_CONCURRENCY 只管**桶间**并发；低度边各自成桶时它就是吞吐上限。
# 另：merge_relation 全程无 embedding 调用，旧实现复用 EMBEDDING_FUNC_MAX_ASYNC=24
# 是错配（24 并发在此是零收益纯风险）。
# ONTOLOGY_REL_HOT_DEGREE=8
# ONTOLOGY_REL_WRITE_CONCURRENCY=8
# 写图**整段**尝试次数（含首跑）。单条 transient 已在上两项兜住，这里兜「整段
# 中途失败」——抽取成果花十几分钟 LLM，不该因写图 72s 的抖动整轮报废。重试开头
# 的 delete_by_document 天然清零上一轮半写；重试耗尽后再 delete 一次收回该文档
# 全部贡献（终态只允许「完整产出」或「零贡献」，不留会被检索召回的残缺图）。
# ONTOLOGY_GRAPH_REWRITE_ATTEMPTS=2
# 写图**整段**超时（秒，kb-service 侧），<=0 关闭（仅排障用）。与
# ONTOLOGY_REF_HITS_TIMEOUT_SEC 同型风险：调用方是**串行**的对账循环（本体收尾 +
# PARSING 超时巡检 + OpenKB 编译巡检），单个文档的写图不得无限占住它。超时按
# transient 处理（退避重试）；被取消（外层对账超时/关闭）时也会收回半写图——
# CancelledError 是 BaseException 子类，只 catch Exception 会让残缺图留在图里被
# 正常召回（比查不到更危险）。
# ONTOLOGY_GRAPH_WRITE_TIMEOUT_SEC=1800
# 写图失败的「同任务重写」上限（kb-service 侧）。写图失败 ≠ 抽取失败：抽取产出
# 已完整落在 rag 任务记录里（重抽要重花十几分钟 LLM），故失败时保持 EXTRACTING、
# 不动 rag_task_id，下一轮对账从**同一任务**取回 ontology_data 重写图（写图幂等：
# delete_by_document + merge）。本项只防确定性失败（如唯一约束冲突）无限重写，
# 超限才落 FAILED 交回重抽路径。
# ONTOLOGY_WRITE_RETRIES=5
# 连续 transient（锁冲突）写图失败的告警阈值（kb-service 侧）。transient 走**退避**
# 而非固定计数判死：Neo4j 对 DeadlockDetected 的官方语义就是「退避重试即可」，
# 超限才落 FAILED 并停自动重抽（避免无限退避占资源）。退避窗口 60→120→240→480→
# 960→1800(封顶，30 分钟)，窗口内该文档不再被对账重放。
# ONTOLOGY_TRANSIENT_WRITE_FAIL_LIMIT=8
# 本体抽取 _backfill_source_chunks 的事件循环让出粒度（atomic-rag 侧），按「内层
# 比对次数」计。该函数内层是 O(实体×chunk) 纯 CPU 且无 await，会整段占死事件
# 循环（实测冻结 → healthcheck 10s 超时 → 容器判死重启）。按次数计而非按实体数
# 计，使其与 chunk 数量解耦；调小 = 更可响应、吞吐略降。
# ONTOLOGY_BACKFILL_YIELD_OPS=200000
# 引用命中查询（表格对象列值 → 命中 KB 内其他实体 → 建引用边）的超时秒数
# （kb-service 侧）。该查询的 aliases 半段无法索引化（Neo4j 常规索引不支持列表
# 成员查找），最坏情况退化为「剩余候选值 × KB 节点数」的逐节点过滤——线上实测
# 3000 值 × 5 万节点满核跑 11 分钟未完成。调用方是**串行**的对账循环，一个文档
# 就能把整个对账（本体收尾 + PARSING 超时巡检 + OpenKB 编译巡检）一起卡死。
# 该项本就允许降级，超时后 = 「本轮无引用关系」（少一批增强边），写图照常继续、
# 文档正常 READY。<=0 关闭超时（仅排障用）。
# ONTOLOGY_REF_HITS_TIMEOUT_SEC=30
# 表格上下文存档目录 / 上限 / TTL（atomic-rag 侧）。full 链路把 content_list 的
# 表格子集 gzip 落盘，ontology_only 重抽读回放进 ctx.content_list——否则重抽不
# 产出 Row-as-Object 表格对象，而写图是全量替换（delete_by_document）会换掉首轮
# 表格对象。存档缺失时**拒绝重抽**（落 failed + 提示 force_reparse），不降级——
# 降级产出更差口径还会全量替换掉首轮好结果，并多烧一轮 LLM。
# ⚠️ 须落持久卷，且不要并入 _cos_cache（后者有 24h TTL 清扫）。
# 上限按**解压后**字节判定（内存保护：读回是一次性 gzip+json.loads 再展开成
# Python 对象；压缩比是文档属性、能差两个数量级，故不能按压缩后判）。gzip 只
# 负责省磁盘（实测 XBRL 财报 23.72MB → 0.57MB）。超限则不落盘 + 告警，该文档
# 日后重抽会被拒绝。TTL 兜底回收（无删除钩子），≤0 关停。
# RAG_TABLE_CTX_DIR=/app/rag_storage/_table_ctx
# RAG_TABLE_CTX_MAX_BYTES=67108864
# RAG_TABLE_CTX_TTL_SEC=7776000
# ── 本体多跳邻域召回 ──
# 邻域遍历深度（跳数），默认 1（仅直接邻居，行为与现状一致）。范围 1~ONTOLOGY_NEIGHBOR_DEPTH_MAX
# ONTOLOGY_NEIGHBOR_DEPTH=1
# 邻域遍历深度硬上限，防止配置失误导致图遍历爆炸，默认 3
# ONTOLOGY_NEIGHBOR_DEPTH_MAX=3
# 返回事实总条数上限，默认 20（与现状 limit=20 对齐）
# ONTOLOGY_NEIGHBOR_LIMIT=20
# 单跳层级中间扇出上限，遍历过程中限制每跳膨胀，默认 50
# ONTOLOGY_NEIGHBOR_PER_HOP_LIMIT=50
# 邻域查询独立超时（秒），变长多跳在稠密图上可能长时间阻塞，需独立超时保护，默认 15
# ONTOLOGY_NEIGHBOR_TIMEOUT=15
# ── 方案④：本体作答超时秒数（30 为当前基线，可按实测下调至 8~10）──
ONTOLOGY_ANSWER_TIMEOUT=30
# 方案④b：事实量预判阈值 — 邻域取到的事实数低于此值直接跳过本体作答（0=不启用）
ONTOLOGY_MIN_FACTS=0
# ── 方案②：融合宽度上限（仅对 top-N 个有效答案做融合，其余仅作引用来源）──
ONTOLOGY_RAG_FUSION_TOPN=5
# ── 方案③：多 KB 并行查询并发上限（信号量，默认 7）──
ONTOLOGY_RAG_MAX_CONCURRENCY=7
# ── P1-5 RAG 召回后处理 ──
# 送 LLM 融合前的 chunk 级重排（经 llm-gateway /v1/rerank）
# [jonex] S3（§3.3 #3）已由 false 转正：统一分的物质基础——关闭时所有语义分
#   退化为位次衰减，后续权重/阈值全建在流沙上。
RAG_PRELLM_RERANK_ENABLED=true
# [jonex] S4 起降级为「组级择优上限」——不再充当池截断值（池截断改用
#   RAG_RERANK_POOL_MAX）。改造前它同时干「挑代表」和「截池」两件事，
#   两者混在一个常量里正是 §1.8 三处截断互相打架的根源。
RAG_PRELLM_RERANK_TOPK=8

# ── [jonex] S3/S4 引用打分统一（docs/ontology/ontology-rag-scoring-unification-and-routing-plan.md）──
# 候选池兜底上限（防爆），**不是**正常裁决截断点——正常池规模下不触发。
#   同时用作 `_subject_weight_and_rank` 的组级择优上限。
#   取值须与 .env.rag 的 CHUNK_TOP_K 持平——两侧同池才能同口径混排。
# RAG_RERANK_POOL_MAX=60
#
# 统一分总开关（§3.2）。开启后候选落两个**显式** DTO 字段——`score`（统一分）
#   与 `score_kind`（rerank 真相关性 / order_decay 位次占位），并按统一分重排。
#   ⚠️ score_kind="order_decay" 表示 rerank 缺项、分数只是排序占位，
#   **全链路不得据此做阈值判定**。关闭时响应形状逐字不变（新字段为 null）。
# RAG_UNIFIED_SCORE_ENABLED=false
#
# 三阶段权重（§8-4 决策 b）：一次给齐三个会「多变量同时改、出问题无法归因」，
#   故分三步引入，每阶段独立观察、前一阶段对照数据作为后一阶段基线：
#     P1 = 1.0 / 0.0 / 0.0  纯 reranker 相关性 vs 现状位次衰减（地基，不成立后续无意义）
#     P2 = 0.8 / 0.2 / 0.0  叠加 evidence_prior
#     P3 = 0.7 / 0.2 / 0.1  叠加 subject_prior，收敛到目标配比
#   阶段切换**只改 env，代码零改动**。实机（deploy/.env）自 2026-09-18 起停在 **P2**。
# RAG_SCORE_W_RERANK=0.8
# RAG_SCORE_W_EVIDENCE=0.2
# RAG_SCORE_W_SUBJECT=0.0
#
# 证据先验口径：confidence = 改造前行为（可即时回滚）；method = 按
#   extraction_method 派生权重并叠加 rank / contrib 两个独立维度。
#   ⚠️ 真行对象判据唯一化为 `table_sig` 非空——分组聚合节点同样带
#   row_as_object 但无 table_sig；name_source 全量实体恒为 null（死判据）。
# RAG_EVIDENCE_PRIOR_MODE=confidence
#
# 统一分最低 rerank 真分覆盖率（护栏）：低于此值整池跳过重排并出 warning。
#   全池缺真分时 `order_decay`（= 池位次本身）排序与不排等价，却会写出
#   `score`/`score_kind` 让下游误以为分数有效——这条失真正是排查困难的成因。
#   实测基线 S1 关 0~29% / S1 开 70~94%，RAG 预算路径恒 100%；0.5 落在中间。
# RAG_UNIFIED_SCORE_MIN_COVERAGE=0.5
#
# ⚠️⚠️ S1 本体侧 chunk 正文批量回捞是上面 P1/P2/P3 **生效的前置条件**
#   （2026-09-15 实测，非可选优化）。关闭时：本体候选只有「缺正文的图片」
#   被回捞，文本/表格候选全空 → `_prellm_rerank_chunks` 收到 texts<=1
#   提前返回、一条都不打分 → 全池 `order_decay`，`score` 退化为池位次；
#   而池位次本就由 `_evidence_score` 排出 → `w_e` 与位次共线 →
#   **P1≡P2≡P3，统一分整条链空转**。
#   实测 4 组（关→开）：真分覆盖率 0/46→43/46、0/53→47/53、6/21→16/21、
#   9/34→24/34；`_evidence_score` 与池位次 ρ 从 -0.88/-0.96 解耦到
#   -0.61/-0.37；P1 置换 0%（空步）→ P2/P3 置换 59~85%。
# ONTOLOGY_CHUNK_TEXT_PREFETCH_ENABLED=true
# 单 doc 回捞超时（秒）；超时按无正文降级、不阻断查询。
# ONTOLOGY_CHUNK_TEXT_PREFETCH_TIMEOUT=10
# 回捞 doc 数上限 / 并发度（防一次查询扇出打爆 atomic-rag）；
#   超限按证据权重 key_order 截断并**显式记日志**，不做静默丢弃。
# ONTOLOGY_CHUNK_TEXT_PREFETCH_MAX_DOCS=32
# ONTOLOGY_CHUNK_TEXT_PREFETCH_CONCURRENCY=4
#
# 排序豁免（§3.4）：真行对象证据 chunk、procedural 步骤链证据 chunk 打
#   `_order_locked`，统一分只用于**组间**排序、组内保持产出序（行序/步序是
#   答案正确性的一部分）。无代码开关，随 RAG_UNIFIED_SCORE_ENABLED 生效。
# ── [jonex] L0 / S6 / S7 开关（2026-09-18 建；实机 2026-09-20 起全 true）──
# ⚠️ L0 与 S6 的 rerank 是两次独立调用（L0 打 chunk、S6 打实体描述）。
#    代码默认全关 —— **不显式声明即走 OFF 分支**，本机与 docker 会跑成两条链。
# 登记见 deploy/README.md「L0 / S6 / S7 变量」。
# L0 统一召回：两路 chunk 召回在**路由之前**合并 → 共用一次 rerank + 一次统一分。
#   主要价值是补齐本体侧 `_evidence_score`（合并后有值率 0→60%），让 `w_e` 有作用面。
# RAG_L0_UNIFIED_POOL_ENABLED=true
# S6 L1 判据统一量纲：rerank(实体**名**+description+attributes) 替代无量纲的 ft_score 阈值。
#   开启后每条查询在路由路径多一次 rerank。
#   ✅ 阈值 0.5 已按 §4.5 标定（2026-09-23，n=87）：分离带 [0.132, 0.775]，带内任意
#   阈值 TPR=1.00/FPR=0.00。详见 .env 的标定段与 scripts/bench/calibrate_s6_route_threshold.py。
# ONTOLOGY_ROUTE_RERANK_ENABLED=true
# ONTOLOGY_ROUTE_RERANK_MIN=0.5
# ONTOLOGY_ROUTE_DOC_MAX=800
# S7 L2 证据校验：rerank 判别器替换对侧完整 RAG 调用。高带短路(0 次 LLM)/
#   低带直采/中带原样。
# ⚠️ 2026-09-22：该「要不要跑 L2」的总开关**已删除**，L2 固定执行；T_hi/T_lo 保留可配。
# ONTOLOGY_L2_SUPPORT_T_HI=0.65
# ONTOLOGY_L2_SUPPORT_T_LO=0.15
# ONTOLOGY_L2_SUPPORT_TOPK=5
# L2 标定取数（只记日志、不参与判带）。2026-09-22 起关闭：标定已完成，
#   开着是纯成本（每条走到 L2 的查询多付 2 次 rerank）。重标时再开。
# ONTOLOGY_L2_DIAG_ENABLED=false
# S6 extraction_method 硬门（**默认 true**，2026-09-18 实测后定）
#   依据：本地 14,366 实体里 Cypher 放行而本门会剔的只有 1 条 → 无代价的纵深防御。
#   回滚：置 false 回到「Cypher 单层过滤」。
# ONTOLOGY_ROUTE_METHOD_GATE_ENABLED=true
# [jonex] S1b 行级证据 join：**须重抽存量行对象才生效**（存量 102,762 个行对象的
#   source_chunks 只有行锚点、无 file_path），且开了不回滚——与重抽一起排期。
# ONTOLOGY_ROW_EVIDENCE_ENABLED=true
# ── [jonex] 批次4 检索侧开关（knowledge-base-service 读取；勿写进 .env.rag）──
# 依据 docs/table-parsing-retrieval-governance-plan.md（Row-as-Object × 低质过滤 × 双路配额 × 双向裁决）。
# S8 chunk 级低质过滤（残缺 HTML / 英文摘要 / col_ 失效 / 空壳）：插在 doc 聚合之前
#   ——先剔垃圾再聚合。代码默认 true。
# RAG_LOWQ_CHUNK_FILTER_ENABLED=true
# L4.2 双路召回配额（row : summary ≈ 3 : 1）：表格明细行与摘要各按配额召回，防连贯摘要
#   抢占全部候选（T4）。依赖 ctype 存量数据（reparse 后生效；无 ctype 的存量 chunk 不参与）。
# RAG_DUAL_PATH_QUOTA_ENABLED=true
# S1+S7 双向校验与裁决：总开关 + 裁决超时（秒）。超时**回退原答案**——本体是已有结果，
#   回退成本为 0。代码默认 true / 8。
# ONTOLOGY_ARBITRATION_ENABLED=true
# ONTOLOGY_ARBITRATION_TIMEOUT=8

# ── §image-refs P4：图片引用配额（docs/image-reference-accuracy-fix-plan.md 方案 A）──
# RAG_IMAGE_REF_SCORE_MIN：图片 location 分数阈值，低于此值直接丢弃。
#   作用域：E3 未跑/失败时的语义来源候选（分数链 final_score > relevance >
#   group_final_score > _order_score，LightRAG 检索相关性）。
#   2026-08 以真实文档（岭南画派-10p，62 图）× 6 条真实查询实测，rerank 分
#   二值化——真相关 ≥0.74、弱相关 ≤0.03。0.7 取真相关带下沿。
#   rerank 关闭时分数退化为位置衰减分（0~1），阈值会误伤后半段候选，
#   该场景应设 0。设 0 关闭过滤（总开关：E3 后的结构分阈值也不得绕过）。
# RAG_IMAGE_REF_MAX：通过阈值后每个文档保留的图片 location 上限。
#   默认 6；设 999 等同关闭配额上限
# RAG_IMAGE_REF_SCORE_MIN_STRUCTURAL：E3 rerank 跑出真实语义分后，所有图片
#   候选（无论语义/结构来源）的统一阈值——E3 分是「图片描述×query」相关性，
#   系统性低于文本语义分。四屏实测：相关带 ≥0.69、噪声带 ≤0.22，0.5 留
#   双侧余量；0.7 会压线误杀 0.6915 的合法四屏（本体/RAG 两路径同批图
#   同分，两路径阈值必须一致）。E3 未跑/失败时结构分候选豁免此阈值。
#   默认 0.5；设 0 = 关闭结构分阈值（回退纯豁免）。
#   详见 docs/document-reference/four-panel-image-dual-path-rootcause-and-fix-plan.md §1
#
#   ⚠️ [jonex] S4（方案 §3.3 #5 ①「双阈值收敛为一个」）：**统一分口径下上面
#   这套双阈值双轨消失**——候选自带的 `score_kind` 就是唯一判据，阈值收敛为
#   一个 RAG_IMAGE_REF_SCORE_MIN_STRUCTURAL。因为此时所有图片分都来自
#   `rerank(图片描述 × query)`（E3 与主池 rerank 同模型同函数），0.5 切在
#   实测相关带 ≥0.69 / 噪声带 ≤0.22 之间；0.7 标定在另一条量纲上，正是当年
#   把 0.6915 同批真相关图整批误杀的值。
#   判据比旧的 `_score_source` 标签更准：旧判据要同时排除四个分数键，漏一个
#   就把「无真分」误判成「语义来源」，于是拿非语义量纲的数去比语义阈值。
#   RAG_IMAGE_REF_SCORE_MIN 在统一分路径下退役（S9 清理），但**总开关语义保留**
#   （设 0 关闭过滤，统一分口径下同样不得绕过）。
#   旧口径（统一分关闭）双轨逐字保留，作回滚通路。
# RAG_IMAGE_REF_SCORE_MIN=0.7
# RAG_IMAGE_REF_SCORE_MIN_STRUCTURAL=0.5
# RAG_IMAGE_REF_MAX=6
# ── [jonex] 2026-09-23：引用裁剪（两个独立开关，可叠加）──
# ONTOLOGY_REF_MIN_RELEVANCE：按**相关性**裁（「与问题无关的别列」）。
#   `_build_references` 前按**裸 relevance** 裁掉低相关候选；答案 `[ref_i]`
#   引用到的 doc 有白名单兜底、不会被裁（裁了会丢答案里的引用标）。
#   ⚠️ 默认 0.0 = 关闭；线上灰度配 0.5（标定在「chunk 正文 × query」量纲上）。
#   ⚠️ 与 RAG_IMAGE_REF_SCORE_MIN_STRUCTURAL 值同为 0.5 但量纲不同，勿合并。
# ONTOLOGY_REF_MIN_RELEVANCE=0.5
# RAG_REF_CITED_ONLY_ENABLED：按**答案引用标**滤（「答案没用到的别列」）——
#   只保留答案 `[ref_i]` 引用到的 doc。本体 + RAG 两路都生效（名字带 `RAG_`
#   是沿 RAG_L0_UNIFIED_POOL_ENABLED 的惯例，非 RAG 专属）。
#   ⚠️ 过滤必须排在 `normalize_citations` **之前**：先滤后归一，`[ref_i]` 自动
#   落到新下标、**不改写答案**；顺序倒置会把 `[n]` 全部打乱。挪代码前先看
#   `search_service.py` 的注释。无引用标 / 全滤光 → 全留。
#   ⚠️ 默认 false = 关闭；线上灰度配 true。
# RAG_REF_CITED_ONLY_ENABLED=true
# 主体一致性信号总开关（方案 B 语义：软加权，永不删除候选）
# ⚠️ 旧实现为白名单硬剔除，全部不中时会清空 references
#   （见 docs/rag-subject-filter-and-answer-source-remediation-plan.md §4/§5）。
RAG_SUBJECT_FILTER_ENABLED=true
# 主体分权重 λ：final = (1-λ)×rerank 相关性 + λ×主体分（仅主体信号开启时生效）
RAG_SUBJECT_WEIGHT=0.25
# ── 平台取回答作权（LightRAG 降为 retriever，答案收归平台侧）──
# 2026-09-22 起为唯一路径（原灰度开关已删除）：only_need_context 只召回
# + 平台 answer_from_chunks 一次作答（答案与引用同源）。
# 原「失败回退旧链路」语义已作废 —— 失败现抛 ServiceUnavailableError。
# 送 answer_from_chunks 的 chunk 文本总长上限（字符，硬截）
RAG_ANSWER_MAX_CONTEXT_CHARS=12000
# ── Embedding 出口（kb-service 与 lightrag 共享，单一真相源；必须与 .env.rag 一致）──
# ⚠️ 首篇文档处理后不可再更改；kb-service 用此建 Neo4j 向量索引 + 算 embedding hash
EMBEDDING_DIM=1024
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_BINDING_HOST=http://llm-gateway:8787/v1
# 本体 embedding 是否向上游发送 dimensions（与 LightRAG 对齐，收敛到 EMBEDDING_DIM）。
# ⚠️ 灰度：首次部署保持 false（仅靠 kb-service 客户端截断兜底，零静默失败风险）；
#    用直连 ollama 确认支持 dimensions 后再改 true 把截断下沉到上游。
#    详见 docs/ontology-vector-embedding-dim-mismatch-fix-plan.md §5.2 / §7.0。
EMBEDDING_SEND_DIM=false
EMBEDDING_BINDING_API_KEY=gw_lightrag
# Rerank 客户端发给 llm-gateway 的内部令牌。
# ⚠️ 必须与上方 LLMGW_INTERNAL_TOKENS 白名单里的某一项**逐字一致**，否则 rerank 一律 401。
#    （此前本键只存在于 deploy/.env 与各 profile env 文件里、靠 rerank.py 的代码默认值
#     `gw_lightrag` 兜底；模板缺它会导致「轮换 LLMGW_INTERNAL_TOKENS 时漏改本键」。）
RERANK_BINDING_API_KEY=gw_lightrag
# ── §9 严格模式（总闸，false 时忽略请求 strict_mode）──
STRICT_MODE_ENABLED=true
# 两档结构（快档 / 精档）；原 3 档同配置无梯度，见方案 §2.6
STRICT_MAX_ATTEMPTS_CAP=2
# ── [jonex] 对侧 RAG 校验整体超时（秒）；超时按「对侧无结果」保留本体原答案 ──
# 仅对精档生效（快档由 gear.cross_verify=False 跳过对侧）。
# 取值由精档超时台账反推，见方案 §3.4：15+60+20+8+5=108 < 精档 timeout 120。
ONTOLOGY_CROSS_RAG_TIMEOUT=20
STRICT_MIN_SCORE=0.8
STRICT_ATTEMPT_TIMEOUT=60
STRICT_TOTAL_BUDGET=150
STRICT_WEIGHT_NON_REFUSAL=0.35
STRICT_WEIGHT_REFERENCE=0.15
STRICT_WEIGHT_GROUNDED=0.30
STRICT_WEIGHT_CONSISTENCY=0.20
# ── P2-7 作答常识放宽配置 ──
ONTOLOGY_ANSWER_ALLOW_COMMON_SENSE=true
# ── §10 深度查询配置 ──
DEEP_QUERY_ENABLED=true
DEEP_MAX_SUBQUERIES=6
DEEP_SUBQUERY_CONCURRENCY=5
DEEP_TOTAL_BUDGET=180
# 编排推理链总闸（默认开；前端再用 with_reasoning 按请求控制）
# REASONING_TRACE_ENABLED=true
# 本体问答 / RAG 融合回答的 LLM 出口（ontology_llm.py、ontology_extractor.py 读取）
# 经服务器 llm-gateway；api_key 用网关内部 token（见 LLMGW_INTERNAL_TOKENS），
# 不可留空——openai SDK 见空 key 会抛 "Missing credentials"。
ONTOLOGY_LLM_BINDING_HOST=http://llm-gateway:8787/v1
ONTOLOGY_LLM_BINDING_API_KEY=gw_lightrag
ONTOLOGY_LLM_MODEL=deepseek/deepseek-flash

# 本体模板编译
# ONTOLOGY_AUTO_COMPILE=true
# ONTOLOGY_COMPILED_SCHEMA_TTL=3600
# ONTOLOGY_SCHEMA_FALLBACK_PATH=deploy/config/ontology/default.yaml
# 模板源（business_domain / yaml_default），默认 business_domain
# ONTOLOGY_TEMPLATE_SOURCE=business_domain

# ============================================================
# 12. RAG / LightRAG 对接（atomic-rag → lightrag-server）
# ============================================================
# atomic-rag 调用 lightrag-server 的 API 密钥
# 必须与 .env.rag 中的 LIGHTRAG_API_KEY 保持一致
LIGHTRAG_API_KEY=change-me-in-production-please
# 文档入库完成后回调 business 层，不配置则静默跳过
RAG_WEBHOOK_URL=
# RAG 检索客户端最小查询长度阈值（必须 >= 3，LightRAG server 硬约束）
# RAG_MIN_QUERY_LEN=3
# v2 入库轮询总超时（秒）——[jonex] §13.4 起此值为**动态缩放的下限(floor)**：
# 实际窗口 = clamp(本值, RAG_TRACK_SCALE_PER_CHUNK_SEC×chunk数, RAG_TRACK_SCALE_CEIL_SEC)，
# 大文档由 RAG_TRACK_SCALE_* 动态放大，本值仅保证小文档不会低于此。须 ≥ per-chunk。
# RAG_TRACK_TIMEOUT_SECONDS=1800
# v2 单 chunk 独立超时窗口（秒）——同为**动态缩放的下限**，小文档保底、大文档按量放大。
# RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS=900
# v2 超时 chunk 重推最大次数（仅 PushChunksStage，恢复路径不重推）
# RAG_TRACK_PER_CHUNK_MAX_RETRIES=2
# v2 轮询并发度，限制同时查询 track_status 的并发数
# RAG_TRACK_POLL_CONCURRENCY=8
# [jonex] §13.4 item1：超时窗口按 chunk 数动态下限（floor，仅放大不缩小）。
# 有效窗口 = clamp(上面两个 base, SCALE×chunk数, CEIL)；超大文档长尾不再被固定值误判超时。
# SCALE=0 关闭（回退固定值）；CEIL 绝对上限（< HARD 6h）。默认 2 / 10800(3h)。
# RAG_TRACK_SCALE_PER_CHUNK_SEC=2
# RAG_TRACK_SCALE_CEIL_SEC=10800
# 文档级并发：atomic-rag TaskManager 同时处理的文档数（后台 worker 协程数），改后需重建 atomic-rag 镜像。
# WORKER_COUNT=4
# 任务队列容量（总槽位 = WORKER_COUNT + 此值；满时入库请求返回 429）。
# TASK_QUEUE_CAPACITY=100
# 单文档内多模态描述 LLM 并发（scene=raganything_ingest：表格/公式/音频等 LLM 快任务，单次约 2~3s），
# 改后需重建 atomic-rag 镜像。HTTP 入库模式原硬编码为 2；实际并发 ≈ WORKER_COUNT × 此值。
# 上游限 200 次/分钟且与 lightrag_extract(MAX_ASYNC)/ontology_extract 共用额度；安全并发约 7~10。
# 注意：图片（VLM）不在此列——由下方 MAX_PARALLEL_VLM 独立限流。默认 4。
# MAX_PARALLEL_MULTIMODAL=4
# 单文档内图片/视频关键帧 VLM 并发（直连远端 VLM，不经 llm-gateway；thinking 模型单次 4~105s），
# 改后需重建 atomic-rag 镜像。远端槽位有限，并发过高会排队超过 VLM 超时（RAG_VLM_TIMEOUT）
# 触发 ReadTimeout 重试风暴。实际并发 ≈ WORKER_COUNT × 此值。默认 2。
# MAX_PARALLEL_VLM=2
# 单次 VLM 调用超时（秒）：驱动默认 120s 对 thinking 模型太紧，提到 300s 给长思考留余量。
# RAG_VLM_TIMEOUT=300
# 单次 VLM 输出 max_tokens 上限（0=不限制）。低量化 thinking 模型描述冗长时可设 300
# 起灰度；过小会截断 JSON 导致解析重试失败。默认 0（关）。
# RAG_VLM_MAX_TOKENS=300
# VLM 思考深度（none/low/medium/high）：默认 none 关闭思考。实测思考开启时单图 4~105s、
# 约 1.2 万完成 token 且低量化下易带幻觉；关闭后约 3s/160 token，描述更贴合图片。
# RAG_VLM_REASONING_EFFORT=none

# ── 知识库对账/超时巡检（knowledge-base-service 的 patrol_parsing_timeout；纯后端，改后无需重建镜像）──
# 软超时（秒）：PARSING/INGESTING 文档超过此时长后，对账开始探活；任务仍在处理/排队则继续等待，绝不无脑重推
# RAG_TASK_SOFT_TIMEOUT_SEC=3600
# 硬超时（秒，默认 6h）：超过即使任务仍在处理也判死置 FAILED 并打 ERROR 告警；大批量入库长期堆积时可调大
# RAG_TASK_HARD_TIMEOUT_SEC=21600
# 探测失败容忍次数：get_task_status 连续失败达此次数才判任务已死，避免瞬时网络抖动误杀在途任务
# RAG_TASK_PROBE_FAIL_MAX=3

# ── [jonex] Ontology 库接入任务中心（knowledge-base-service；纯后端，改后重启 knowledge-base 生效）──
# 入库链选择 —— ⚠️ 它**不是**「进不进任务中心」：Ontology 库（kb_type=lightrag）一律进。
# 另两类 llm-wiki 库不受它管辖（`ingest_backend.resolve_backend` 里被写死回落 rag），
# 本地存储（非 cos/s3）同理。当前注册的后端只有 `rag` 一条：
#   rag（默认）      → definition-file-processing-ontology
#                      atomic-rag prepare_only → push_only → ontology_only
# 取值在**提交那一刻**定死、写进文档行（extra_metadata.ingest_backend），事后翻转不影响在途文档；
# 合法值之外的值会让上传响亮失败（IngestBackendConfigError）。详见 deploy/README.md 的灰度一节。
# [2026-10-09] 库级派单值**优先于本开关**：KB 行 knowledge_base.knowledge_info.ingest_backend
# 非 NULL 即覆盖本开关，NULL = 跟随本开关（存量库全是 NULL）。
# 走 KB 更新接口改，不重启；只影响下一次提交。建列脚本 update/045_knowledge_info_ingest_backend.sql。
# KB_INGEST_BACKEND=rag

# ── [jonex] compile 步（本体编译）后端开关（knowledge-base-service；改后重启 knowledge-base 生效）──
# 「本体编译独立容器」的**灰度开关**，只管 compile 步（本体抽取），与上面的
# KB_INGEST_BACKEND（解析链）是**两把钥匙、两个语义**，不要互相替换：
#   ontology_compile（默认，P4a 2026-10-17 起）→ 独立编译服务（容器 ontology-compile:8009，
#                        能力 ID atomic.ontology_compile.v1，Sidecar 路由键 ontology_compile）
#   rag               → atomic-rag 的 ontology_only（**显式回退**；
#                        回滚 = 本开关设 rag + 重启 knowledge-base，无需改代码）
# 与 KB_INGEST_BACKEND 同款纪律：**提交时读、写进文档行**
# （extra_metadata.ontology_compile_backend，与 rag_task_id 同一次 commit），
# 事后翻转不影响在途文档；合法值之外的值会让 compile 提交响亮失败（CompileBackendConfigError）。
# [2026-10-17] 库级派单值**优先于本开关**：KB 行
# knowledge_base.knowledge_info.ontology_compile_backend 非 NULL 即覆盖，NULL = 跟随本开关
# （存量库全是 NULL ⇒ 未设库值即默认走新服务）；本期库级值只有列（无 API），改列后只影响下一次提交。
# ⚠ 查询侧兜底**仍是 rag**（老文档没有粘性键、确实跑在 atomic-rag）—— 与提交默认刻意分开。
# 建列脚本 update/057_knowledge_info_ontology_compile_backend.sql。
# ONTOLOGY_COMPILE_BACKEND=ontology_compile

# ── [jonex] 可创建的知识库类型（knowledge-base-service；改后重启 knowledge-base 生效）──
# 部署级白名单：控制「新建知识库」弹窗展示哪些类型，以及哪些类型**能被创建**。
# ⚠ 只管**创建**：被禁类型的**存量库照常出现在列表里、照常可读可检索可上传**。
# ⚠ 未设置或留空 = 三种全开（升级零影响）。取值非法（最典型：把 jonex_wiki 写成
#    jonex-wiki）会让 knowledge-base-service **启动失败** —— 故意做成响亮的，否则
#    表现是「客户现场少显示一个选项」而没人知道为什么。
# 取值（逗号分隔，可只给子集；顺序由代码固定，不受这里写法影响）：
#   lightrag     页面上叫「Ontology」      向量检索 + 知识图谱，片段级引用溯源
#   openkb       页面上叫「Ontology Wiki」 LLM 编译成结构化 wiki
#   jonex_wiki   页面上叫「Jonex Wiki」    新一代 LLM Wiki 引擎
# 例：只留 Ontology 与 Jonex Wiki，藏掉 Ontology Wiki
# KB_ENABLED_TYPES=lightrag,jonex_wiki
# 看门狗（30 秒一轮，挂在对账循环尾部）的六道阈值，单位均为秒：
# 提交补交间隔：上传那次 submit 失败后再补一次的最小间隔（submit 自带 3 次重试 0.5s/1s）。
# TC_SUBMIT_RETRY_SEC=30
# 补交次数上限：到顶就不试了（再试也是同一个错）。
# TC_SUBMIT_MAX_ATTEMPTS=10
# 补交窗口：从接管行建立算起，超了判死并交还给既有对账。
# TC_SUBMIT_DEADLINE_SEC=1800
# 派活延迟上限：任务已提交、任务中心却一直不派活（正常几秒内就到）。
# TC_NO_DISPATCH_SEC=1800
# 下游投递上限：收了派活却没把下游任务号写回来（正常只有一次 HTTP 调用的宽度）。
# TC_NO_DOWNSTREAM_SEC=600
# 单步硬超时：**必须小于编排里的 timeout_seconds（25200）**，让掌握真相的这一方先判死。
# TC_STEP_HARD_TIMEOUT_SEC=21600

# ============================================================
# 13. MinerU 解析器
# ------------------------------------------------------------
# RAG_PARSER 三选一（本变量是**硬覆盖**：优先级高于 per-KB preset 与请求级配置，
# 改这里即可全局切换；三种解析器的实现说明见 Reference/Rag-anything/JONEX_CHANGES.md）：
#   · mineru          本地 MinerU CLI（进程内跑模型，无需外部服务；full 镜像自带依赖与模型）
#   · mineru_online   mineru.net 云端 API（需 MINERU_API_TOKEN + 外网）
#   · mineru_selfhost 自建 mineru-api 服务（HTTP 客户端，需可达端点，见下方 (B) 段）
# ⚠️ 默认 mineru_selfhost 要求一个真实可达的 mineru-api 服务；新环境若无此服务：
#    可启用仓库内置的可选服务（docker compose --profile mineru up -d mineru-api，
#    镜像构建与接线见 deploy/README.md「文档解析服务 MinerU（可选）」），
#    或改用 mineru（开箱可跑）/ mineru_online。典型故障：解析报
#    "MinerU self-host request failed: POST /tasks: Connection refused" 即端点不可达，
#    排查与处置见 deploy/README.md「故障排查」。
# ============================================================
RAG_PARSER=mineru_selfhost

# 【打包变量】RAG_PROFILE：atomic-rag 镜像依赖胖瘦，仅构建 atomic-rag 镜像时生效（非运行时）。
#   full（默认）：全量依赖，三种 RAG_PARSER 都能真跑（含本地 mineru，镜像大 ~含 torch/CUDA）。
#   slim        ：仅 online/selfhost，去 torch/CUDA/mineru，省 ~3.9GB（本地 mineru 不可用）。
# RAG_PROFILE=full

# [jonex] #4 v2 解析瞬时错误重试（所有 parser 生效，替换旧 MINERU_PARSE_*）
# RAG_PARSE_RETRY_MAX=3             # 含首次重试次数（默认 3）
# RAG_PARSE_RETRY_BASE_SEC=2.0      # [jonex] #4 v2 指数退避基数（秒，默认 2.0）
# RAG_REQUIRE_DOC_IDS=true          # [jonex] #6 严格逐 chunk 确认 doc_id（默认 true）

# ── [jonex] 表格解析与切块治理（docs/table-parsing-retrieval-governance-plan.md §5/§9.2）──
# 注意：这些变量由 atomic-rag（raganything）进程读取（env_file=.env），不要放进 .env.rag*。
# RAG_TABLE_GRID_V2=true            # 表格网格化+表头推断总开关（L1/L2，默认 true；false 回退旧 normalize_table_rows）
# TABLE_HEADER_MAX_LEN=40           # 表头长文本剔除阈值（字符）：超过或含句末符 → 判为表前说明写入 notes
# TABLE_HEADER_LONG_CELL_RATIO=0.5  # [jonex] P0-c 超长格占比阈值：一行的超长格(>24 字符)占比超过它才否决整行表头判定
#                                   # 事故背景见 deploy/README.md（25 字符列名击穿 24 阈值 → 21 列真表头被判非表头）
#                                   # 0 = 回到「任一格超长即否决」的旧口径（回滚用）；1 = 几乎不否决（不推荐）
# RAG_TABLE_CHUNK_MAX_CHARS=900     # 表格专用切块预算（字符，O1）：仅表格分支生效，文本链路仍用 RAG_CHUNK_MAX_CHARS
#                                   # 校准：scripts/calibrate_table_chunk_budget.py
# TABLE_OBJECT_MAX_ROWS=2000        # Row-as-Object 行对象抽取的单表行数上限（默认 2000）：data_rows/row_map 按此截断，超出不建行对象
# RAG_LIGHTRAG_CHUNK_SIZE=1200      # 表格 chunk 超限断言阈值（token）：须与 .env.rag 的 CHUNK_SIZE 一致
# XLSX_NATIVE_NORMALIZE=true        # xlsx 双路合并（L3）：openpyxl 表格主轨 + MinerU 图片轨；false 全量交 MinerU
# RAG_PROMPT_LANG=zh                # 解析/摘要 prompt 语言（L4.2）：zh 中文模板 / en 英文；进程级全局，默认 zh

# ── [jonex] §block-packing 文本块级打包（docs/text-block-packing-chunk-governance-plan.md §3）──
# 同样由 atomic-rag（raganything）进程读取（与表格链路参数同段，勿写进 .env.rag）
# RAG_TEXT_BLOCK_PACKING=true       # 总开关（默认 true；false 完全回退逐块 1:1，产出与改造前逐字节一致）
# RAG_TEXT_PACK_CHARS=1260          # 字符预算主控（= 900 token × 1.4 系数固化，见计划 §3.1）
# RAG_TEXT_PACK_MAX_TOKENS=1200     # 硬上限断言（token）：超限 WARNING + 切分 + 计 oversize_text_chunks；须与 .env.rag CHUNK_SIZE 一致
# RAG_TEXT_PACK_HEADING_MAX_LEN=40  # heading-like 判定长度上限（字符，C5 判据）；编号模式（C4）不受此限制
# RAG_TEXT_PACK_DROP_NOISE=true     # 噪声丢弃（C2/C3）；false=零信息损失模式（噪声按正文吸附进包）

# ── [jonex] §image-refs 图片资产上传（docs/image-reference-chain-execution-plan.md P1-4）──
# 同样由 atomic-rag（raganything）进程读取（勿写进 .env.rag）；false 只停
# 资产上传与 aext 旁路（检索侧图片引用无 asset_url），不阻塞主链路
# RAG_ASSET_UPLOAD_ENABLED=true     # 图片资产上传总开关（默认 true）

# ── [jonex] §image-refs 图片版面主题锚点（docs/image-reference-accuracy-fix-plan.md E 方案 P0-6）──
# 入库侧从 MinerU content_list 确定性提取版面主题（图注→x 重叠列下方图注→
# 本页标题），拼在 VLM 描述之前：图片描述：【版面主题：xxx】{VLM 描述}。
# 锚点来源写入 file_source 旁路 anchor_src=cap|foot|col|heading。false 回退旧行为。
# RAG_IMAGE_ANCHOR_ENABLED=true     # 锚点总开关（默认 true）

# ── [jonex] reparse 补偿 cleanup 收敛循环（docs/rag-reparse-strict-cleanup-busy-plan.md）──
# RAG_PUSH_RETRY_TERMINAL_FAILED=true   # 1-A(atomic-rag)：track 终态 failed 的 chunk 纳入有界重推（默认 true；false 回退旧行为）
# RAG_CLEANUP_MAX_ELAPSED=1800          # P0(atomic-rag)：_converge_delete 收敛循环最长运行时间（秒，默认 1800）
# RAG_CLEANUP_POLL_DELAY=5              # P0(atomic-rag)：收敛循环每轮 poll 间隔（秒，默认 5）
# RAG_CLEANUP_POLL_PER_DOC_SEC=2        # P0(atomic-rag)：deadline 随删除量缩放 per-doc 秒数（默认 2）
# RECONCILE_CLEANUP_BASE_SEC=600        # 3-A(kb-service)：cleanup 卡死动态超时基数（秒，默认 600）
# RECONCILE_CLEANUP_PER_DOC_SEC=15      # 3-A(kb-service)：每待删 doc 追加秒数（默认 15）→ 超时=min(CEIL, BASE+PER_DOC×待删总量)
# RECONCILE_CLEANUP_CEIL_SEC=21600      # 3-A(kb-service)：动态超时上限（秒，默认 6h）；超时把文档置 FAILED
# RECONCILE_SUBMIT_GRACE_SEC=180       # R2-a(kb-service)：提交宽限期（秒），task_id 为空且锚点在此窗口内不判死（默认 180）
# RECONCILE_IDEMPOTENCY_LOOKUP_ENABLED=true # R2-b(kb-service)：幂等键反查开关，false 回退到仅 a+c 查证
# RAG_COS_FETCH_IN_TASK=true           # R7-2b(atomic-rag)：COS 下载异步化开关（true=任务 pipeline 内下载；false=同步路径回退）

# ---- (A) 本地 mineru CLI 用 ----
# 模型下载源：modelscope=国内直连免代理；huggingface=需外网/代理。
# 注意：MinerU 认此环境变量切源，CLI --source 对 VLM 后端不生效。仅 RAG_PARSER=mineru 时生效。
MINERU_MODEL_SOURCE=modelscope

# ---- (B) mineru_selfhost：自建 mineru-api 服务（/health + /tasks）----
# ⚠️ 必须指向一个真实可达的 mineru-api（官方 MinerU 或兼容 fork）。两种常见连不上：
#   · 根本没有该服务 —— 仓库含可选 mineru-api 服务但默认不启动，可先起再改本值：
#     docker compose --profile mineru up -d mineru-api → MINERU_SELFHOST_BASE_URL=http://mineru-api:8000
#     （镜像构建见 deploy/README.md「文档解析服务 MinerU（可选）」）；不用就改 RAG_PARSER=mineru
#   · 把 127.0.0.1 当成宿主机 —— 容器里的 127.0.0.1 是容器自身；宿主机上的服务要写
#     宿主机 IP（除非服务与 atomic-rag 同机且走 host 网络，才可用 127.0.0.1:端口）
# 不要把本行注掉/留空：留空会回落到容器自身的 127.0.0.1:8000（必连不上），
# 且视频端点 MINERU_VIDEO_BASE_URL 未单独设置时会静默回落到本变量。
MINERU_SELFHOST_BASE_URL=http://127.0.0.1:20490
# 内置可选 mineru-api 服务（compose profile: mineru）使用的镜像名。官方不发布预构建
# 镜像，需按官方 Dockerfile 自建，或从别处 docker save/load 复用（见 deploy/README.md）。
MINERU_IMAGE=mineru:latest
# MINERU_SELFHOST_BACKEND=pipeline        # 或 hybrid-engine（VLM 高精度、较慢）
# MINERU_SELFHOST_LANG=ch
# MINERU_SELFHOST_POLL_INTERVAL=5
# MINERU_SELFHOST_POLL_TIMEOUT=1800
# MINERU_SELFHOST_RETURN_IMAGES=false     # 需要图片模态时置 true

# ---- (C) mineru_online：mineru.net 云 API ----
# MINERU_API_TOKEN=your_token_here
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_MODEL_VERSION=vlm
# MINERU_POLL_INTERVAL=5
# MINERU_POLL_TIMEOUT=1800

# ============================================================
# 14. 对象存储（local 本地文件系统 / cos 腾讯云 COS / S3）
# ============================================================
OBJECT_STORAGE_BACKEND=local
# 仅 OBJECT_STORAGE_BACKEND=cos 时需要配置以下项：
COS_KEY_PREFIX=jonex
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=jonex-kb-1250000000
# COS_PRESIGN_EXPIRES=900

# S3 兼容（AWS S3 / MinIO / 国内云 S3 兼容端点），改 OBJECT_STORAGE_BACKEND=s3 后生效。
# MinIO 需 S3_ENDPOINT_URL 指向 MinIO；AWS S3 不填 endpoint。
# S3_ADDRESSING_STYLE 留空或 auto 即自动推导（有 endpoint→path，无 endpoint→virtual），
# 一般无需显式设置。注意不要指望 botocore 的 auto：它在无 endpoint 时会签出
# <bucket>.s3.amazonaws.com（丢 region）而签名带真实 region，AWS 侧一律 403。
# S3_REGION 直连 AWS S3 时必填（决定 endpoint 主机名，填错会 403）；
# MinIO 等自建端点无多区域概念，可省略，默认 us-east-1（与 MinIO 缺省站点 region 一致，
# 除非服务端配了 MINIO_SITE_REGION，那就填成一样的值）。
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_BUCKET=your-s3-bucket-name
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ADDRESSING_STYLE=auto
# S3_PRESIGN_EXPIRES=900

# 注：S3 后端复用 COS_KEY_PREFIX 作为对象键前缀（未单独设 S3_KEY_PREFIX）。

# --- 前端 CSP 的存储来源 ---------------------------------------------------
# 图片与音视频预览走 302 直跳对象存储（Range 流式最优），浏览器会校验 CSP 的
# img-src / media-src；PDF/文本/Markdown 走网关同源代理，不受此项影响。
# 不设时按 OBJECT_STORAGE_BACKEND 取默认值，所以 cos 和 local 后端无需配置：
#   cos   → 自动用 https://*.myqcloud.com
#   local → 自动留空（local 不产生预签名 URL，原文从共享卷同源返回）
#   s3    → 无法推导（host 随 region / 自建域变化），必须显式配置，否则容器启动时会告警
# 填 scheme://host，不含路径。按实际预签名 URL 的主机名来定：
#   AWS S3（virtual-hosted，bucket 占一级子域，未设 S3_ENDPOINT_URL 时的默认形式）：
#     CSP_STORAGE_ORIGIN=https://*.s3.ap-northeast-1.amazonaws.com
#   AWS S3（path-style）： CSP_STORAGE_ORIGIN=https://s3.ap-northeast-1.amazonaws.com
#   MinIO 等自建端点：    CSP_STORAGE_ORIGIN=https://minio.example.com
# 不确定主机名时，预览一次文档，看 gateway 日志的「原文预览: ... upstream=」字段。
# CSP_STORAGE_ORIGIN=

# ============================================================
# 15. 数据源接入（API 接入 / 文件存储直连 / API 开放推送）
# ============================================================
# 凭据加密密钥（base64 urlsafe 32 字节；生成：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 生产必填；不配时开发态从 JWT_SECRET 派生。
DATA_SOURCE_SECRET_KEY=
# 生成 api_push 入站推送 URL 用
PUBLIC_API_BASE=http://localhost

# ── 出站网段管控（SSRF 防护，2026-10 渗透测试 P2）──────────────────────────
# KB 数据源「API 拉取 / 存储直连」的出站地址**默认拒绝**私网/保留网段
# （127.0.0.0/8、10/8、172.16/12、192.168/16、169.254/16、::1、fc00::/7 等），
# 违规抛 InvalidTargetUrlError(1007)。这是**安全默认**。
# 若确有内网数据源需要拉取（如内网 MinIO / 内网业务 API），把其**主机名**逐条加进
# 下面的白名单（逗号分隔，逃生阀，最小化授权）；留空 = 一律不允许私网出站。
#   例：KB_INGESTION_ALLOWED_HOSTS=minio.internal.corp,api.intra.example.com
# 注意：白名单按主机名精确匹配，不按网段放行；请勿填 IP 段或通配符。
KB_INGESTION_ALLOWED_HOSTS=

# ============================================================
# 16. 审计日志（所有容器共享，非 platform 容器通过 AUDIT_INGEST_URL 转发）
# ============================================================
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_ASYNC=true
# AUDIT_QUEUE_MAX_SIZE=10000
# AUDIT_FLUSH_BATCH_SIZE=100
# AUDIT_FLUSH_INTERVAL_MS=200
# AUDIT_RETENTION_DAYS=90
# 审计保留清理调度器间隔（秒）。<=0 = 关闭后台清理（保留天数为 0 也同样不清理）。
# ⚠ 清理器假定单副本；多副本同时跑不会误删（按 cutoff 幂等），但会重复扫表、
#   放大 WAL。需要互斥时另加整轮独立连接锁或 CAS 行锁（见
#   capabilities/platform/services/audit_retention_scheduler.py 模块 docstring）。
# AUDIT_RETENTION_SCHEDULER_INTERVAL_SECONDS=86400
# AUDIT_HTTP_METHODS=POST,PUT,PATCH,DELETE
# 非 platform 容器（knowledge_base / business_domain）转发到 platform；
# compose 已为各容器注入，通常无需在此设置。
# AUDIT_INGEST_URL=http://platform-service:8000

# ============================================================
# 17. TCADP 平台（可选）
# ============================================================
TCADP_API_URL=https://tcadp.tencent.com/api
TCADP_API_KEY=your_tcadp_api_key_here
TCADP_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# 18. VLM / ASR 连接信息（音视频链路，preset 不写死；优先级 preset override > env > profile）
# ============================================================
# ⚠️ 实际部署走的是**平台自己的 llm-gateway**（不是外部 vision 服务地址）——
# 与 `deploy/.env` 对齐，见 §18 上方的 F7 说明。以图问知识复用同一份配置。
VLM_BINDING_HOST=http://llm-gateway:8787/v1
VLM_BINDING_API_KEY=gw_lightrag
VLM_MODEL_NAME=deepseek-v4-flash-202605
VLM_TIMEOUT=300

ASR_BINDING=openai_compatible
ASR_MODEL=large-v3
ASR_BASE_URL=asr-model-address
ASR_API_KEY=not-needed

# ── 视频解析后端（video_analysis_binding）──
# local（默认）：内置 ffmpeg + ASR + VLM 管线
# mps：腾讯云 MPS 智能分析（需 MPS_ENABLED=true）
# mineru：委托自建/远端 mineru-api（VLM 粗读 + ASR + OCR 兜底）
# VIDEO_ANALYSIS_BINDING=mineru

# ── MPS 凭证与旋钮（atomic-rag 容器读取；走 mps 后端时必配）──
# 读取点：atomic-rag-server.py 的 _get_mps_backend() + raganything.config
#   （env_file=.env，勿写进 .env.rag*）。
# ⚠️ 四项凭证 MPS_SECRET_ID / MPS_SECRET_KEY / MPS_COS_BUCKET / MPS_COS_REGION
#    **任缺一即跳过 MPS**（只记 warning「MPS 配置不完整，跳过视频智能分析」，
#    不阻断主链路）——**没有 COS_* 回落**，同账号同桶也要显式再配一遍。
# MPS_ENABLED=false                            # 总开关（默认 false）
# MPS_SECRET_ID=                               # 腾讯云 SecretId
# MPS_SECRET_KEY=                              # 腾讯云 SecretKey
# MPS_COS_BUCKET=                              # 视频所在 COS 桶
# MPS_COS_REGION=ap-guangzhou                  # 视频桶地域（默认 ap-guangzhou；未设时 atomic-rag-server 回落 MPS_REGION）
# MPS_REGION=ap-guangzhou                      # 接口调用地域（默认 ap-guangzhou）
# MPS_DEFINITION=33                            # AI 分析模板 ID：33 = VideoComprehension（默认 33）
# MPS_TIMEOUT=600                              # 单任务等待上限（秒，默认 600）
# MPS_POLL_INTERVAL=3                          # 任务状态轮询间隔（秒，默认 3）
# MPS_MAX_RETRIES=3                            # DescribeTaskDetail 瞬时失败重试（默认 3）
# MPS_PROMPT_CATEGORY=mps_video_understanding # 视频理解提示词分类（默认 mps_video_understanding）

# mineru 视频专用端点；未设置时回退 MINERU_SELFHOST_BASE_URL
# MINERU_VIDEO_BASE_URL=http://127.0.0.1:20490
# MINERU_VIDEO_MODE=text            # text（默认）/ visual
# MINERU_VIDEO_COARSE_PROMPT=       # MinerU VLM 粗读偏向（空=用 MinerU 缺省）；与 per-KB 视频提示词不是同一旋钮
# MINERU_VIDEO_POLL_INTERVAL=5
# MINERU_VIDEO_POLL_TIMEOUT=1800

LLM_BINDING_HOST=http://llm-gateway:8787/v1
LLM_BINDING_API_KEY=gw_lightrag

# ============================================================
# 19. 系统配额（Preview 阶段，knowledge-base 服务读取）
# ------------------------------------------------------------
# 单环境变量承载全部配额上限，对当前环境内所有租户统一生效。
# 配置缺失/非法/字段缺失/非正整数/单KB文档数>单租户文档数 → KB 服务拒绝启动。
# 存储容量按 MiB 配置，后端按 Byte 计算；修改后重启 KB 服务生效。
# 示例值仅作部署参考，实际额度以本变量为准。
# ============================================================
JONEX_SYSTEM_QUOTA_CONFIG={"tenantKnowledgeBaseLimit":999999,"tenantDocumentLimit":500,"tenantStorageLimitMiB":5120,"knowledgeBaseDocumentLimit":200,"uploadFileCountLimit":20,"documentFileSizeLimitMiB":100,"spreadsheetFileSizeLimitMiB":10,"imageFileSizeLimitMiB":20,"audioFileSizeLimitMiB":200,"audioDurationLimitMinutes":60,"videoFileSizeLimitMiB":500,"videoDurationLimitMinutes":30}


# ============================================================
# 20. 任务中心（task-center-service，8007）
# ------------------------------------------------------------
# 对应 `jonex_core/common/config.py` 里 `TASK_CENTER_*` 那一段。
# ⚠️ 默认值（19 项）一致，**唯一的例外是 `TASK_CENTER_URL`** —— 这里必须是容器 DNS 名
# （`localhost` 在容器里解析不到任务中心），config 的本地默认值是 `http://localhost:8007`。
# 别照着「默认值一致」这句去把它对齐回来。
# 后台循环**恒开、没有开关**：触发抢占 → 派活 → 消化上报 → **对账（拉）** → 超时巡检 → 补收口（六趟）
# 跑在一个循环里。
# 多副本下不选主、每份都跑、靠 CAS 抢占，所以每个副本的配置应当一致。
# ============================================================
# 能力服务地址（容器内）；docker-compose 的 sidecar 段已显式设过同名变量
TASK_CENTER_URL=http://task-center-service:8000
# 接入方（知识库等）调任务中心的 HTTP 超时（秒）—— 方向：接入方 → 任务中心。
# 管 report_status；execute / remove_task 是反方向、走下面的 RUNNER_TIMEOUT
TASK_CENTER_CLIENT_TIMEOUT=30
# init_task 专用的单次 HTTP 超时（秒）—— 覆写上面那条。
# ⚠️ **这是「单次 HTTP 的上限」，不是某把锁的持有时长**：2026-09-28 起 Ontology 库的
# 上传路径已经不把 init_task 放在 quota 锁里调了（两笔先后提交）。
# ⚠️ 但它**不是整条提交的上限** —— 走 SDK 且自带 `task_id` 时会重试满预算，
# 单条事务里最坏干等 3 × 这个值 + 退避 1.5 秒。
# 「建一条任务」正常几十毫秒，5 秒已是百倍余量
TASK_CENTER_CLIENT_INIT_TASK_TIMEOUT=5.0
# 一轮扫描的间隔（秒）
TASK_CENTER_SCHEDULER_INTERVAL=3.0
# 「补收口」那一趟的**降噪**阈值（秒）：任务行至少这么久没被动过，才值得去看它一眼。
# 那一趟救的是「当次运行早跑完、任务快照却没收到口」那一格（成因是收口那一刻任务快照
# 那次 CAS 落空）—— 那种任务原本后台不管、三扇操作门也各自拒它，只能人工改库。
# ⚠️ 只管降噪、不管正确性：该不该收口由 `_run_settled` 判，调大调小都不会判错。
TASK_CENTER_SETTLE_STALE_SEC=60
# 一轮里各扫多少条（触发抢占 / 派活 / 消化上报各自算，不是加起来）。
# ⚠️ 对「派活」那一趟，这个数是**一轮真派出去几条**、不是「一轮扫几条候选」
# （扫描面见下面那条 SCAN_FACTOR；防僵尸和超时巡检不受它约束，一次全清）
TASK_CENTER_SCHEDULER_BATCH=10
# 派活**扫描面**相对上面 BATCH 的放大倍数：一轮扫 `BATCH × 这个数` 条候选，
# 其中真派出去的够 BATCH 条就提前收工。
# 为什么要放宽：被 max_concurrency 挡下的候选**一个字都不写库**，下一轮还在原位，
# 扫描面若等于 BATCH，队头一旦全卡在同一个瓶颈上就会长期无人可派（队头阻塞）。
# 5 倍是「队头堵住 4 层仍能派满」的余量；调小到 1 就退回修之前的行为。
TASK_CENTER_SCHEDULER_SCAN_FACTOR=5
# 「就绪的 pending 卡多久算僵尸」——⚠️ 倍数、不是秒数：
# 判据是「现在 − 该子任务 updated_at > 该步 timeout_seconds × 这个倍数」
TASK_CENTER_PENDING_STUCK_TIMEOUT=3
# 一条上报连续消化失败多少次就判死信（上报收件箱的兜底出口）：
# 达本值 → dead_lettered=1 + is_deleted=1（出队，让开每轮的名额）+ ERROR 告警日志。
# 死信不是把上报丢掉：行永远留着，attempts / last_error 都在；
# 要放它重来，把那一行的 dead_lettered 与 is_deleted 都清回 0、attempts 归 0 即可（is_deleted 不能漏 —— 队列只看它）
TASK_CENTER_REPORT_MAX_ATTEMPTS=5
# 「基础设施故障那一档」的**绝对上限**（小时）—— ⚠️ 这是「让路死锁」的解药：
# 基础设施档（Redis / DB 连不上）**不计数**，于是它永远到不了上面的阈值、永远留在收件箱里，
# 而超时巡检的「让路」判据只看「收件箱里还有没有这条子任务的未消化上报」→ 那条子任务
# 永远判不了超时（任务永远不终态、retry/delete 全部拒；那个 running 还占着并发名额，
# 全平台按 step_code 共用，攒够上限这一步全平台派不出活）。
# 躺过本值（判据 now − reported_at）就**不管是谁的错**一律判死信出队，让路随即失效。
# 短时故障（Redis 抖十几秒）在本值之内早就恢复处理完，不受影响；
# 代价是真出现持续超过本值的大故障时，那期间积压的上报会被判死信（记录留着、日志可查）。
# 别调到 0（等于下一次记失败就判死信，把「不计数」这条设计整个抵消掉）。
TASK_CENTER_REPORT_INFRA_MAX_HOURS=24
# 派活出站调运行方的单次 HTTP 超时（秒）—— 投递 + 回执，不等对方跑完
TASK_CENTER_RUNNER_TIMEOUT=30
# **对账（拉）**：子任务派出去多久没消息，才值得主动去问运行方一句（秒，§4.1 ④）。
# 推进编排原来**只能等运行方上报**，上报丢了子任务就挂到编排硬超时（预置 7 小时）；
# 现在多一条路 —— 管理方**主动问**（`query_step_status`），问不到下一拍再问，不存在永久丢。
# 本值只决定「多久算沉默」，不决定对账本身的节拍（它跟着调度循环走）。
TASK_CENTER_QUERY_QUIET_SEC=120
# 「停止时通知运行方」（§4.1 ③ `task_stopped`）的单次 HTTP 超时（秒）。
# ⚠️ **比上面那个 30 秒短得多是有意的**：它跑在用户点「停止」那条**同步请求**里，
# 不该让用户为一次「通知」干等半分钟；而且它是**通知不是命令**（停不停由运行方
# 自己决定），发不出去也不影响「停止」本身成没成 —— 丢了只是那份被接管的文档晚
# 一点解锁（退回看门狗那条 30 分钟的兜底，不会更差）。
# ⚠️ 只用于这一个动作：`execute` / `remove_task` 仍用上面那个 30 秒。
TASK_CENTER_NOTIFY_TIMEOUT=5.0
# 触发抢占「读—算—写」撞车后的重试次数，试满仍撞车就报冲突
TASK_CENTER_CAS_ATTEMPTS=3
# 任务锁租约（毫秒）—— Redis SET NX PX；锁不跨出站调用，盖住一次事务就够
TASK_CENTER_LOCK_TIMEOUT=30000
# 抢锁的短重试：3 次 × 50ms（调度循环类走这档，拿不到就本轮跳过、下轮再来）
# ⚠️ 例外是派活收尾 _finalize_one —— 它接着 patient 等满 ≈3.15 秒，仍拿不到
#    只记 warning、这一单派活回执就丢了（子任务留 running 等上报 / 超时巡检），
#    不是「本轮跳过」
TASK_CENTER_LOCK_RETRY=3
TASK_CENTER_LOCK_RETRY_INTERVAL=0.05
# 「调用方主动发起的写操作」（retry_task / retry_subtask / task.stop / task.delete 这四个）
# 拉长后的等待窗口：30 次 × 100ms
TASK_CENTER_LOCK_WAIT=30
TASK_CENTER_LOCK_WAIT_INTERVAL=0.1


# ============================================================
# 21. 身份同步自动调度（platform-service，8006）
# ------------------------------------------------------------
# 对应 `jonex_core/common/config.py` 里 `IdentityIntegrationSettings` 那一段
# （紧接在上面 §20 的 TaskCenterSettings 之后）。
# ⚠️ 本组与 §7 里的 `MOCK_DATASOURCE_*` / `DATASOURCE_GATEWAY_*` **不是一回事**：
#    那一组是**侧车**读的联调件，本组由 **platform-service 容器**读取
#    （该服务 `env_file: .env` 全量注入，故写在这里即生效）。
# 后台循环**恒开、没有开关**（对齐 §20 任务中心）：自动同步是否启用是**逐租户**
# 产品配置（`identity_integration_config.auto_sync_enabled`），全局开关会让
# 「某个租户打开了但没跑」变得无从解释。要全局禁掉就把 BATCH 设 0（每轮扫 0 条）。
# ============================================================
# 后台循环心跳（秒）：一轮扫描的间隔。**启动时立刻跑第一轮**，不等这个间隔
IDENTITY_SYNC_SCHEDULER_INTERVAL=60.0
# 一轮最多处理几个到期租户。
# ⚠️ 这是**每轮派出去几个**的配额，不是「扫几条候选」：没抢到（被别的副本抢走 /
#    与手动同步互斥）的不占配额，下一轮还会被扫到。
IDENTITY_SYNC_SCHEDULER_BATCH=50
# 租户没有自己的 `sync_interval` 时的兜底同步周期（小时）。
# ⚠️ **必须与前端同值**：`frontends/platform-management/src/pages/TenantDetail/
#    SyncConfigDrawer.tsx` 的 `DEFAULT_INTERVAL_HOURS = 24`。两处不一致时，界面上
#    「默认 24 小时」的提示与实际调度周期会对不上（前端只在「没填过」时提示该值，
#    真正决定跑多久的是这个后端兜底）。
# 调度侧另有**硬下限** `max(interval_hours, 1)`（见
# `services/identity_sync_scheduler.py::MIN_INTERVAL_HOURS`），本值调小于 1 无意义。
IDENTITY_SYNC_DEFAULT_INTERVAL_HOURS=24

# ============================================================
# 19. 以图问知识（图片 → 识别文本 → 复用现有检索链路）
# 设计：docs/knowledge-base/image-query-search-execution-plan.md
#
# 这些变量的默认值都在 `jonex_core/common/config.py` 的 ImageQuerySettings 里，
# 这里列出来只为让运维知道**可以调**；不配就用默认值。
# ⚠️ 网关（gateway 容器）与知识库能力服务（knowledge-base-service 容器）**读的是同一份**，
# 所以两边默认值天然一致（各写一套正是「前端按 4 张判、后端按别的数拒」的来源）。
# ============================================================

# ── VLM 调用（留空则逐级回落：HOST → ONTOLOGY_LLM_BINDING_HOST；
#    MODEL → VLM_MODEL_NAME；解析逻辑在 jonex_core/common/vision_llm.py）──
# IMAGE_QUERY_VLM_BINDING_HOST=
# IMAGE_QUERY_VLM_BINDING_API_KEY=
# IMAGE_QUERY_VLM_MODEL=
#
# ⚠️⚠️ **IMAGE_QUERY_VLM_TIMEOUT 与 IMAGE_QUERY_GATEWAY_TIMEOUT 是死约束，改前先读** ──
# 单张识别超时（秒）。交互场景，超时报错、不重试、不静默降级成纯文字检索。
# B0 实测（2026-10-09）：关思考下单图 3.7~5.3s，40s 是 7.5 倍余量，属「抖动容忍上限」。
# IMAGE_QUERY_VLM_TIMEOUT=40
# 一次请求内并行识别的张数。B0 实测 4 张并行无上游限流，墙钟 6.03s。
# **调低会让总耗时按 ceil(MAX_IMAGES / CONCURRENCY) 翻倍**，进而顶穿下面那个 55s。
# IMAGE_QUERY_VLM_CONCURRENCY=4

# ── 限制（前端内置同样的默认值，但以识别接口回包里的 limits 为准）──
# IMAGE_QUERY_MAX_BYTES=5242880         # 单张 5MB（前端压缩后的那份，不是用户原图）
# IMAGE_QUERY_MAX_IMAGES=4              # 一次检索最多几张
# IMAGE_QUERY_MAX_TOTAL_BYTES=12582912  # 总量 12MB（限制 invoke 报文与 Redis 暂存体积）
# IMAGE_QUERY_MAX_QUERY_CHARS=500       # 合并后的查询文本截断上限（检索 DTO 上限是 2000）
#
# ⚠️ 网关调识别 action 的单路由超时 = VLM_TIMEOUT × ceil(MAX_IMAGES / CONCURRENCY) + 15。
#    按默认值 = 40 × 1 + 15 = 55s。
#    两条硬约束：① ≤ 部署的 SIDECAR_PROXY_TIMEOUT（默认 300）；
#              ② **本地联调必须 < 60s** —— frontends/dev-gateway/index.js 的
#                 proxyTimeout / timeout 写死 60000，超了会被它先掐成 502。
# IMAGE_QUERY_GATEWAY_TIMEOUT=55

# ── 时效 ──
# IMAGE_QUERY_CACHE_TTL=86400      # 识别文本缓存（按图 sha256，租户级；提示词版本变更即失效）
# IMAGE_QUERY_PENDING_TTL=1800     # 识别后等待保存历史的 Redis 暂存（30 分钟；过期即丢弃）
# IMAGE_QUERY_VIEW_TOKEN_TTL=900   # 图片查看票据有效期（与 COS 预签名默认一致）

# ── 持久化与兜底清理 ──
# 回滚开关（§8）：设 false 时不暂存、不返回 image_id，退化为「识别文本可用、历史不带图」，
# 不需要动检索链路、也不需要改前端。
# IMAGE_QUERY_PERSIST_ENABLED=true
# 兜底清理扫描间隔（秒）。它挂在知识库服务既有的 30 秒对账循环里，**由自己节流**；
# 配 0 或负数 = 关掉这趟（不是「每轮都跑」）。
# IMAGE_QUERY_SWEEP_INTERVAL=3600
# 只收「最后一次被引用」早于该时长的无引用图片。它只为避开「刚落盘、历史事务还没提交」
# 的窗口 —— 正常路径下图片与历史前后脚提交。
# IMAGE_QUERY_ORPHAN_GRACE_MINUTES=60

# ⚠️⚠️ **llm-gateway 侧必须同时把 scene `image_query_caption` 加进关思考白名单**：
#    LLMGW_DISABLE_THINKING_SCENES=...,image_query_caption
# 不加的后果**不是"慢一点"而是"永远识别失败"**：上游 deepseek-v4-flash-202605 是
# 思考型模型，reasoning 会把 max_tokens 整个吃掉、content 恒为空字符串（B0 实测：
# 1790KB 的图 finish_reason=length 且正文长度 0）。改完要重启 llm-gateway 容器。
# 改 `deploy/.env` 的该变量后记得同步这里，别让示例与实际漂移。

# ============================================================
# 19. 数据治理 · 保留策略（第 3 期）
# ============================================================
# 解析链路：data_governance.retention_policy 的 document → kb → tenant 三级策略；
# 三级都没有配置时用下面的全局默认值。
#
# ⚠️ 保留天数语义：0 = **不自动到期**（不是「立即删除」）；>0 = 按天到期归档。
# RETENTION_DEFAULT_DAYS=0
#
# 归档后进入宽限期（天），到期仍未恢复则**自动销毁（不可逆）**：
# 销毁会删除检索索引、对象存储原文件与文档行，**无法恢复**。
# 宽限 0 = 归档后下一轮立即销毁；负数 = 永不自动销毁（显式关闭）。
# RETENTION_GRACE_DAYS=30
#
# 扫描间隔（秒）：<=0 = 显式关闭保留扫描调度器（不启动后台任务）。
# RETENTION_SCHEDULER_INTERVAL_SECONDS=3600
#
# 每轮归档候选 / 销毁候选各自最多处理多少条（两个独立批次）。
# 同租户每轮另有 max(1, 本值 // 10) 的公平性上限，防止大租户积压饿死其它租户。
# RETENTION_SCAN_BATCH=200
#
# 同一文档归档/销毁失败后的进程内冷却（秒）：冷却期内不再尝试。
# 仅进程内状态、不落库；多副本部署时每个副本各记各的（假定单副本）。
# RETENTION_FAILURE_COOLDOWN_SECONDS=3600
