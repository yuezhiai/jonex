# ============================================================
# MCP Server 配置模板
# ------------------------------------------------------------
# 用法：复制为 mcp_server/.env.mcp 或 deploy/.env.mcp，按需修改。
# 与 deploy/.env.mcp.example 保持同一变量集合；改动时两份同步。
# ============================================================

# ============================================================
# 1. 数据库连接
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 2. 服务配置
# ============================================================
MCP_SERVER_PORT=8002
GATEWAY_URL=http://gateway:8000
# Gateway /internal/* 认证 key（X-Internal-API-Key）；本机直连 Gateway 或走 deploy/ 时，
# 须与 deploy/.env 的 INTERNAL_API_KEY 逐字一致。本行是模板值，生产必须替换
INTERNAL_API_KEY=
# 本体列式浏览单次跨库聚合上限：默认 20，允许 1-100。
# 非法值（非整数 / 0 / 负数 / 越界）回落 20 并告警，不影响服务启动。
# ONTOLOGY_MAX_FANOUT_KBS=20
# 本体邻域遍历深度硬上限：默认 3，允许 1-20。
# ⚠ 由 gateway / knowledge-base-service / mcp-server 三处同名读取：
#   - gateway：deploy/docker-compose.yml 的显式 environment 清单（无 env_file）
#   - knowledge-base-service：deploy/.env
#   - mcp-server：本文件
# 调大时三处必须取同值，否则网关会先按自己的上限拒绝请求。
# ONTOLOGY_NEIGHBOR_DEPTH_MAX=3
# 多 KB 多跳整体截止时间（秒）：默认 25，允许 1-120。仅 mcp-server 读取，
# 且仅在 depth>1 的多 KB 调用生效；单次多跳的超时仍由能力侧 10s 控制。
# ONTOLOGY_MULTIHOP_DEADLINE_SECONDS=25

# ============================================================
# 3. 安全配置
# ============================================================
# ⚠️ 留空或整行删除会让 mcp-server 拒绝启动（fail-closed）；须与 deploy/.env 的
# JWT_SECRET 逐字一致。本行是模板值，生产必须换成真实随机值
JWT_SECRET=

# MCP Key 的 HMAC 盐（优先于 JWT_SECRET，实现见 mcp_server/crypto.py:106-121）。
# ⚠️ mcp-server 只加载本文件，不读 deploy/.env。若主 .env 配了 MCP_KEY_SECRET
#    而这里没配，mcp-server 会回退本文件的 JWT_SECRET，与写入侧盐不同 ⇒ 所有 yxm_ Key 401。
# 规则：要么两边都留空（一起回退 JWT_SECRET），要么两边配同值。
MCP_KEY_SECRET=
MCP_KEY_SECRET_LEGACY=

# ============================================================
# 4. 限流配置
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# 5. Jonex Wiki 列式浏览（4 个只读工具）
# ============================================================
# 开关只收敛 MCP 暴露面：关闭后工具仍出现在 tools/list，返回空结果 +
# wiki_browse_disabled=true，不调上游。默认开启，可回退。
# WIKI_BROWSE_ENABLED=true
# 深度上限（独立变量，**不回落** ONTOLOGY_NEIGHBOR_DEPTH_MAX）。范围 1~20。
# WIKI_BROWSE_DEPTH_MAX=3
# 单库上游调用超时（秒），范围 1~120；超时组进 errors。
# WIKI_BROWSE_REQUEST_TIMEOUT_SECONDS=30
# 多库扇出整体截止时间（秒），范围 1~180。
# WIKI_BROWSE_DEADLINE_SECONDS=60

# ============================================================
# 5b. Wiki 检索开关（search_llmwiki / search_jonex_wiki）
# ============================================================
# 关闭后工具仍出现在 tools/list，调用直接返回 -32000「暂未开放」，不调上游。
# 默认开启；下一节的启动健康检查失败**不会**翻转这两个开关，只记录告警。
# SEARCH_LLMWIKI_ENABLED=true
# SEARCH_JONEX_WIKI_ENABLED=true

# ============================================================
# 6. 依赖健康检查（启动时探测；仅观测，不翻转工具开关）
# ------------------------------------------------------------
# 探测失败**只记录告警**，不会禁用工具、也不会改变 SEARCH_* 开关。
# 容器部署时主机名与 compose 的 hostname 一致：
#   openkb      ⇒ openkb:7566
#   jonex-wiki  ⇒ jonex-wiki:8007（B1 单容器：引擎 + 能力同进程）
# ⚠️ 不要再写成 jonex-wiki-adapter:7567 —— 那是已删除的独立 adapter 架构。
# ============================================================
OPENKB_HEALTH_URL=http://openkb:7566/health
JONEX_WIKI_HEALTH_URL=http://jonex-wiki:8007/health
