{
  "contract_version": 1,
  "cases": [
    {
      "name": "rule_parse_transitive",
      "kind": "rule",
      "model": {
        "entities": [{ "name": "Equipment" }],
        "relations": [
          { "name": "隶属于", "source": "Equipment", "target": "Equipment" }
        ]
      },
      "input": {
        "rule_text": "IF ?a 隶属于 ?b AND ?b 隶属于 ?c THEN ?a 隶属于 ?c"
      },
      "expect": {
        "ast": {
          "premises": [
            { "kind": "rel", "s": "a", "p": "隶属于", "o": "b" },
            { "kind": "rel", "s": "b", "p": "隶属于", "o": "c" }
          ],
          "conclusion": { "kind": "rel", "s": "a", "p": "隶属于", "o": "c" }
        },
        "issues": []
      }
    },
    {
      "name": "rule_parse_inverse_normalization",
      "kind": "rule",
      "model": {
        "entities": [{ "name": "Equipment" }],
        "relations": [
          {
            "name": "隶属于",
            "source": "Equipment",
            "target": "Equipment",
            "inverse_of": "下属"
          }
        ]
      },
      "input": {
        "rule_text": "IF ?a 下属 ?b AND ?b 下属 ?c THEN ?a 下属 ?c"
      },
      "expect": {
        "ast": {
          "premises": [
            { "kind": "rel", "s": "b", "p": "隶属于", "o": "a" },
            { "kind": "rel", "s": "c", "p": "隶属于", "o": "b" }
          ],
          "conclusion": { "kind": "rel", "s": "c", "p": "隶属于", "o": "a" }
        },
        "issues": []
      }
    },
