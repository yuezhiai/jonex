# ============================================================
# LightRAG Server 配置 —— 本地调试 · 连服务器基础设施 · 完整模板
# ------------------------------------------------------------
# 用途：本机运行 lightrag-server（VSCode「Backend: LightRAG」），
#       PostgreSQL / Milvus / Neo4j / llm-gateway 走服务器。
#
# 变量全集参考 deploy/.env.rag（生产实际值），完整可选项见上游：
#   Reference/LightRAG/env.example
#
# 用法：
#   1. 复制为 .env.rag.local：
#        Copy-Item .env.rag.local.example .env.rag.local
#   2. ★用编辑器「全局替换」把本文件所有 SERVER_IP 换成实际服务器 IP★（如 192.168.1.100）
#
# ⚠️ 用字面 SERVER_IP 而非 ${SERVER_IP}：本文件由 VSCode envFile 注入、
#    并被 LightRAG 第三方按进程变量读取，二者都不做 ${} 插值，字面量会连不上。
#    全局替换成真实 IP 后不含变量，安全。
#
# ⚠️ 服务器防火墙需放行：5432(PG) / 19530(Milvus) / 7687(Neo4j) / 8787(llm-gateway)
# ============================================================

# ============================================================
# 1. 服务
# ============================================================
HOST=0.0.0.0
PORT=9621
WORKERS=2
TIMEOUT=300

# ============================================================
# 2. 鉴权（atomic-rag 调用时附 X-API-Key；须与 .env.local 的 LIGHTRAG_API_KEY 一致）
# ============================================================
LIGHTRAG_API_KEY=change-me-in-production-please
# WebUI 登录（仅开发/运维使用，生产不暴露）
AUTH_ACCOUNTS=admin:change-me-please
TOKEN_SECRET=change-me-jwt-secret
TOKEN_EXPIRE_HOURS=48

# ============================================================
# 3. 工作目录（本地调试落工程内 .lightrag_data；launch.json 亦会注入覆盖）
# ============================================================
WORKING_DIR=.lightrag_data/rag_storage
INPUT_DIR=.lightrag_data/inputs

# ============================================================
# 4. LLM（OpenAI 兼容协议，经服务器 llm-gateway 代理；不直连上游）
# ============================================================
LLM_BINDING=openai
LLM_BINDING_HOST=http://SERVER_IP:8787/v1
LLM_BINDING_API_KEY=gw_lightrag
LLM_MODEL=deepseek-v4-flash-202605
LLM_TIMEOUT=600

# ============================================================
# 5. Embedding（经服务器 llm-gateway 代理；首篇文档处理后不可再改）
# ============================================================
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://SERVER_IP:8787/v1
EMBEDDING_BINDING_API_KEY=gw_lightrag
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=true
EMBEDDING_TOKEN_LIMIT=8192
# 5.1 Embedding 并发（按实际服务压测标定，见 scripts/bench_embedding.py）
EMBEDDING_FUNC_MAX_ASYNC=16
EMBEDDING_BATCH_NUM=4

# ============================================================
# 6. 存储后端：KV/DocStatus→PostgreSQL；图→Neo4j；向量→Milvus
#    ⚠️ 图存储必须为 Neo4JStorage（atomic-rag 依赖其 jonex_* 图查询端点）。
#    ⚠️ 禁止设置任何 *_WORKSPACE（会塌缩所有库到同一空间，启动 fail-fast）。
# ============================================================
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# 6.0.1 PostgreSQL 连接（PGKVStorage / PGDocStatusStorage 用）— 指向服务器
POSTGRES_HOST=SERVER_IP
POSTGRES_PORT=5432
POSTGRES_USER=jonex
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=jonex
POSTGRES_MAX_CONNECTIONS=25

# 6.0.2 Milvus 连接（MilvusVectorDBStorage 用）— 指向服务器
MILVUS_URI=http://SERVER_IP:19530
MILVUS_DB_NAME=lightrag
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_TOKEN=

# 回退路径（仅本地单进程最简调试用，不建议）：
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# 6.2 工作空间隔离开关
RAG_WORKSPACE_ISOLATION=true
RAG_WORKSPACE_CACHE_MAX=64
# ⚠️ WebUI workspace 切换器：绕过租户校验，仅限本地调试，生产严禁开启
WEBUI_WORKSPACE_SWITCHER=true

# ============================================================
# 7. Neo4j 图后端（LightRAG 图谱存储）— 指向服务器
# ============================================================
NEO4J_URI=bolt://SERVER_IP:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# 单 driver 连接池上限（隔离模式下连接数上界 = CACHE_MAX × 本值）
NEO4J_MAX_CONNECTION_POOL_SIZE=16

# ============================================================
# 8. 文档处理
# ============================================================
SUMMARY_LANGUAGE=Chinese
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# 8.1 实体/关系抽取（提升本体召回）
# ENTITY_TYPES：LightRAG 约定为 JSON 数组字符串（非逗号分隔），注入抽取 prompt + 写入 GraphML
ENTITY_TYPES='["组织","人员","产品","技术","方法","系统","设备","模型","数据","功能","概念","流程","任务","项目","方案","场景","事件","文档","报告","指标","标准","政策","配置","参数","环境","渠道","市场","行业","风险","法务","疾病","症状","物料","地点","时间"]'
# 补抽轮数（2 捞回首轮漏抽，代价是变慢）
MAX_GLEANING=2
# 同名实体/关系合并触发 LLM 摘要的累计描述片段阈值（建议 ≥3）
FORCE_LLM_SUMMARY_ON_MERGE=4
# Embedding 请求超时（留足冷启动余量）
EMBEDDING_TIMEOUT=600

# ============================================================
# 9. 并发控制（按上游 LLM 压测标定，见 scripts/bench_llm_extract.py）
# ------------------------------------------------------------
# MAX_ASYNC：并发 LLM 调用上限（图重建阶段用 ×2）
# MAX_PARALLEL_INSERT：并行处理文档数（建议 ≈ MAX_ASYNC/3）
# ============================================================
MAX_ASYNC=12
MAX_PARALLEL_INSERT=4

# ============================================================
# 10. LLM 缓存
# ============================================================
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# ============================================================
# 11. Rerank（检索期重排；经服务器 llm-gateway 的 /v1/rerank）
#     关闭改为 RERANK_BINDING=null。须与 .env.local 的 RAG_RETRIEVAL_RERANK_ENABLED 呼应。
# ============================================================
RERANK_BINDING=cohere
RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
RERANK_BINDING_HOST=http://SERVER_IP:8787/v1/rerank
RERANK_BINDING_API_KEY=gw_lightrag
RERANK_BY_DEFAULT=true
MIN_RERANK_SCORE=0.0

# ============================================================
# 12. [jonex] v2 原子能力控制（atomic-rag / PushChunksStage / ParseStage）
# ============================================================
# 12.1 入库：严格逐 chunk 确认 doc_id（默认 true，对齐 v1）
RAG_REQUIRE_DOC_IDS=true
# 12.2 解析：瞬时网络/SSL 错误自动重试（所有 parser 生效）
RAG_PARSE_RETRY_MAX=3             # 含首次共尝试次数
RAG_PARSE_RETRY_BASE_SEC=2.0      # 指数退避基数（秒）
# 12.3 Per-chunk 超时：单 chunk 独立超时窗口（秒），超时后对该 chunk 重推重试
RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS=900
# 12.4 超时 chunk 重推最大次数（仅 PushChunksStage，task_manager 恢复路径不重推）
RAG_TRACK_PER_CHUNK_MAX_RETRIES=2
# 12.5 单次 batch_track_status 全局安全网（秒），须 ≥ RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS
RAG_TRACK_TIMEOUT_SECONDS=1800
