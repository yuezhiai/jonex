ASR_BASE_URL=asr-model-address
ASR_API_KEY=not-needed

LLM_BINDING_HOST=http://llm-gateway:8787/v1
LLM_BINDING_API_KEY=gw_lightrag
LLM_MODEL=deepseek-v4-flash

# ============================================================
# 19. 系统配额（Preview 阶段，knowledge-base 服务读取）
# ------------------------------------------------------------
# 单环境变量承载全部配额上限，对当前环境内所有租户统一生效。
# 配置缺失/非法/字段缺失/非正整数/单KB文档数>单租户文档数 → KB 服务拒绝启动。
# 存储容量按 MiB 配置，后端按 Byte 计算；修改后重启 KB 服务生效。
# 示例值仅作部署参考，实际额度以本变量为准。
# ============================================================
JONEX_SYSTEM_QUOTA_CONFIG={"tenantKnowledgeBaseLimit":999999,"tenantDocumentLimit":500,"tenantStorageLimitMiB":5120,"knowledgeBaseDocumentLimit":200,"uploadFileCountLimit":20,"documentFileSizeLimitMiB":100,"spreadsheetFileSizeLimitMiB":10,"imageFileSizeLimitMiB":20,"audioFileSizeLimitMiB":200,"audioDurationLimitMinutes":60,"videoFileSizeLimitMiB":500,"videoDurationLimitMinutes":30}


# ============================================================
# 20. 任务中心（task-center-service，8007）
# ------------------------------------------------------------
# 对应 `jonex_core/common/config.py` 里 `TASK_CENTER_*` 那一段（默认值一致）。
# 后台循环**恒开、没有开关**：触发抢占 → 派活 → 消化上报 → 超时巡检 → **补收口**（五趟）
# 跑在一个循环里。
# 多副本下不选主、每份都跑、靠 CAS 抢占，所以每个副本的配置应当一致。
# ============================================================
# 能力服务地址：Sidecar 的静态端点表里 task_center 指向它
TASK_CENTER_URL=http://127.0.0.1:8007
# 接入方（知识库等）调任务中心的 HTTP 超时（秒）—— 方向：接入方 → 任务中心。
# 管 report_status；execute / remove_task 是反方向、走下面的 RUNNER_TIMEOUT
TASK_CENTER_CLIENT_TIMEOUT=30
# init_task 专用的单次 HTTP 超时（秒）—— 覆写上面那条。
# ⚠️ **这是「单次 HTTP 的上限」，不是某把锁的持有时长**（2026-09-28 起 Ontology 库的
# 上传路径已经不把它放在 quota 锁里调了）；但它也不是整条提交的上限 —— 走 SDK 且
# 自带 `task_id` 时会重试满预算，最坏干等 3 × 这个值 + 退避 1.5 秒。
# 「建一条任务」正常几十毫秒，5 秒已是百倍余量
TASK_CENTER_CLIENT_INIT_TASK_TIMEOUT=5.0
# 一轮扫描的间隔（秒）
TASK_CENTER_SCHEDULER_INTERVAL=3.0
# 一轮里各扫多少条（触发抢占 / 派活 / 消化上报各自算，不是加起来）。
# ⚠️ 对「派活」那一趟，这个数是**一轮真派出去几条**、不是「一轮扫几条候选」
# （扫描面见下面那条 SCAN_FACTOR；防僵尸和超时巡检不受它约束，一次全清）
TASK_CENTER_SCHEDULER_BATCH=10
# 派活**扫描面**相对上面 BATCH 的放大倍数：一轮扫 `BATCH × 这个数` 条候选，
# 其中真派出去的够 BATCH 条就提前收工。
# 为什么要放宽：被 max_concurrency 挡下的候选**一个字都不写库**，下一轮还在原位，
# 扫描面若等于 BATCH，队头一旦全卡在同一个瓶颈上就会长期无人可派（队头阻塞）。
# 5 倍是「队头堵住 4 层仍能派满」的余量；调小到 1 就退回修之前的行为。
TASK_CENTER_SCHEDULER_SCAN_FACTOR=5
# 「就绪的 pending 卡多久算僵尸」——⚠️ 倍数、不是秒数：
# 判据是「现在 − 该子任务 updated_at > 该步 timeout_seconds × 这个倍数」
TASK_CENTER_PENDING_STUCK_TIMEOUT=3
# 派活出站调运行方的单次 HTTP 超时（秒）—— 投递 + 回执，不等对方跑完
TASK_CENTER_RUNNER_TIMEOUT=30
# 「停止时通知运行方」（§4.1 ③ `task_stopped`）的**单次 HTTP 超时**（秒）。
# 比上面那个短得多：它跑在**用户点「停止」那条同步请求**里，不该为一次「通知」干等半分钟；
# 而且它是通知不是命令，发不出去也不影响「停止」本身成没成 —— 丢了只是那份被接管的文档
# 晚一点解锁（有运行方自己的兜底探查接着，见 `task_watch_service._master_already_settled`）。
# ⚠️ 本值只用于这一个动作：`execute` / `remove_task` 仍用 `TASK_CENTER_RUNNER_TIMEOUT`。
TASK_CENTER_NOTIFY_TIMEOUT=5.0
# 触发抢占「读—算—写」撞车后的重试次数，试满仍撞车就报冲突
TASK_CENTER_CAS_ATTEMPTS=3
# 任务锁租约（毫秒）—— Redis SET NX PX；锁不跨出站调用，盖住一次事务就够
TASK_CENTER_LOCK_TIMEOUT=30000
# 抢锁的短重试：3 次 × 50ms（调度循环类走这档，拿不到就本轮跳过、下轮再来）
TASK_CENTER_LOCK_RETRY=3
TASK_CENTER_LOCK_RETRY_INTERVAL=0.05
# 「调用方主动发起的写操作」（retry_task / retry_subtask / retry_subtasks / task.stop /
# task.delete）拉长后的等待窗口：30 次 × 100ms
TASK_CENTER_LOCK_WAIT=30
TASK_CENTER_LOCK_WAIT_INTERVAL=0.1
# 「补收口」那一趟的降噪阈值（秒）：任务行至少这么久没被动过才去看它一眼
TASK_CENTER_SETTLE_STALE_SEC=60
# 消化上报连续失败几次判死信（出队）
TASK_CENTER_REPORT_MAX_ATTEMPTS=5
# 基础设施档（Redis / DB 不可用）的绝对上限（小时）：超了也判死信
TASK_CENTER_REPORT_INFRA_MAX_HOURS=24


# ============================================================
# Jonex Wiki 引擎（本机进程内跑时读这里；容器链路读 deploy/.env.jonex_wiki）
# ------------------------------------------------------------
# 本机 `scripts/local-dev/launch.py start jonex_wiki`（B1：引擎+能力同进程，8017）
# 的 Settings 从**本文件**读，`deploy/.env.jonex_wiki` 不参与；容器链路（compose
# 的 jonex-wiki 服务）读的是后者。两边都要调同一个旋钮时，别忘了改两次。
#
# 下面四项是编译链路的调度旋钮，改完在下一次编译就生效（不需要改代码）。
# 它们不进 manifest 身份比较：调旋钮不会让已发布的 bundle 作废，也不会重跑
# 已有 passage 的模型调用（只是会多发布一个 revision）。
# ============================================================
# 页面 passage 并发度（同时编译几个 passage）。没有「不限」语义，串行写 1 [默认: 4]
JONEX_WIKI_COMPILE_CONCURRENCY=4
# 调度器：stream（有界信号量+重排缓冲，快）/ window（固定窗口屏障，回滚用）[默认: stream]
JONEX_WIKI_COMPILE_SCHEDULER=stream
# passage 永久失败率上限（0..1），超过即 fail closed [默认: 0.05]
JONEX_WIKI_COMPILE_MAX_PASSAGE_FAILURE_RATE=0.05
# Error Book 有界修复轮的触发间隔（每 N 个 batch 一轮，范围 1..1000）[默认: 50]
JONEX_WIKI_COMPILE_REPAIR_INTERVAL=50
# 任务级并发槽（解析/编译/查询/目录）见 deploy/.env.jonex_wiki 的「并发」段；
# 本机链路要调它们，同样在本文件按 JONEX_WIKI_API_*_CONCURRENCY 写即可。

# ============================================================
# 19. 以图问知识（图片 → 识别文本 → 复用现有检索链路）
# 与 deploy/.env.example §19 同一份配置；本机调试时**至少要看这两条**。
# ============================================================
# ⚠️ 识别走平台 llm-gateway。留空则回落到 ONTOLOGY_LLM_BINDING_HOST（见上方第 5 节）——
#    本地指向 `SERVER_IP:8787` 时注意：如果服务器把 llm-gateway 映射到了别的宿主端口
#    （deploy/docker-compose.override.yml 里是 8788，理由是 8787 被本机 bun 占用），
#    这里就得写实际端口，否则回落过去连不上。
# IMAGE_QUERY_VLM_BINDING_HOST=http://SERVER_IP:8788/v1
# IMAGE_QUERY_VLM_BINDING_API_KEY=gw_platform
# IMAGE_QUERY_VLM_MODEL=deepseek-v4-flash-202605
#
# ⚠️ 本地联调最容易撞的一道闸不是 Docker 那两道（默认 300s），而是
#    frontends/dev-gateway/index.js 里**写死的 60000ms**。所以识别接口整体
#    超时必须低于 60 秒 —— 默认值 40（单张）× 1 + 15 = 55s，刚好够用。
#    要调大 IMAGE_QUERY_VLM_TIMEOUT 就必须同时改 dev-gateway 的超时。
# IMAGE_QUERY_VLM_TIMEOUT=40
# IMAGE_QUERY_GATEWAY_TIMEOUT=55
