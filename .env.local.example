# ============================================================
# Jonex 平台 — 本地后端调试 · 连服务器基础设施（online 依赖）· 完整模板
# ------------------------------------------------------------
# 用途：本机运行后端（Gateway / Sidecar / 各 Capability / atomic-rag），
#       PostgreSQL / Redis / Milvus / Neo4j / MinIO / llm-gateway 等
#       中间件与重型依赖全部走服务器。
#
# 变量全集参考 deploy/.env（生产实际值）；中间件"连线上"用字面占位符
# SERVER_IP（复制后全局替换为服务器 IP，见下方用法）。
#
# 用法：
#   1. 复制为 .env.local：
#        Copy-Item .env.local.example .env.local
#   2. ★用编辑器「全局替换」把本文件所有 SERVER_IP 换成实际服务器 IP★
#        （如 192.168.1.100；VSCode: Ctrl+H 在当前文件替换）
#   3. 按需填入被脱敏的密钥（COS / MinerU / 上游 LLM key，从 deploy/.env 取）
#
# ⚠️ 为什么用字面 SERVER_IP 而不是 ${SERVER_IP}：
#    ${VAR} 插值仅在经 python-dotenv 加载时有效；VSCode 的 envFile 与
#    LightRAG 第三方加载都不做插值，会把 ${SERVER_IP} 当字面主机名导致连不上。
#    字面占位符全局替换后不含变量，任何加载方式都安全。
#
# ⚠️ 服务器防火墙需放行：5432 / 6379 / 19530 / 9091 / 9000 / 2379 / 7687 / 8787 / 8004
# ============================================================

# ============================================================
# 1. 应用与服务基础
# ============================================================
ENV=dev
LOG_LEVEL=INFO
WORKERS=4

# ── 国际化（i18n）──
# 系统默认语言：请求不带 X-Lang header 时的兜底语言（默认 en-US）
# DEFAULT_LOCALE=en-US
# 支持的语言列表（逗号分隔）
# SUPPORTED_LOCALES=zh-CN,en-US

# ============================================================
# 2. PostgreSQL 数据库 — 指向服务器
# ============================================================
DB_HOST=SERVER_IP
DB_PORT=5432
DB_USERNAME=jonex
DB_PASSWORD=change-me
DB_NAME=jonex

# ============================================================
# 3. Redis 缓存 / 服务发现 — 指向服务器
# ============================================================
REDIS_URL=redis://SERVER_IP:6379/0
# REDIS_PASSWORD=your_redis_password

# ============================================================
# 4. Milvus 向量数据库（MinIO / etcd 为 Milvus 内部依赖）— 指向服务器
# ============================================================
MILVUS_HOST=SERVER_IP
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_HTTP_PORT=9091
# MinIO 对象存储（Milvus 内部使用）
MINIO_ADDRESS=SERVER_IP:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Etcd（Milvus 内部使用）
ETCD_ENDPOINTS=SERVER_IP:2379

# ============================================================
# 5. Neo4j 本体图数据库 — 指向服务器（本地后端需显式声明 URI/用户/密码）
# ============================================================
NEO4J_URI=bolt://SERVER_IP:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# ============================================================
# 6. JWT / 安全（本地调试用默认值即可）
# ============================================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production_please_use_a_strong_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
# Sidecar 内部服务 JWT
JWT_INTERNAL_SECRET=your_internal_jwt_secret_here

# ============================================================
# 7. 认证（登录票据 / 重定向白名单 / CORS）
# ============================================================
LOGIN_TICKET_EXPIRE_SECONDS=60
AUTH_ALLOWED_REDIRECT_URIS={}
# AUTH_CORS_ORIGINS=

# ============================================================
# 8. 前端（本地后端调试通常用不到；保留占位）
# ============================================================
# FRONTEND_PORT=80
# VITE_ALLOWED_REDIRECT_ORIGINS=

# ============================================================
# 9. 服务地址 — 本机业务后端 127.0.0.1；atomic-rag 复用服务器
# ============================================================
SIDECAR_URL=http://127.0.0.1:8001
KNOWLEDGE_BASE_URL=http://127.0.0.1:8003
BUSINESS_DOMAIN_URL=http://127.0.0.1:8005
PLATFORM_URL=http://127.0.0.1:8006
# atomic-rag 较重，默认复用服务器；若本机调试 atomic-rag，改成 http://127.0.0.1:8004
ATOMIC_RAG_URL=http://SERVER_IP:8004
# MCP Server 公网地址（mcp_config.url 来源，WorkBuddy 等 AI 客户端连接用；客户端连接 URL 为 /mcp）
# 本地调试：MCP Server 跑在 8002，本机直连填 http://localhost:8002/mcp
MCP_SERVER_PUBLIC_URL=http://localhost:8002/mcp

# ============================================================
# 10. LLM Gateway 上游出口（统一 LLM/Embedding 出口）
# ------------------------------------------------------------
# 本机后端不直连上游，统一经 llm-gateway。本模板 llm-gateway 在服务器上，
# 故下游各 *_BINDING_HOST 指向 http://SERVER_IP:8787/v1。
# LLMGW_UPSTREAM_* 仅在「本机自行运行 llm-gateway」时才需要，届时把
# 下方 *_BINDING_HOST 改回 127.0.0.1:8787 并填好上游 key。
# ============================================================
# LLMGW_UPSTREAM_LLM_HOST=https://tokenhub.tencentmaas.com/v1
LLMGW_UPSTREAM_LLM_API_KEY=your_upstream_llm_api_key_here
LLMGW_UPSTREAM_EMBED_HOST=http://127.0.0.1:11434/v1
LLMGW_UPSTREAM_EMBED_API_KEY=ollama
# 上游 Rerank
LLMGW_RERANK_BINDING=ollama-generate
LLMGW_RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
LLMGW_UPSTREAM_RERANK_HOST=http://127.0.0.1:11434
LLMGW_UPSTREAM_RERANK_API_KEY=ollama
LLMGW_RERANK_PROMPT_PROFILE=qwen3
LLMGW_RERANK_MAX_DOCS=12
LLMGW_RERANK_CONCURRENCY=4
LLMGW_RERANK_TIMEOUT=30
# 合法内部 token（逗号分隔），下游服务/LightRAG 用其访问网关
LLMGW_INTERNAL_TOKENS=gw_lightrag,gw_platform
# 计量与 PG 批量缓冲
LLMGW_METERING_ENABLED=true
LLMGW_PG_FLUSH_MAX_ROWS=20
LLMGW_EMBED_AGGREGATE_ENABLED=true
LLMGW_EMBED_AGGREGATE_SCENES=lightrag_embed,ontology_embed
# 关思考注入（仅适配腾讯 tokenhub；换上游需改 upstream.py 或设 false）
# 分档策略见 docs/ontology-query-thinking-latency-fix-plan.md §3：
# 抽取场景恒禁；ontology_arbitration 恒禁（二选一分类）；`_fast` 变体=严格模式快档；
# 原始查询 scene（ontology_qa/rag_chunk_qa/rag_fusion）不在列表=精档与非严格保留思考。
LLMGW_DISABLE_THINKING_ENABLED=true
LLMGW_DISABLE_THINKING_MODELS=deepseek-v4-flash-202605
LLMGW_DISABLE_THINKING_SCENES=lightrag_extract,ontology_extract,raganything_ingest,ontology_arbitration,ontology_qa_fast,rag_chunk_qa_fast,rag_fusion_fast

# ============================================================
# 11. 本体抽取与本体问答 LLM
# ============================================================
ONTOLOGY_EXTRACT_ENABLED=true
ONTOLOGY_SCHEMA_PATH=deploy/config/ontology/default.yaml
ONTOLOGY_ENTITY_DESC_MAXLEN=1000
ONTOLOGY_KEEP_UNTYPED_EDGES=true
ONTOLOGY_EXTRACT_DROP_ORPHAN=false
ONTOLOGY_EXTRACT_MAX_ENTITIES=500
ONTOLOGY_EXTRACT_CONCURRENCY=8
ONTOLOGY_ROUTE_SCORE_MIN=1.0
# 本体向量语义检索（Neo4j 原生向量索引）
ONTOLOGY_VECTOR_ENABLED=true
ONTOLOGY_VECTOR_SCORE_MIN=0.75
ONTOLOGY_VECTOR_TOPK=200
ONTOLOGY_RRF_K=60
ONTOLOGY_RRF_W_FT=1.0
ONTOLOGY_RRF_W_VEC=1.0
# RAG fallback 引用重排
ONTOLOGY_RAG_FALLBACK_RERANK_ENABLED=true
ONTOLOGY_RAG_FALLBACK_MAX_REFS=3
# ── RAG fallback 召回明细 ──
# 总开关：true 时 STAGE_RAG_FALLBACK 的 detail 增加 recalls[] 轻量召回明细（含 chunk_id）
ONTOLOGY_RAG_RECALL_DETAIL_ENABLED=true
# 召回明细最大条数（防推理链膨胀）
# ONTOLOGY_RAG_RECALL_MAX_ITEMS=20
# 单条 text 截断字数
# ONTOLOGY_RAG_RECALL_TEXT_MAX=200
# rerank client（经 llm-gateway；本模板指向服务器）
RERANK_BINDING_HOST=http://SERVER_IP:8787/v1
RERANK_BINDING_API_KEY=gw_lightrag
RERANK_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M
# 检索期 rerank 配置态（须与 .env.rag.local 的 RERANK_BINDING 一致）
RAG_RETRIEVAL_RERANK_ENABLED=true
ONTOLOGY_EMBED_DESC_MAXLEN=300
ONTOLOGY_QUERY_EMBED_TTL=300
ONTOLOGY_QUERY_EMBED_CACHE_MAX=500
ONTOLOGY_EMBED_TIMEOUT=5
ONTOLOGY_EMBED_MAX_RETRIES=1
# ── 本体多跳邻域召回（默认 1 跳=现状；灰度升至 2~3）──
ONTOLOGY_NEIGHBOR_DEPTH=1
ONTOLOGY_NEIGHBOR_DEPTH_MAX=3
ONTOLOGY_NEIGHBOR_LIMIT=20
ONTOLOGY_NEIGHBOR_PER_HOP_LIMIT=50
ONTOLOGY_NEIGHBOR_TIMEOUT=15
# ── 方案④：本体作答超时秒数（30 为当前基线，可按实测下调至 8~10）──
ONTOLOGY_ANSWER_TIMEOUT=30
# 方案④b：事实量预判阈值 — 邻域取到的事实数低于此值直接跳过本体作答（0=不启用）
ONTOLOGY_MIN_FACTS=0
# ── 方案②：融合宽度上限（仅对 top-N 个有效答案做融合，其余仅作引用来源）──
ONTOLOGY_RAG_FUSION_TOPN=5
# ── 方案③：多 KB 并行查询并发上限（信号量，默认 7）──
ONTOLOGY_RAG_MAX_CONCURRENCY=7
# ── P1-5 RAG 召回后处理 ──
RAG_PRELLM_RERANK_ENABLED=true
RAG_PRELLM_RERANK_TOPK=8
# ── §image-refs P4：图片引用配额（docs/image-reference-accuracy-fix-plan.md 方案 A）──
# RAG_IMAGE_REF_SCORE_MIN：图片 location 分数阈值，低于此值直接丢弃。
#   分数链 final_score > relevance > group_final_score > _order_score；
#   默认 0.3：2026-08 以真实文档（岭南画派-10p，62 图）× 6 条真实查询实测，
#   rerank 分二值化——真相关 ≥0.74（四屏 query 下四屏图 0.745~0.991）、
#   弱相关 ≤0.03，0.3 位于两带之间（10 倍安全余量）。
#   rerank 关闭时分数退化为位置衰减分（0~1），阈值会误伤后半段候选，
#   该场景应设 0。设 0 关闭过滤。
# RAG_IMAGE_REF_MAX：通过阈值后每个文档保留的图片 location 上限。
#   默认 6；设 999 等同关闭配额上限
# RAG_IMAGE_REF_SCORE_MIN=0.3
# RAG_IMAGE_REF_MAX=6
# 主体一致性信号总开关（方案 B 语义：软加权，永不删除候选；默认关）
# ⚠️ 旧实现为白名单硬剔除，全部不中时会清空 references
#   （见 docs/rag-subject-filter-and-answer-source-remediation-plan.md §4/§5）。
RAG_SUBJECT_FILTER_ENABLED=false
# 主体分权重 λ：final = (1-λ)×rerank 相关性 + λ×主体分（仅主体信号开启时生效）
RAG_SUBJECT_WEIGHT=0.25
# ── 方案 A：平台取回作答权（LightRAG 降为 retriever，答案收归平台侧）──
# 总开关：false 时 RAG 降级走现有「LightRAG 生成 + 融合」链路；true 时
# only_need_context 只召回 + 平台 answer_from_chunks 一次作答（答案与引用同源）。
# 灰度默认关；新路径失败当次自动回退旧链路。
RAG_PLATFORM_ANSWER_ENABLED=false
# 送 answer_from_chunks 的 chunk 文本总长上限（字符，硬截）
RAG_ANSWER_MAX_CONTEXT_CHARS=12000
# ── Embedding 出口（kb-service 与 lightrag 共享；必须与 .env.rag.local 一致）──
# ⚠️ 首篇文档处理后不可再更改；本模板经服务器 llm-gateway
EMBEDDING_DIM=1024
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_BINDING_HOST=http://SERVER_IP:8787/v1
EMBEDDING_SEND_DIM=true
EMBEDDING_BINDING_API_KEY=gw_lightrag
REASONING_TRACE_ENABLED=true
# ── §9 严格模式（总闸，false 时忽略请求 strict_mode）──
STRICT_MODE_ENABLED=true
# 两档结构（快档 / 精档）；原 3 档同配置无梯度，见方案 §2.6
STRICT_MAX_ATTEMPTS_CAP=2
# ── [jonex] 对侧 RAG 校验整体超时（秒）；超时按「对侧无结果」保留本体原答案 ──
# 仅对精档生效；取值由精档超时台账反推（方案 §3.4）：15+60+20+8+5=108 < 精档 120。
ONTOLOGY_CROSS_RAG_TIMEOUT=20
# ── [jonex] 本机 Debug 网关/边车 HTTP 超时：精档 145s + 深度查询 180s，代码默认 180s ──
# 与 Docker 部署对齐（300s），本地调试留足余量避免环境差异导致超时
GATEWAY_SIDECAR_TIMEOUT=300
SIDECAR_PROXY_TIMEOUT=300
STRICT_MIN_SCORE=0.8
STRICT_ATTEMPT_TIMEOUT=60
STRICT_TOTAL_BUDGET=150
STRICT_WEIGHT_NON_REFUSAL=0.35
STRICT_WEIGHT_REFERENCE=0.15
STRICT_WEIGHT_GROUNDED=0.30
STRICT_WEIGHT_CONSISTENCY=0.20
# ── P2-7 作答常识放宽配置 ──
ONTOLOGY_ANSWER_ALLOW_COMMON_SENSE=true
# ── §10 深度查询配置 ──
DEEP_QUERY_ENABLED=true
DEEP_MAX_SUBQUERIES=6
DEEP_SUBQUERY_CONCURRENCY=5
DEEP_TOTAL_BUDGET=180
# 本体问答 / RAG 融合回答的 LLM 出口（ontology_llm.py、ontology_extractor.py 读取）
# 经 llm-gateway；api_key 用网关内部 token（见 LLMGW_INTERNAL_TOKENS），
# 不可留空——openai SDK 见空 key 会抛 "Missing credentials"。
ONTOLOGY_LLM_BINDING_HOST=http://SERVER_IP:8787/v1
ONTOLOGY_LLM_BINDING_API_KEY=gw_lightrag
ONTOLOGY_LLM_MODEL=deepseek-v4-flash-202605

# ============================================================
# 12. RAG / LightRAG 对接（atomic-rag → lightrag-server）
# ============================================================
# 须与 .env.rag.local 中的 LIGHTRAG_API_KEY 一致
LIGHTRAG_API_KEY=change-me-in-production-please
RAG_WEBHOOK_URL=
RAG_MIN_QUERY_LEN=3
# v2 入库轮询总超时（秒），全局安全网，须 ≥ per-chunk 超时；大文档建议 1800+
RAG_TRACK_TIMEOUT_SECONDS=1800
# v2 单 chunk 独立超时窗口（秒），超时后 PushChunksStage 重推重试
RAG_TRACK_PER_CHUNK_TIMEOUT_SECONDS=900
# v2 超时 chunk 重推最大次数（仅 PushChunksStage，恢复路径不重推）
RAG_TRACK_PER_CHUNK_MAX_RETRIES=2
# v2 轮询并发度，限制同时查询 track_status 的并发数
RAG_TRACK_POLL_CONCURRENCY=8
# 文档级并发：atomic-rag TaskManager 同时处理的文档数（后台 worker 协程数），改后需重建 atomic-rag 镜像。
WORKER_COUNT=4
# 任务队列容量（总槽位 = WORKER_COUNT + 此值；满时入库请求返回 429）。
TASK_QUEUE_CAPACITY=100
# 单文档内多模态描述 LLM 并发（scene=raganything_ingest：表格/公式/音频等 LLM 快任务，单次约 2~3s），
# 改后需重建 atomic-rag 镜像。HTTP 入库模式原硬编码为 2；实际并发 ≈ WORKER_COUNT × 此值。
# 上游限 200 次/分钟且与 lightrag_extract(MAX_ASYNC)/ontology_extract 共用额度；安全并发约 7~10。
# 注意：图片（VLM）不在此列——由下方 MAX_PARALLEL_VLM 独立限流。默认 4。
MAX_PARALLEL_MULTIMODAL=4
# 单文档内图片/视频关键帧 VLM 并发（直连远端 VLM，不经 llm-gateway；thinking 模型单次 4~105s），
# 改后需重建 atomic-rag 镜像。远端槽位有限，并发过高会排队超过 VLM 超时（RAG_VLM_TIMEOUT）
# 触发 ReadTimeout 重试风暴。实际并发 ≈ WORKER_COUNT × 此值。默认 2。
MAX_PARALLEL_VLM=2
# 单次 VLM 调用超时（秒）：驱动默认 120s 对 thinking 模型太紧，提到 300s 给长思考留余量。
RAG_VLM_TIMEOUT=300
# 单次 VLM 输出 max_tokens 上限（0=不限制）。低量化 thinking 模型描述冗长时可设 300
# 起灰度；过小会截断 JSON 导致解析重试失败。默认 0（关）。
# RAG_VLM_MAX_TOKENS=300
# VLM 思考深度（none/low/medium/high）：默认 none 关闭思考。实测思考开启时单图 4~105s、
# 约 1.2 万完成 token 且低量化下易带幻觉；关闭后约 3s/160 token，描述更贴合图片。
# RAG_VLM_REASONING_EFFORT=none

# ── 知识库对账/超时巡检（knowledge-base-service 的 patrol_parsing_timeout；纯后端，改后无需重建镜像）──
# 软超时（秒）：PARSING/INGESTING 文档超过此时长后，对账开始探活；任务仍在处理/排队则继续等待，绝不无脑重推
RAG_TASK_SOFT_TIMEOUT_SEC=3600
# 硬超时（秒，默认 6h）：超过即使任务仍在处理也判死置 FAILED 并打 ERROR 告警；大批量入库长期堆积时可调大
RAG_TASK_HARD_TIMEOUT_SEC=21600
# 探测失败容忍次数：get_task_status 连续失败达此次数才判任务已死，避免瞬时网络抖动误杀在途任务
RAG_TASK_PROBE_FAIL_MAX=3

# ============================================================
# 13. MinerU 解析器（atomic-rag 本机运行时才用到）
# ------------------------------------------------------------
# RAG_PARSER 三选一：mineru（本地 CLI）/ mineru_online（云）/ mineru_selfhost（内网）
# ============================================================
RAG_PARSER=mineru_online
# 打包变量（仅构建 atomic-rag 镜像时生效）：full / slim
RAG_PROFILE=slim
# [jonex] v2 解析重试（所有 parser 生效，替换旧 MINERU_PARSE_*）
RAG_PARSE_RETRY_MAX=3
RAG_PARSE_RETRY_BASE_SEC=2.0
RAG_REQUIRE_DOC_IDS=true

# ── [jonex] 表格解析与切块治理（docs/table-parsing-retrieval-governance-plan.md §5/§9.2）──
# 这些变量由 atomic-rag（raganything）进程读取（本地调试 .env.local），
# 不要放进 .env.rag.local（那是 lightrag 专用）。改后重启本地 atomic-rag 调试进程。
# 表格网格化 + 表头推断总开关（L1/L2）：未设置默认 true；false 回退旧 normalize_table_rows。
RAG_TABLE_GRID_V2=true
# 表头长文本剔除阈值（字符）：超过或含句末符 → 判为表前说明写入 notes。
TABLE_HEADER_MAX_LEN=40
# 表格专用切块预算（字符，O1）：仅表格分支生效，文本链路仍用 RAG_CHUNK_MAX_CHARS。
# tokenizer 校准脚本：scripts/calibrate_table_chunk_budget.py。
RAG_TABLE_CHUNK_MAX_CHARS=900
# 表格 chunk 超限断言阈值（token）：与 lightrag 端 CHUNK_SIZE（.env.rag.local）一致。
RAG_LIGHTRAG_CHUNK_SIZE=1200
# xlsx 双路合并开关（L3）：openpyxl 表格主轨 + MinerU 图片轨；false 全量交 MinerU。
XLSX_NATIVE_NORMALIZE=true
# 解析/摘要 prompt 语言（L4.2）：zh 中文模板 / en 英文；进程级全局，默认 zh。
RAG_PROMPT_LANG=zh

# ── [jonex] §block-packing 文本块级打包（docs/text-block-packing-chunk-governance-plan.md §3）──
# 同样由 atomic-rag（raganything）进程读取（本地调试 .env.local），勿写进 .env.rag.local
# RAG_TEXT_BLOCK_PACKING：总开关（默认 true；false 完全回退逐块 1:1）
# RAG_TEXT_PACK_CHARS：字符预算主控（= 900 token × 1.4 系数固化，见计划 §3.1）
# RAG_TEXT_PACK_MAX_TOKENS：硬上限断言（token），须与 .env.rag.local 的 CHUNK_SIZE 一致
# RAG_TEXT_PACK_DROP_NOISE：噪声丢弃（C2/C3）；false=零信息损失模式
RAG_TEXT_BLOCK_PACKING=true
RAG_TEXT_PACK_CHARS=1260
RAG_TEXT_PACK_MAX_TOKENS=1200
RAG_TEXT_PACK_HEADING_MAX_LEN=40
RAG_TEXT_PACK_DROP_NOISE=true

# ── [jonex] §image-refs 图片资产上传（docs/image-reference-chain-execution-plan.md P1-4）──
# 同样由 atomic-rag（raganything）进程读取（本地调试 .env.local）；false 只停
# 资产上传与 aext 旁路（检索侧图片引用无 asset_url），不阻塞主链路
RAG_ASSET_UPLOAD_ENABLED=true
# ── [jonex] §image-refs 图片版面主题锚点（docs/image-reference-accuracy-fix-plan.md E 方案 P0-6）──
# 入库侧从 MinerU content_list 确定性提取版面主题（图注→x 重叠列下方图注→
# 本页标题），拼在 VLM 描述之前：图片描述：【版面主题：xxx】{VLM 描述}。
# 锚点来源写入 file_source 旁路 anchor_src=cap|foot|col|heading。false 回退旧行为。
RAG_IMAGE_ANCHOR_ENABLED=true

# ── [jonex] reparse 补偿 cleanup 收敛循环（docs/rag-reparse-strict-cleanup-busy-plan.md）──
# 1-A（atomic-rag，改后需重建镜像）：push 阶段 track 终态 failed 的 chunk 是否纳入有界重推；
#   默认 true；设 false 回退旧行为（终态 failed 立即判硬失败、不重推）
RAG_PUSH_RETRY_TERMINAL_FAILED=true
# P0（atomic-rag，改后需重建镜像）：_converge_delete 收敛循环
#   - RAG_CLEANUP_MAX_ELAPSED：收敛循环最长运行时间（秒），默认 1800
#   - RAG_CLEANUP_POLL_DELAY：每轮 poll 间隔（秒），默认 5
#   - RAG_CLEANUP_POLL_PER_DOC_SEC：deadline 随删除量缩放的 per-doc 秒数（默认 2）
#     公式: deadline = min(MAX_ELAPSED, max(300, 300 + PER_DOC_SEC × 待删数))
RAG_CLEANUP_MAX_ELAPSED=1800
RAG_CLEANUP_POLL_DELAY=5
RAG_CLEANUP_POLL_PER_DOC_SEC=2
# 3-A（knowledge-base-service，纯后端改后无需重建镜像）：cleanup 卡死动态超时判死 =
#   min(CEIL, BASE + PER_DOC × 待删总量)；超时把文档置 FAILED（前端可见可重传）
RECONCILE_CLEANUP_BASE_SEC=600
RECONCILE_CLEANUP_PER_DOC_SEC=15
RECONCILE_CLEANUP_CEIL_SEC=21600
# R2-a(kb-service)：提交宽限期，task_id 为空且锚点在此窗口内不判死
RECONCILE_SUBMIT_GRACE_SEC=180
# R2-b(kb-service)：幂等键反查开关
RECONCILE_IDEMPOTENCY_LOOKUP_ENABLED=true
# R7-2b(atomic-rag)：COS 下载异步化开关（true=任务 pipeline 内下载）
RAG_COS_FETCH_IN_TASK=true
# ---- (A) 本地 mineru CLI ----
MINERU_MODEL_SOURCE=modelscope
# ---- (B) mineru_selfhost：内网 mineru-api 服务 ----
MINERU_SELFHOST_BASE_URL=http://127.0.0.1:8000
MINERU_SELFHOST_BACKEND=pipeline
MINERU_SELFHOST_LANG=ch
MINERU_SELFHOST_POLL_INTERVAL=5
MINERU_SELFHOST_POLL_TIMEOUT=1800
MINERU_SELFHOST_RETURN_IMAGES=false
# ---- (C) mineru_online：mineru.net 云 API（token 为密钥，请从 deploy/.env 取）----
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_API_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL=5
MINERU_POLL_TIMEOUT=1800

# ============================================================
# 14. 对象存储（local 本地文件系统 / cos 腾讯云 COS / s3 S3 兼容）
# ------------------------------------------------------------
# 本地调试默认用 local（零密钥、开箱即用）。若要读服务器上传到 COS 的原文，
# 改 OBJECT_STORAGE_BACKEND=cos 并从 deploy/.env 补全 COS_* 密钥。
# ============================================================
OBJECT_STORAGE_BACKEND=local
COS_KEY_PREFIX=jonex
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=your-cos-bucket-name
# COS_PRESIGN_EXPIRES=900

# S3 兼容（AWS S3 / MinIO / 国内云 S3 兼容端点），改 OBJECT_STORAGE_BACKEND=s3 后生效。
# MinIO 用 S3_ADDRESSING_STYLE=path 且 S3_ENDPOINT_URL 指向 MinIO；AWS S3 可不填 endpoint。
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_BUCKET=your-s3-bucket-name
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ADDRESSING_STYLE=auto
# S3_PRESIGN_EXPIRES=900

# ============================================================
# 15. 数据源接入
# ============================================================
# 凭据加密密钥（base64 urlsafe 32 字节）；不配则开发态从 JWT_SECRET 派生
# DATA_SOURCE_SECRET_KEY=
# 生成 api_push 入站推送 URL 用
PUBLIC_API_BASE=http://localhost

# ============================================================
# 16. 审计日志（本地 platform 在 127.0.0.1:8006）
# ============================================================
AUDIT_LOG_ENABLED=true
AUDIT_INGEST_URL=http://127.0.0.1:8006
# AUDIT_LOG_ASYNC=true
# AUDIT_QUEUE_MAX_SIZE=10000
# AUDIT_FLUSH_BATCH_SIZE=100
# AUDIT_FLUSH_INTERVAL_MS=200
# AUDIT_RETENTION_DAYS=90
# AUDIT_HTTP_METHODS=POST,PUT,PATCH,DELETE

# ============================================================
# 17. TCADP 平台（可选；密钥请按需填）
# ============================================================
TCADP_API_URL=https://tcadp.tencent.com/api
TCADP_API_KEY=your_tcadp_api_key_here
TCADP_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# 18. VLM / ASR 连接信息（音视频链路，preset 不写死；优先级 preset override > env > profile）
# ============================================================
VLM_BINDING_HOST=vision-model-address
VLM_BINDING_API_KEY=not-needed
VLM_MODEL_NAME=qwen3.6:35b

ASR_BINDING=openai_compatible
ASR_MODEL=large-v3
ASR_BASE_URL=asr-model-address
ASR_API_KEY=not-needed

LLM_BINDING_HOST=http://llm-gateway:8787/v1
LLM_BINDING_API_KEY=gw_lightrag
LLM_MODEL=deepseek-v4-flash

# ============================================================
# 19. 系统配额（Preview 阶段，knowledge-base 服务读取）
# ------------------------------------------------------------
# 单环境变量承载全部配额上限，对当前环境内所有租户统一生效。
# 配置缺失/非法/字段缺失/非正整数/单KB文档数>单租户文档数 → KB 服务拒绝启动。
# 存储容量按 MiB 配置，后端按 Byte 计算；修改后重启 KB 服务生效。
# 示例值仅作部署参考，实际额度以本变量为准。
# ============================================================
JONEX_SYSTEM_QUOTA_CONFIG={"tenantKnowledgeBaseLimit":10,"tenantDocumentLimit":500,"tenantStorageLimitMiB":5120,"knowledgeBaseDocumentLimit":200,"uploadFileCountLimit":20,"documentFileSizeLimitMiB":100,"spreadsheetFileSizeLimitMiB":10,"imageFileSizeLimitMiB":20,"audioFileSizeLimitMiB":200,"audioDurationLimitMinutes":60,"videoFileSizeLimitMiB":500,"videoDurationLimitMinutes":30}


# ===== 内部认证与测试开关（安全加固，公开仓库默认关闭） =====
# GATEWAY_API_KEY：网关 → Sidecar 内部调用 key。本地调试用 jonex_test_gateway；
# 生产必须设为真实随机值（Gateway 启动守卫会拒绝默认哨兵 change-me-in-production）。
GATEWAY_API_KEY=jonex_test_gateway
# 测试 token（jonex_test_{tenant_id}）免 JWT 验签开关：仅本地/联调开启，生产必须 false。
ENABLE_TEST_TOKENS=true
